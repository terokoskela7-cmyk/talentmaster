rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// TalentMaster™ — Firebase Storage Rules (Console-deploy: Firebase Console → Storage → Rules).
//
// ✅ REKONSILIOITU elävään rulesetiin 2026-06-23 — EI ENÄÄ rekonstruktio; repo = totuus.
//   Sisältö: (1) Reflektiopäiväkirja-äänet (Vaihe 2.3b-1) · (2) ADAR Vision -media (§15, elävä sääntö)
//   · (3) Brändi-logo (white-label Vaihe 3A). Muutokset deployataan Consolesta (ei automaattisesti).
//
// Region: europe-west1 (CLAUDE.md §2). SA-claim epäjohdonmukaisuus (§12): rooli voi olla
// 'super_admin' TAI 'superadmin' → tarkistetaan molemmat.
// ════════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function onSuperAdmin() {
      return request.auth != null
        && (request.auth.token.rooli == 'super_admin' || request.auth.token.rooli == 'superadmin');
    }

    // ── Reflektiopäiväkirja-ääni (Vaihe 2.3b-1) — valmentajan OMA yksityinen kasvupäiväkirja ──
    // read/write/delete VAIN oma uid (+ SA). Kirjoitus rajattu audio/* + kokokatto ~12 MB.
    // VP/johto EI pääse (yksityinen kasvupäiväkirja; arviointiin sidottu reflektio näkyy Firestore-puolella).
    match /seurat/{sid}/kayttajat/{uid}/reflektiot/{file} {
      allow read:   if request.auth != null && (request.auth.uid == uid || onSuperAdmin());
      allow write:  if request.auth != null
                    && (request.auth.uid == uid || onSuperAdmin())
                    && request.resource.contentType.matches('audio/.*')
                    && request.resource.size < 12 * 1024 * 1024;
      allow delete: if request.auth != null && (request.auth.uid == uid || onSuperAdmin());
    }

    // ── ADAR Vision -media (§15) — elävä sääntö: seurat/{sid}/havainnot/{hid}/media_*.jpg ──
    // read: oma seura (seuraId-claim) TAI SA. write: oman seuran valmentaja-roolit (valmentaja/vp/UTJ/
    // talentti/fysiikka) TAI SA; image/(jpeg|jpg|png|webp) + kokokatto 10 MB.
    match /seurat/{sid}/havainnot/{hid}/{file=**} {
      allow read:  if request.auth != null && (onSuperAdmin() || request.auth.token.seuraId == sid);
      allow write: if request.auth != null
                   && (onSuperAdmin() || (request.auth.token.seuraId == sid
                       && request.auth.token.rooli in ['valmentaja', 'vp', 'urheilutoimenjohtaja', 'talenttivalmentaja', 'fysiikkavalmentaja']))
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // ── Brändi-logo (white-label Vaihe 3A) — seuran logo harjoitusarviointi-artefakteihin ──
    // write/delete: oman seuran johto (vp/urheilutoimenjohtaja/seurasihteeri) TAI SA; image/* + kokokatto 5 MB.
    // read: kuka tahansa kirjautunut (logo ei arkaluonteinen; näkyy lomake/dashboard/PDF -pinnoilla).
    // §7.15: oma match-blokki — Storage-säännöt eivät periydy.
    match /seurat/{sid}/brandi/{file} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && (onSuperAdmin() || (request.auth.token.seuraId == sid
                        && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja', 'seurasihteeri']))
                    && request.resource.contentType.matches('image/.*')
                    && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null
                    && (onSuperAdmin() || (request.auth.token.seuraId == sid
                        && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja', 'seurasihteeri']));
    }

    // Oletus: estä kaikki muu (ei vaikuta yllä sallittuihin, dokumentoi default-deny -periaatteen).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "talentmaster",
  "version": "0.1.0",
  "private": true,
  "description": "TalentMaster — pelaajakehityksen analytiikka-SaaS. KPI-yksikkötestit Vitestillä.",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run --exclude tests/rules/**",
    "test:watch": "vitest --exclude tests/rules/**",
    "test:rules": "firebase emulators:exec --only firestore 'npx vitest run tests/rules'",
    "test:all": "firebase emulators:exec --only firestore 'npx vitest run'",
    "migrate:luotu": "node scripts/migrate_luotu_a5.js",
    "migrate:luotu:apply": "node scripts/migrate_luotu_a5.js --apply",
    "migrate:huoltaja": "node scripts/migrate_huoltajaEmail_lc.js",
    "migrate:huoltaja:apply": "node scripts/migrate_huoltajaEmail_lc.js --apply",
    "version:bump": "node scripts/bump_version.js",
    "lint": "eslint --no-warn-ignored TalentMaster_*.html lib/ docs/testit_indeksit.js harjoitelogiikka_v4.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.19.1",
    "globals": "^17.7.0",
    "vitest": "^3.2.1"
  }
}

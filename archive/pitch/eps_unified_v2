function renderNelikentta() {
  const ctx = document.getElementById('nelikenttaChart');
  if(!ctx||charts.nk) return;
  charts.nk = new Chart(ctx, {
    type:'scatter',
    data:{datasets:[{
      data: VALMENTAJAT.map(v=>({x:v.aktiivisuus,y:v.tulokset})),
      backgroundColor: VALMENTAJAT.map(v=>{
        if(v.aktiivisuus>60&&v.tulokset>60) return 'rgba(26,122,60,.85)';
        if(v.aktiivisuus>60&&v.tulokset<=60) return 'rgba(196,122,0,.85)';
        if(v.aktiivisuus<=60&&v.tulokset>60) return 'rgba(0,112,112,.85)';
        return 'rgba(184,32,32,.85)';
      }),
      pointRadius:14, pointHoverRadius:16,
      pointBorderColor:'rgba(255,255,255,.8)', pointBorderWidth:2,
    }]},
    options:{
      responsive:true,maintainAspectRatio:true,
      plugins:{legend:{display:false},tooltip:{callbacks:{
        label:ctx=>VALMENTAJAT[ctx.dataIndex].nimi+' · '+VALMENTAJAT[ctx.dataIndex].joukkue
      }}},
      scales:{
        x:{min:0,max:100,
          title:{display:true,text:'Pedagoginen aktiivisuus →',color:'#8892A0',font:{size:10}},
          ticks:{color:'#8892A0',font:{size:10}},
          grid:{color:'rgba(0,0,0,.06)'},border:{display:false},
        },
        y:{min:0,max:100,
          title:{display:true,text:'↑ Kehitystulokset',color:'#8892A0',font:{size:10}},
          ticks:{color:'#8892A0',font:{size:10}},
          grid:{color:'rgba(0,0,0,.06)'},border:{display:false},
        },
      }
    }
  });
  // Piirretään kvadranttijako suoraan canvakselle initin jälkeen
  setTimeout(()=>{
    const c = ctx.getContext('2d');
    const area = charts.nk.chartArea;
    if(!area) return;
    const midX = (area.left+area.right)/2;
    const midY = (area.top+area.bottom)/2;
    c.save();
    c.strokeStyle='rgba(0,0,0,.1)';
    c.lineWidth=1;
    c.setLineDash([6,4]);
    c.beginPath();c.moveTo(midX,area.top);c.lineTo(midX,area.bottom);c.stroke();
    c.beginPath();c.moveTo(area.left,midY);c.lineTo(area.right,midY);c.stroke();
    c.restore();
  },100);
}

function renderValmMatrix() {
  const el = document.getElementById('valm-matrix');
  el.innerHTML = VALMENTAJAT.map(v => {
    const quad = v.aktiivisuus>60&&v.tulokset>60
      ? {l:'Tukea →', c:'#1A7A3C', bg:'rgba(26,122,60,.06)', border:'rgba(26,122,60,.2)'}
      : v.aktiivisuus>60
      ? {l:'Jaa ↓', c:'#C47A00', bg:'rgba(196,122,0,.06)', border:'rgba(196,122,0,.2)'}
      : v.tulokset>60
      ? {l:'Seuraa →', c:'#007070', bg:'rgba(0,112,112,.06)', border:'rgba(0,112,112,.2)'}
      : {l:'Aktivoi ↑', c:'#B82020', bg:'rgba(184,32,32,.06)', border:'rgba(184,32,32,.2)'};
    const actW = v.aktiivisuus;
    const resW = v.tulokset;
    return `<div style="padding:10px 0;border-bottom:1px solid var(--border);">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
        <div style="flex:1">
          <div style="font-size:13px;font-weight:600;color:var(--text)">${v.nimi}</div>
          <div style="font-size:10px;color:var(--ink3)">${v.joukkue}</div>
        </div>
        <span style="font-size:11px;font-weight:700;padding:3px 10px;border-radius:10px;background:${quad.bg};color:${quad.c};border:1px solid ${quad.border};">${quad.l}</span>
      </div>
      <div style="display:grid;grid-template-columns:70px 1fr 30px;gap:4px;align-items:center;margin-bottom:3px;">
        <div style="font-size:9px;color:var(--ink3);text-transform:uppercase;letter-spacing:.5px;">Aktiivisuus</div>
        <div style="height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;"><div style="height:5px;width:${actW}%;background:#004B87;border-radius:3px;"></div></div>
        <div style="font-size:10px;font-weight:700;color:#004B87;text-align:right">${actW}%</div>
      </div>
      <div style="display:grid;grid-template-columns:70px 1fr 30px;gap:4px;align-items:center;">
        <div style="font-size:9px;color:var(--ink3);text-transform:uppercase;letter-spacing:.5px;">Tulokset</div>
        <div style="height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;"><div style="height:5px;width:${resW}%;background:${quad.c};border-radius:3px;"></div></div>
        <div style="font-size:10px;font-weight:700;color:${quad.c};text-align:right">${resW}%</div>
      </div>
    </div>`;
  }).join('');
}


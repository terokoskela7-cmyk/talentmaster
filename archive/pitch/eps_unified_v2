  if(tbody) tbody.innerHTML = pikaMatriisi.map(r => `
    <tr>
      <td style="padding:7px 10px;font-size:11px;color:var(--ink2);border-bottom:1px solid var(--border);font-weight:500;">${r.p}</td>

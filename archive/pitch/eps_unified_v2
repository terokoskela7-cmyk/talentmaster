  // Periaatteet
  const kaikki = ['Unmarked','Support','Game spaces','Ennakointi','Kommunikointi',
    '1v1-dominanssi','Pelitilan lukeminen','Tila ennen palloa','Intensiteetti',
    'Transitio','Pallonhallinta','Puolustuksen tuki','Eteneminen'];
  document.getElementById('periaate-grid').innerHTML = kaikki.map(p => `
    <button class="periaate-chip ${konfig_periaatteet.includes(p)?'on':''}" onclick="togglePeriaate('${p}',this)">${p}</button>`).join('');

  // Ikämatriisi
  const pikaMatriisi = [
    {p:'Unmarked',     v:['P','I','I','E','E']},
    {p:'Support',      v:['P','P','I','I','E']},
    {p:'Game spaces',  v:['—','P','I','I','E']},
    {p:'Ennakointi',   v:['—','P','P','I','E']},
    {p:'Kommunikointi',v:['P','P','I','E','E']},

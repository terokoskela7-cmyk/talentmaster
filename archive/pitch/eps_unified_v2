function renderKonfig() {
  // Sliders
  document.getElementById('painotus-sliders').innerHTML = Object.entries(konfig_painotukset).map(([d,v]) => `
    <div class="konfig-slider-row">
      <div class="konfig-slider-label">${d}</div>

    {q:'Selviytyikö maalivahti jaloin tehtävistä syötöistä paineessa?',                     dna:'First touch',  color:'#00D4AA'},
    {q:'Pysyikö maalivahti optimaalisessa asemassa suhteessa palloon?',                     dna:'Intelligence', color:'#7F77DD'},
    {q:'Säilyikö päätöksentekokyky paineen alla — myös maalin jälkeen?',                    dna:'Mindset',      color:'#4A7ED9'},
    {q:'Lähteekö maalivahti rohkeasti ulos tilanteisiin?',                                  dna:'Competitive',  color:'#E24B4A'},
  ],
};
const DNA_DIMS   = ['First touch','Intelligence','Mindset','Social skills','Competitive'];
const DNA_COLORS = {'First touch':'#00D4AA','Intelligence':'#7F77DD','Mindset':'#4A7ED9','Social skills':'#BA7517','Competitive':'#E24B4A'};
const DNA_BASE   = {'First touch':7,'Intelligence':8,'Mindset':7,'Social skills':7,'Competitive':7};

// ══════════════════════════════════
// STATE
// ══════════════════════════════════
let phVaihe = 1;
let currentPos = 'kes';
let scores = {};
let dnaCurrent = {...DNA_BASE};
let konfig_painotukset = {...SEURA.painotukset};
let konfig_periaatteet = [...SEURA.periaatteet.slice(0,5)];
let charts = {};

// ══════════════════════════════════
// TAB
// ══════════════════════════════════
function naytaTabi(nimi, btn) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('view-' + nimi).classList.add('active');
  btn.classList.add('active');
  if (nimi==='tilanne')      renderTilanne();
  if (nimi==='pelihavainto') renderPH();
  if (nimi==='dna')          renderDNA();
  if (nimi==='valmentajat')  renderValmentajat();
  if (nimi==='polku')        renderPolku();
  if (nimi==='oppiminen')    renderOppiminen();
  if (nimi==='konfig')       renderKonfig();
}

// ══════════════════════════════════
// TILANNE
// ══════════════════════════════════
function renderTilanne() {
  renderDnaRing();
  renderMomentum();
  renderJoukkueet();
}

function renderDnaRing() {
  const canvas = document.getElementById('dnaRing');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const pct = SEURA.dna_match / 100;
  ctx.clearRect(0,0,110,110);
  ctx.beginPath(); ctx.arc(55,55,44,0,Math.PI*2);
  ctx.strokeStyle='rgba(0,0,0,.08)'; ctx.lineWidth=9; ctx.stroke();
  ctx.beginPath(); ctx.arc(55,55,44,-Math.PI/2,-Math.PI/2+Math.PI*2*pct);
  ctx.strokeStyle=SEURA.accent; ctx.lineWidth=9; ctx.lineCap='round'; ctx.stroke();
}

function renderMomentum() {
  const joukkueet = [
    {nimi:'P17A', data:[72,75,80,83,88,88], s:'up'},
    {nimi:'P15A', data:[82,80,79,75,72,71], s:'down'},
    {nimi:'P13A', data:[88,90,91,92,93,94], s:'up'},
    {nimi:'P11B', data:[65,63,61,60,59,58], s:'down'},
    {nimi:'P13B', data:[78,79,80,81,81,82], s:'flat'},
  ];
  const el = document.getElementById('momentum-lista');
  el.innerHTML = joukkueet.map(j => {
    const badge = j.s==='up'
      ? '<span class="momentum-badge momentum-up">↑ Nouseva</span>'
      : j.s==='down'
      ? '<span class="momentum-badge momentum-down">↓ Laskeva</span>'
      : '<span class="momentum-badge momentum-flat">→ Tasainen</span>';
    const color = j.s==='up'?'#2ED573':j.s==='down'?'#FF4757':'#6B7A8D';
    const w=200, h=40;
    const pts = j.data;
    const mn=Math.min(...pts)-5, mx=Math.max(...pts)+5;
    const px=(i)=>i/(pts.length-1)*(w-20)+10;
    const py=(v)=>h-(v-mn)/(mx-mn)*(h-8)-4;
    const path = pts.map((v,i)=>(i===0?'M':'L')+px(i)+','+py(v)).join(' ');
    return `<div class="momentum-item">
      <div class="momentum-nimi">${j.nimi}</div>
      <div class="momentum-spark">
        <svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">
          <path d="${path}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity=".8"/>
          <circle cx="${px(pts.length-1)}" cy="${py(pts[pts.length-1])}" r="3" fill="${color}"/>
        </svg>
      </div>
      ${badge}
    </div>`;
  }).join('');
}

function renderJoukkueet() {
  document.getElementById('joukkue-grid').innerHTML = JOUKKUEET.map(j => {
    const color = j.dna>=85?'var(--green)':j.dna>=70?'var(--amber)':'var(--red)';
    const arrow = j.momentum==='up'?'↑':j.momentum==='down'?'↓':'→';
    return `<div class="joukkue-kortti">
      <div class="joukkue-nimi">${j.nimi}</div>
      <div class="joukkue-meta">${j.ikä} · ${j.pelaajia} pelaajaa · ${j.valmentaja}</div>
      <div class="jk-stats">
        <div class="jk-stat"><strong style="color:${color}">${j.dna}%</strong><span>DNA</span></div>
        <div class="jk-stat"><strong style="color:${color}">${arrow}</strong><span>Trendi</span></div>
      </div>
    </div>`;
  }).join('');
}

// ══════════════════════════════════
// PELIHAVAINTO
// ══════════════════════════════════
function renderPH() {
  renderQuestions(currentPos);
  renderDnaFeedback();
  renderKpiTrendi();
}

function setPos(pos, btn) {
  currentPos = pos;
  scores = {};
  document.querySelectorAll('.ph-pos-btn').forEach(b => b.classList.remove('on'));
  btn.classList.add('on');
  renderQuestions(pos);
  updateTotal();
  dnaCurrent = {...DNA_BASE};
  renderDnaFeedback();
}

function renderQuestions(pos) {
  const qs = KPI_DATA[pos];
  document.getElementById('kpi-questions').innerHTML = qs.map((q,i) => `
    <div class="kpi-q-block" id="q-block-${i}">
      <div class="kpi-q-top">
        <div class="kpi-q-text">${q.q}</div>
        <div class="kpi-dna-tag" style="background:${q.color}20;color:${q.color};border:1px solid ${q.color}40;">${q.dna}</div>
      </div>
      <div class="kpi-score-row">
        <button class="kpi-score-btn" onclick="setScore(${i},0,this,'sel-0')">0<span class="lbl">Ei toteutunut</span></button>
        <button class="kpi-score-btn" onclick="setScore(${i},1,this,'sel-1')">1<span class="lbl">Osittain</span></button>
        <button class="kpi-score-btn" onclick="setScore(${i},2,this,'sel-2')">2<span class="lbl">Selvästi</span></button>
      </div>
    </div>`).join('');
}

function setScore(idx, val, btn, cls) {
  scores[idx] = val;
  const block = document.getElementById('q-block-'+idx);
  block.querySelectorAll('.kpi-score-btn').forEach(b=>b.className='kpi-score-btn');
  btn.classList.add(cls);
  block.classList.add('answered');
  updateTotal();
  updateDna();
}

function updateTotal() {
  const total = Object.values(scores).reduce((s,v)=>s+v,0);
  const answered = Object.keys(scores).length;
  const max = KPI_DATA[currentPos].length * 2;
  const el = document.getElementById('kpi-total');
  el.textContent = total;
  el.style.color = total>=8?'var(--green)':total>=5?'var(--amber)':'var(--red)';
  document.getElementById('kpi-label-text').textContent =
    answered<5 ? `${answered}/5 kysymystä vastattu` : `Kaikki vastattu · ${total}/${max} pistettä`;
  document.getElementById('kpi-progress-bar').style.width = (total/max*100)+'%';
}

function updateDna() {
  dnaCurrent = {...DNA_BASE};
  const qs = KPI_DATA[currentPos];
  Object.entries(scores).forEach(([idx,val]) => {
    const dim = qs[idx].dna;
    dnaCurrent[dim] = Math.min(10, (dnaCurrent[dim]||7) + (val-1)*0.6);
  });
  renderDnaFeedback();
}

function renderDnaFeedback() {
  document.getElementById('dna-feedback').innerHTML = DNA_DIMS.map(d => {
    const v = dnaCurrent[d]||7;
    const pct = Math.round(v/10*100);
    return `<div class="dna-fb-row">
      <div class="dna-fb-label">${d}</div>
      <div class="dna-fb-track"><div class="dna-fb-fill" style="width:${pct}%;background:${DNA_COLORS[d]}"></div></div>
      <div class="dna-fb-val" style="color:${DNA_COLORS[d]}">${v.toFixed(1)}</div>

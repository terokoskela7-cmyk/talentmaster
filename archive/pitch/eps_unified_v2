// Pelihavainto-vaiheet
function naytaPHVaihe(n) {
  phVaihe = n;
  [1,2,3,4].forEach(i => {
    const el = document.getElementById('ph-vaihe'+i);
    if(el) el.style.display = i===n ? 'block' : 'none';
  });
  [1,2,3].forEach(i => {
    const vEl = document.getElementById('ph-v'+i);
    if(!vEl) return;
    vEl.classList.toggle('active', i===n);
    vEl.classList.toggle('done', i<n);
    const nEl = document.getElementById('ph-num'+i);
    if(nEl) nEl.textContent = i<n ? '✓' : i;
  });
}


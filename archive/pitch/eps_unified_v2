function updateKonfig(dim, val) {
  konfig_painotukset[dim] = parseInt(val);
  document.getElementById('kval-'+dim.replace(' ','_')).textContent = val;
  renderKonfigRadar();
  renderKonfigBars();
}

function togglePeriaate(p, btn) {
  const idx = konfig_periaatteet.indexOf(p);
  if(idx===-1) konfig_periaatteet.push(p);
  else konfig_periaatteet.splice(idx,1);
  btn.classList.toggle('on');
  document.getElementById('konfig-periaatteet-preview').textContent = konfig_periaatteet.join(' · ') || '—';
}

function renderKonfigRadar() {
  const ctx = document.getElementById('konfig-radar');

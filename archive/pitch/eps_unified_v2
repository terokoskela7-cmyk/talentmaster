<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EPS · TalentMaster™</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
:root {
  --bg:#F4F6F9; --bg2:#FFFFFF; --bg3:#EEF1F5; --surface:#FFFFFF;
  --border:rgba(0,0,0,.08); --bord2:rgba(0,0,0,.14);
  --text:#1A1E28; --ink2:#44505F; --ink3:#8892A0;
  --green:#1A7A3C; --amber:#C47A00; --red:#B82020; --teal:#007070;
  --accent:#004B87; --accent2:#0062B1; --seura-primary-rgb:0,75,135;
  --blue:#2A60B0; --purple:#6B35B8; --gold:#9A7010;
  --shadow:0 1px 4px rgba(0,0,0,.08), 0 2px 12px rgba(0,0,0,.04);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:'DM Sans',sans-serif;font-size:14px;min-height:100vh;}
@keyframes fadeup{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.fadeup{animation:fadeup .35s ease both;}

/* ── HEADER ── */
.header{background:#004B87;padding:0 24px;border-bottom:none;display:flex;align-items:center;height:56px;gap:12px;position:sticky;top:0;z-index:100;box-shadow:0 2px 8px rgba(0,75,135,.3);}
.logo{font-family:'Barlow Condensed',sans-serif;font-weight:900;font-size:20px;color:#fff;}
.logo span{color:rgba(255,255,255,.65);font-weight:400;}
.header-seura{font-size:12px;font-weight:700;color:rgba(255,255,255,.75);padding-left:16px;border-left:1px solid rgba(255,255,255,.2);letter-spacing:.5px;text-transform:uppercase;}
.header-right{margin-left:auto;display:flex;align-items:center;gap:8px;}
.header-role{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:5px 14px;border-radius:20px;background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25);}

/* ── TABS ── */
.tabs{background:var(--bg2);border-bottom:2px solid var(--border);padding:0 24px;display:flex;gap:0;position:sticky;top:56px;z-index:99;overflow-x:auto;box-shadow:0 1px 4px rgba(0,0,0,.05);}
.tab-btn{background:none;border:none;color:var(--ink3);font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;padding:12px 14px;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;transition:all .15s;white-space:nowrap;display:flex;align-items:center;gap:6px;}
.tab-btn:hover{color:var(--text);background:var(--bg3);}
.tab-btn.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:700;}
.tab-new{font-size:8px;font-weight:700;padding:1px 5px;border-radius:3px;background:rgba(var(--seura-primary-rgb),.15);color:var(--accent);letter-spacing:.5px;text-transform:uppercase;}
.tab-hot{font-size:8px;font-weight:700;padding:1px 5px;border-radius:3px;background:rgba(46,213,115,.12);color:var(--green);letter-spacing:.5px;text-transform:uppercase;}

/* ── VIEWS ── */
.view{display:none;}.view.active{display:block;}
.inner{max-width:1200px;margin:0 auto;padding:24px;}
.inner-split{max-width:1200px;margin:0 auto;padding:24px;display:grid;grid-template-columns:1fr 320px;gap:20px;}
@media(max-width:900px){.inner-split{grid-template-columns:1fr;}}

/* ── CARDS ── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-bottom:16px;box-shadow:var(--shadow);}
.card-title{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--ink3);margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;}
.card-title-val{font-size:11px;color:var(--ink2);font-weight:400;letter-spacing:0;text-transform:none;}
.stitle{font-family:'Barlow Condensed',sans-serif;font-size:18px;font-weight:700;margin-bottom:4px;}
.stitle-sub{font-size:11px;color:var(--ink3);font-weight:400;margin-left:8px;}

/* ── KPI GRID ── */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px;}
.kpi{background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:18px 16px;cursor:pointer;transition:border-color .15s,box-shadow .15s;box-shadow:var(--shadow);position:relative;overflow:hidden;}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
.kpi:nth-child(1)::before{background:#004B87;}
.kpi:nth-child(2)::before{background:#1A7A3C;}
.kpi:nth-child(3)::before{background:#C47A00;}
.kpi:nth-child(4)::before{background:#007070;}
.kpi:hover{border-color:rgba(var(--seura-primary-rgb),.25);box-shadow:0 4px 16px rgba(0,0,0,.1);}
.kpi-val{font-family:'Barlow Condensed',sans-serif;font-size:36px;font-weight:900;color:var(--accent);line-height:1;}
.kpi-label{font-size:10px;color:var(--ink3);letter-spacing:.5px;text-transform:uppercase;margin-top:4px;font-weight:600;}
.kpi-delta{font-size:11px;font-weight:600;margin-top:6px;padding:2px 8px;border-radius:10px;display:inline-block;}

/* ── DNA RING ── */
.dna-ring-wrap{display:flex;gap:20px;align-items:flex-start;}
.dna-score-ring{position:relative;width:110px;height:110px;flex-shrink:0;}
.dna-score-ring canvas{position:absolute;top:0;left:0;}
.dna-score-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
.dna-score-num{font-family:'Barlow Condensed',sans-serif;font-size:30px;font-weight:900;line-height:1;}
.dna-score-label{font-size:8px;letter-spacing:1px;text-transform:uppercase;color:var(--ink3);margin-top:2px;}

/* ── DNA BARS ── */
.dna-bar-row{display:flex;align-items:center;gap:10px;margin-bottom:8px;}
.dna-bar-label{font-size:12px;color:var(--ink2);width:110px;flex-shrink:0;}
.dna-bar-track{flex:1;height:6px;background:var(--bg3);border-radius:3px;overflow:hidden;position:relative;border:1px solid var(--border);}
.dna-bar-fill{height:100%;border-radius:3px;transition:width .6s;}
.dna-bar-target{position:absolute;top:-2px;width:2px;height:10px;background:rgba(0,0,0,.25);border-radius:1px;}
.dna-bar-val{font-size:11px;font-weight:600;width:32px;text-align:right;}
.dna-bar-delta{font-size:10px;width:18px;text-align:right;}

/* ── JOUKKUEET ── */
.joukkue-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:10px;margin-bottom:16px;}
.joukkue-kortti{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:14px 16px;cursor:pointer;transition:border-color .15s,transform .1s;position:relative;overflow:hidden;}
.joukkue-kortti:hover{border-color:rgba(var(--seura-primary-rgb),.3);transform:translateY(-1px);}
.joukkue-kortti::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:#004B87;opacity:0;transition:opacity .15s;}
.joukkue-kortti:hover::before{opacity:1;}
.joukkue-nimi{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:16px;margin-bottom:3px;}
.joukkue-meta{font-size:11px;color:var(--ink3);margin-bottom:8px;}
.jk-stats{display:flex;gap:14px;margin-top:6px;}
.jk-stat strong{display:block;font-family:'Barlow Condensed',sans-serif;font-size:18px;line-height:1;}
.jk-stat span{font-size:9px;color:var(--ink3);text-transform:uppercase;letter-spacing:.5px;}

/* ── MOMENTUM ── */
.momentum-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:12px;margin-bottom:7px;}
.momentum-nimi{font-size:13px;font-weight:600;width:50px;flex-shrink:0;}
.momentum-spark{flex:1;}
.momentum-badge{font-size:9px;font-weight:700;padding:2px 7px;border-radius:10px;letter-spacing:.5px;text-transform:uppercase;}
.momentum-up{background:rgba(26,122,60,.08);color:#1A7A3C;}
.momentum-down{background:rgba(184,32,32,.08);color:#B82020;}
.momentum-flat{background:rgba(136,146,160,.1);color:#8892A0;}

/* ── ALERTS ── */
.alert{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:10px 14px;margin-bottom:8px;border-left:3px solid;}
.alert.red{border-left-color:#B82020;background:rgba(184,32,32,.02);}
.alert.amber{border-left-color:#C47A00;background:rgba(196,122,0,.02);}
.alert.green{border-left-color:#1A7A3C;background:rgba(26,122,60,.02);}
.atitle{font-size:12px;font-weight:600;margin-bottom:2px;}
.adesc{font-size:11px;color:var(--ink2);line-height:1.55;}

/* ── VALMENTAJAT NELIKENTTÄ ── */
.nk-wrap{position:relative;width:100%;aspect-ratio:1;background:#F8FAFE;border-radius:10px;overflow:hidden;border:1px solid var(--border);}
.nk-wrap canvas{position:absolute;inset:0;width:100%!important;height:100%!important;}
.nk-quad-label{position:absolute;font-size:9px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;padding:8px 10px;line-height:1.4;pointer-events:none;background:rgba(255,255,255,.7);border-radius:4px;margin:6px;}
.nk-quad-label.tl{top:0;left:0;color:#C47A00;}
.nk-quad-label.tr{top:0;right:0;text-align:right;color:#1A7A3C;}
.nk-quad-label.bl{bottom:0;left:0;color:#B82020;}
.nk-quad-label.br{bottom:0;right:0;text-align:right;color:#007070;}

/* ── RADAR ── */
.radar-wrap{position:relative;}

/* ── PELIHAVAINTO ── */
.ph-header{background:linear-gradient(135deg,rgba(0,75,135,.06),rgba(0,75,135,.02));border:1px solid rgba(0,75,135,.15);border-radius:12px;padding:16px 20px;margin-bottom:16px;}
.ph-vaihejono{display:flex;align-items:center;gap:0;margin-bottom:20px;}
.ph-vaihe{display:flex;align-items:center;gap:8px;flex:1;padding:10px 12px;border-radius:8px;cursor:pointer;transition:background .15s;}
.ph-vaihe.active{background:rgba(var(--seura-primary-rgb),.1);}
.ph-vaihe-num{width:26px;height:26px;border-radius:50%;border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0;color:var(--ink3);}
.ph-vaihe.active .ph-vaihe-num{background:var(--accent);border-color:var(--accent);color:#fff;}
.ph-vaihe.done .ph-vaihe-num{background:var(--green);border-color:var(--green);color:#fff;}
.ph-vaihe-label{font-size:11px;font-weight:600;color:var(--ink3);}
.ph-vaihe.active .ph-vaihe-label,.ph-vaihe.done .ph-vaihe-label{color:var(--text);}
.ph-connector{width:24px;height:1px;background:var(--border);}

.ph-pelipaikka-wrap{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.ph-pos-btn{padding:7px 16px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--ink3);font-size:12px;font-weight:500;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif;}
.ph-pos-btn:hover{border-color:var(--bord2);color:var(--text);}
.ph-pos-btn.on{background:rgba(var(--seura-primary-rgb),.12);border-color:rgba(var(--seura-primary-rgb),.35);color:var(--accent);}

.kpi-q-block{background:var(--bg3);border:1px solid var(--border);box-shadow:none;border-radius:10px;padding:14px 16px;margin-bottom:10px;transition:border-color .15s;}
.kpi-q-block.answered{border-color:rgba(var(--seura-primary-rgb),.25);}
.kpi-q-top{display:flex;align-items:flex-start;gap:10px;margin-bottom:12px;}
.kpi-q-text{font-size:12px;color:var(--ink2);line-height:1.65;flex:1;}
.kpi-dna-tag{font-size:9px;font-weight:700;padding:2px 7px;border-radius:4px;letter-spacing:.5px;text-transform:uppercase;white-space:nowrap;flex-shrink:0;}
.kpi-score-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;}
.kpi-score-btn{width:100%;padding:9px 6px;border-radius:8px;border:1px solid var(--border);background:transparent;color:var(--ink3);cursor:pointer;font-size:13px;font-weight:700;font-family:'DM Sans',sans-serif;transition:all .15s;text-align:center;line-height:1.2;}
.kpi-score-btn .lbl{font-size:9px;font-weight:400;display:block;margin-top:2px;letter-spacing:.3px;}
.kpi-score-btn:hover{border-color:var(--bord2);color:var(--text);}
.kpi-score-btn.sel-0{background:rgba(255,71,87,.1);border-color:var(--red);color:var(--red);}
.kpi-score-btn.sel-1{background:rgba(255,165,2,.1);border-color:var(--amber);color:var(--amber);}
.kpi-score-btn.sel-2{background:rgba(46,213,115,.1);border-color:var(--green);color:var(--green);}

.kpi-progress{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:14px;display:flex;align-items:center;gap:14px;}
.kpi-progress-total{font-family:'Barlow Condensed',sans-serif;font-size:36px;font-weight:900;line-height:1;color:var(--accent);width:44px;text-align:center;}
.kpi-progress-info{flex:1;}
.kpi-progress-bar-wrap{height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;margin-top:6px;border:1px solid var(--border);}
.kpi-progress-bar{height:5px;border-radius:3px;background:var(--accent);transition:width .4s;}

.havainto-area{width:100%;background:#fff;border:1.5px solid var(--border);border-radius:8px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:12px;padding:10px 12px;resize:vertical;min-height:70px;outline:none;transition:border-color .15s;line-height:1.6;}
.havainto-area:focus{border-color:var(--accent);}

/* ── ADAR ── */
.adar-blokki{margin-bottom:14px;}
.adar-label{font-size:11px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:8px;}
.adar-kirjain{width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-family:'Barlow Condensed',sans-serif;font-size:14px;font-weight:900;flex-shrink:0;}

/* ── DNA LIVE FEEDBACK ── */
.dna-fb-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.dna-fb-label{font-size:11px;color:var(--ink2);width:100px;flex-shrink:0;}
.dna-fb-track{flex:1;height:4px;background:var(--bg3);border-radius:2px;overflow:hidden;border:1px solid var(--border);}
.dna-fb-fill{height:4px;border-radius:2px;transition:width .5s;}
.dna-fb-val{font-size:11px;font-weight:600;width:28px;text-align:right;}

/* ── ITSEARVIOINTI ── */
.oma-q{margin-bottom:14px;}
.oma-q-label{font-size:12px;color:var(--ink2);line-height:1.6;margin-bottom:8px;}
.oma-scale{display:flex;gap:6px;}
.oma-scale-btn{flex:1;padding:8px 4px;border-radius:7px;border:1px solid var(--border);background:transparent;color:var(--ink3);font-size:12px;font-weight:600;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .15s;text-align:center;}
.oma-scale-btn:hover{border-color:var(--bord2);color:var(--text);}
.oma-scale-btn.on{background:rgba(var(--seura-primary-rgb),.12);border-color:rgba(var(--seura-primary-rgb),.4);color:var(--accent);}

/* ── TALLENNA BTN ── */
.tallenna-btn{background:var(--accent);color:#fff;border:none;border-radius:10px;padding:12px 24px;font-size:13px;font-weight:700;cursor:pointer;width:100%;margin-top:14px;transition:opacity .15s;font-family:'DM Sans',sans-serif;letter-spacing:.2px;}
.tallenna-btn:hover{opacity:.85;}

/* ── OPPIMINEN ── */
.opp-lista{display:flex;flex-direction:column;gap:8px;}
.opp-item{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:12px 14px;}
.opp-title{font-size:12px;font-weight:600;margin-bottom:3px;}
.opp-sub{font-size:11px;color:var(--ink2);line-height:1.55;}
.korr-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);}
.korr-item:last-child{border-bottom:none;}
.korr-bar{flex:1;height:5px;background:var(--bg3);border-radius:3px;overflow:hidden;border:1px solid var(--border);}
.korr-fill{height:5px;border-radius:3px;}

/* ── KONFIG ── */
.konfig-slider-row{display:flex;align-items:center;gap:12px;margin-bottom:12px;padding:8px 0;border-bottom:1px solid var(--border);}
.konfig-slider-label{font-size:12px;color:var(--ink2);width:120px;flex-shrink:0;font-weight:500;}
.konfig-slider{flex:1;-webkit-appearance:none;height:6px;border-radius:3px;background:var(--bg3);outline:none;cursor:pointer;border:1px solid var(--border);}
.konfig-slider::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:var(--accent);cursor:pointer;box-shadow:0 1px 4px rgba(0,0,0,.2);}
.konfig-slider-val{font-size:13px;font-weight:700;width:24px;text-align:right;color:var(--accent);}
.periaate-grid{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:10px;}
.periaate-chip{padding:6px 14px;border-radius:16px;border:1.5px solid var(--border);background:var(--bg3);color:var(--ink3);font-size:11px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif;font-weight:500;}
.periaate-chip:hover{border-color:rgba(var(--seura-primary-rgb),.4);color:var(--accent);}
.periaate-chip.on{background:rgba(var(--seura-primary-rgb),.08);border-color:rgba(var(--seura-primary-rgb),.45);color:var(--accent);font-weight:600;}
.konfig-input{width:100%;background:var(--bg3);border:1.5px solid var(--border);border-radius:8px;padding:10px 12px;color:var(--text);font-family:'DM Sans',sans-serif;font-size:12px;outline:none;resize:vertical;min-height:64px;line-height:1.6;}
.konfig-input:focus{border-color:var(--accent);}

/* ── SUCCESS ── */
.success-box{text-align:center;padding:40px 20px;}
.success-icon{font-size:52px;margin-bottom:16px;}
.success-title{font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:900;margin-bottom:8px;}
.success-sub{font-size:13px;color:var(--ink2);line-height:1.7;max-width:480px;margin:0 auto;}

/* ── HIDDEN GEM ── */
.gem-item{background:var(--surface);border:1px solid rgba(154,112,16,.2);border-radius:8px;padding:10px 14px;margin-bottom:7px;display:flex;align-items:center;gap:12px;box-shadow:var(--shadow);}
.gem-score{font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:900;color:#9A7010;width:36px;text-align:center;}
.gem-nimi{font-size:13px;font-weight:600;}
.gem-syy{font-size:10px;color:var(--ink3);margin-top:2px;}
.gem-joukkue{font-size:10px;font-weight:700;color:var(--accent);background:rgba(var(--seura-primary-rgb),.1);padding:2px 7px;border-radius:4px;margin-left:auto;flex-shrink:0;}

/* ── POLKU ── */
.suppilo-item{padding:8px 12px;border-radius:6px;display:flex;align-items:center;justify-content:space-between;font-size:12px;margin-bottom:5px;}

/* ── TOAST ── */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--green);color:var(--bg);font-size:12px;font-weight:700;padding:10px 22px;border-radius:20px;opacity:0;transition:opacity .3s;pointer-events:none;z-index:999;white-space:nowrap;}
.toast.on{opacity:1;}
</style>
</head>
<body>

<!-- ══ HEADER ══ -->
<div class="header">
  <div class="logo">Talent<span>Master™</span></div>
  <div class="header-seura" id="header-seura-nimi">Espoon Palloseura</div>
  <div class="header-right">
    <div class="header-role" id="header-role">Valmennuspäällikkö</div>
  </div>
</div>

<!-- ══ TABS ══ -->
<nav class="tabs">
  <button class="tab-btn active" onclick="naytaTabi('tilanne',this)">📊 Tilanne nyt</button>
  <button class="tab-btn" onclick="naytaTabi('pelihavainto',this)">⚽ Pelihavainto <span class="tab-hot">LIVE</span></button>
  <button class="tab-btn" onclick="naytaTabi('dna',this)">🧬 DNA & Identiteetti</button>
  <button class="tab-btn" onclick="naytaTabi('valmentajat',this)">👥 Valmentajat</button>
  <button class="tab-btn" onclick="naytaTabi('polku',this)">🔍 Kehityspolut</button>
  <button class="tab-btn" onclick="naytaTabi('oppiminen',this)">📈 Seuran oppiminen</button>
  <button class="tab-btn" onclick="naytaTabi('konfig',this)">⚙️ DNA-konfiguraatio</button>
</nav>

<!-- ══════════════════════════════════
     TAB 1 — TILANNE NYT
══════════════════════════════════ -->
<div class="view active" id="view-tilanne">
<div class="inner fadeup">

<script>
// Scroll reveal
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.07, rootMargin:'0px 0px -30px 0px' });
document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

// Pillar toggle
function togglePillar(n) {
  const pillar = document.querySelector(`[data-pillar="${n}"]`);
  const panel = document.getElementById(`detail-${n}`);
  const isOpen = panel.classList.contains('open');

  // Close all
  document.querySelectorAll('.pillar').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.detail-panel').forEach(p => p.classList.remove('open'));

  if (!isOpen) {
    pillar.classList.add('active');
    panel.classList.add('open');
    // Smooth scroll
    setTimeout(() => {
      pillar.scrollIntoView({ behavior:'smooth', block:'nearest' });
    }, 50);
  }
}
</script>

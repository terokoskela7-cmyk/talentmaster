<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hammarby × TalentMaster — System Simulation</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap" rel="stylesheet">
<style>
:root {
  --carbon:#1C1C1A; --bone:#F2EFE6; --teal:#1A7A5E; --slate:#8C8B83;
  --bone2:#E8E5DC; --bone3:#D4D1C8; --carbon2:#2A2A28; --carbon3:#363634;
  --ham:#006633; --ham2:rgba(0,102,51,.12); --ham3:rgba(0,102,51,.06);
  --tm-teal:rgba(26,122,94,.12); --amber:#C8882A; --red:#B03A2E;
}
*{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{background:var(--bone);color:var(--carbon);font-family:'DM Sans',sans-serif;font-size:14px;line-height:1.6;overflow-x:hidden;}

/* ── REVEAL ── */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease;}
.reveal.visible{opacity:1;transform:none;}
.delay-1{transition-delay:.1s;} .delay-2{transition-delay:.2s;}
.delay-3{transition-delay:.3s;} .delay-4{transition-delay:.4s;}
.delay-5{transition-delay:.5s;}

/* ── HERO ── */
.hero{background:var(--carbon);padding:80px 64px 64px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;right:-120px;top:-120px;width:480px;height:480px;border-radius:50%;border:1px solid rgba(242,239,230,.04);}
.hero::after{content:'';position:absolute;right:-60px;top:-60px;width:320px;height:320px;border-radius:50%;border:1px solid rgba(242,239,230,.06);}
.hero-inner{max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:48px;align-items:end;}
.hero-eyebrow{font-size:9px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--teal);margin-bottom:16px;}
.hero-title{font-family:'Cormorant Garamond',serif;font-size:clamp(40px,5vw,72px);font-weight:300;line-height:.95;letter-spacing:-2.5px;color:var(--bone);margin-bottom:16px;}
.hero-title .ham-color{color:var(--ham);font-style:italic;}
.hero-title .x{color:rgba(242,239,230,.2);}
.hero-sub{font-size:14px;color:rgba(242,239,230,.45);max-width:520px;line-height:1.75;}
.hero-meta{display:flex;flex-direction:column;gap:8px;align-items:flex-end;}
.hero-badge{padding:8px 16px;border-radius:6px;font-size:10px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-align:center;}
.hero-badge.ham{background:rgba(0,102,51,.2);border:1px solid rgba(0,102,51,.3);color:#5CB87A;}
.hero-badge.tm{background:rgba(26,122,94,.12);border:1px solid rgba(26,122,94,.25);color:var(--teal);}
.hero-note{font-size:10px;color:rgba(242,239,230,.2);text-align:right;letter-spacing:.3px;}

/* ── SECTION ── */
section{padding:72px 64px;}
.inner{max-width:1200px;margin:0 auto;}
.section-eyebrow{font-size:9px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--teal);margin-bottom:12px;}
.section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(28px,3.5vw,48px);font-weight:400;letter-spacing:-1.5px;line-height:.95;margin-bottom:10px;}
.section-title em{font-style:italic;color:var(--slate);}
.section-lead{font-size:14px;color:var(--slate);max-width:560px;line-height:1.75;margin-bottom:48px;}

/* ── PILLAR GRID ── */
.pillars{display:flex;flex-direction:column;gap:3px;}
.pillar{display:grid;grid-template-columns:1fr 60px 1fr;gap:0;cursor:pointer;border-radius:0;}
.pillar:first-child{border-radius:12px 12px 0 0;}
.pillar:last-child{border-radius:0 0 12px 12px;}
.pillar.active .pillar-ham{background:var(--ham);}
.pillar.active .pillar-tm{background:var(--teal);}
.pillar.active .pillar-bridge{background:var(--carbon);}

.pillar-ham{background:var(--ham3);border:1px solid rgba(0,102,51,.12);padding:22px 26px;transition:background .25s,border-color .25s;}
.pillar-ham:hover,.pillar.active .pillar-ham{border-color:rgba(0,102,51,.35);}
.pillar-tm{background:var(--tm-teal);border:1px solid rgba(26,122,94,.12);padding:22px 26px;transition:background .25s,border-color .25s;}
.pillar-tm:hover,.pillar.active .pillar-tm{border-color:rgba(26,122,94,.35);}

.pillar-bridge{background:var(--carbon2);display:flex;align-items:center;justify-content:center;flex-direction:column;gap:4px;padding:8px 4px;transition:background .25s;}
.bridge-arrow{font-size:18px;color:rgba(242,239,230,.15);}
.pillar.active .bridge-arrow{color:var(--teal);}
.bridge-num{font-family:'Cormorant Garamond',serif;font-size:11px;font-weight:400;color:rgba(242,239,230,.2);}
.pillar.active .bridge-num{color:rgba(242,239,230,.5);}

.pillar-eyebrow{font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:6px;opacity:.55;}
.pillar-ham .pillar-eyebrow{color:var(--ham);}
.pillar-tm .pillar-eyebrow{color:var(--teal);}
.pillar.active .pillar-ham .pillar-eyebrow{color:#5CB87A;opacity:1;}
.pillar.active .pillar-tm .pillar-eyebrow{color:#7ECFB3;opacity:1;}

.pillar-title{font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:500;letter-spacing:-.3px;margin-bottom:6px;}
.pillar-ham .pillar-title{color:var(--carbon);}
.pillar-tm .pillar-title{color:var(--carbon);}
.pillar.active .pillar-ham .pillar-title{color:#FFFFFF;}
.pillar.active .pillar-tm .pillar-title{color:#FFFFFF;}

.pillar-desc{font-size:12px;line-height:1.65;}
.pillar-ham .pillar-desc{color:var(--slate);}
.pillar-tm .pillar-desc{color:var(--slate);}
.pillar.active .pillar-ham .pillar-desc{color:rgba(255,255,255,.65);}
.pillar.active .pillar-tm .pillar-desc{color:rgba(255,255,255,.65);}

.pillar-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:10px;}
.tag{font-size:9px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;padding:2px 8px;border-radius:4px;}
.tag-ham{background:rgba(0,102,51,.1);color:var(--ham);border:1px solid rgba(0,102,51,.15);}
.tag-tm{background:rgba(26,122,94,.1);color:var(--teal);border:1px solid rgba(26,122,94,.15);}
.tag-build{background:rgba(200,136,42,.1);color:var(--amber);border:1px solid rgba(200,136,42,.2);}
.tag-miss{background:rgba(176,58,46,.08);color:var(--red);border:1px solid rgba(176,58,46,.15);}
.pillar.active .tag-ham{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.2);}
.pillar.active .tag-tm{background:rgba(255,255,255,.1);color:rgba(255,255,255,.7);border-color:rgba(255,255,255,.2);}
.pillar.active .tag-build{background:rgba(200,136,42,.25);color:#E8B97A;border-color:rgba(200,136,42,.4);}
.pillar.active .tag-miss{background:rgba(200,136,42,.25);color:#E8B97A;border-color:rgba(200,136,42,.4);}

/* ── DETAIL PANEL ── */
.detail-panel{display:none;background:var(--carbon);border-radius:12px;margin-top:3px;overflow:hidden;}
.detail-panel.open{display:block;}
.detail-inner{display:grid;grid-template-columns:1fr 1fr;gap:0;}
.detail-ham{background:rgba(0,102,51,.08);border-right:1px solid rgba(242,239,230,.05);padding:32px;}
.detail-tm{padding:32px;}
.detail-label{font-size:8px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;margin-bottom:16px;}
.detail-ham .detail-label{color:#5CB87A;}
.detail-tm .detail-label{color:var(--teal);}
.detail-quote{font-family:'Cormorant Garamond',serif;font-size:18px;font-style:italic;font-weight:300;color:rgba(242,239,230,.8);line-height:1.5;margin-bottom:16px;border-left:2px solid var(--ham);padding-left:14px;}
.detail-tm .detail-quote{border-left-color:var(--teal);}
.detail-items{display:flex;flex-direction:column;gap:8px;}
.detail-item{display:flex;gap:10px;font-size:12px;color:rgba(242,239,230,.55);line-height:1.5;}
.detail-item-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.detail-item-dot.ham{background:var(--ham);}
.detail-item-dot.tm{background:var(--teal);}
.detail-item-dot.build{background:var(--amber);}
.detail-stat{display:flex;align-items:baseline;gap:8px;margin-top:16px;padding:12px 14px;background:rgba(242,239,230,.04);border-radius:8px;}
.detail-stat-n{font-family:'Cormorant Garamond',serif;font-size:32px;font-weight:300;color:var(--teal);letter-spacing:-1px;line-height:1;}
.detail-stat-label{font-size:10px;color:rgba(242,239,230,.3);letter-spacing:.5px;}

/* Mock UI elements */
.mock-ui{background:rgba(242,239,230,.04);border:1px solid rgba(242,239,230,.07);border-radius:10px;padding:16px;margin-top:16px;}
.mock-header{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:rgba(242,239,230,.25);margin-bottom:12px;}
.mock-spider{width:100%;max-width:200px;display:block;margin:0 auto 12px;}
.mock-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:6px;}
.mock-bar-label{font-size:10px;color:rgba(242,239,230,.35);width:80px;flex-shrink:0;}
.mock-bar-track{flex:1;height:4px;background:rgba(242,239,230,.06);border-radius:2px;overflow:hidden;}
.mock-bar-fill{height:4px;border-radius:2px;}
.mock-bar-val{font-size:10px;font-weight:600;width:24px;text-align:right;}
.mock-player-row{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid rgba(242,239,230,.05);}
.mock-player-row:last-child{border:none;padding-bottom:0;}
.mock-player-name{font-size:11px;color:rgba(242,239,230,.65);flex:1;}
.mock-player-badge{font-size:9px;font-weight:600;padding:2px 7px;border-radius:6px;}
.mock-dvi{font-family:'Cormorant Garamond',serif;font-size:16px;font-weight:400;}

/* ── BUILD PLAN ── */
.build-section{background:var(--carbon2);}
.build-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:40px;}
.build-card{border-radius:10px;padding:22px;position:relative;overflow:hidden;}
.build-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;}
.build-critical{background:rgba(176,58,46,.08);border:1px solid rgba(176,58,46,.15);}
.build-critical::before{background:var(--red);}
.build-important{background:rgba(200,136,42,.07);border:1px solid rgba(200,136,42,.15);}
.build-important::before{background:var(--amber);}
.build-strategic{background:rgba(26,122,94,.07);border:1px solid rgba(26,122,94,.15);}
.build-strategic::before{background:var(--teal);}
.build-priority{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;margin-bottom:8px;}
.build-critical .build-priority{color:var(--red);}
.build-important .build-priority{color:var(--amber);}
.build-strategic .build-priority{color:var(--teal);}
.build-title{font-family:'Cormorant Garamond',serif;font-size:19px;font-weight:500;letter-spacing:-.2px;margin-bottom:8px;color:var(--bone);}
.build-source{font-size:10px;color:rgba(242,239,230,.3);margin-bottom:10px;font-style:italic;}
.build-items{display:flex;flex-direction:column;gap:5px;}
.build-item{font-size:11px;color:rgba(242,239,230,.5);display:flex;gap:7px;line-height:1.5;}
.build-item::before{content:'→';color:rgba(242,239,230,.2);flex-shrink:0;}
.build-sprint{margin-top:12px;display:inline-flex;align-items:center;gap:5px;font-size:9px;font-weight:600;padding:3px 10px;border-radius:6px;}
.build-critical .build-sprint{background:rgba(176,58,46,.15);color:#E07070;}
.build-important .build-sprint{background:rgba(200,136,42,.15);color:#E8B97A;}
.build-strategic .build-sprint{background:rgba(26,122,94,.12);color:var(--teal);}

/* ── QUOTE SECTION ── */
.quote-section{background:var(--ham);padding:64px;}
.quote-inner{max-width:800px;margin:0 auto;text-align:center;}
.big-quote{font-family:'Cormorant Garamond',serif;font-size:clamp(22px,3.5vw,38px);font-weight:300;font-style:italic;color:rgba(255,255,255,.92);line-height:1.35;margin-bottom:16px;}
.quote-source{font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.4);}
.quote-tm-response{margin-top:24px;padding:16px 24px;background:rgba(0,0,0,.2);border-radius:10px;border-left:3px solid var(--teal);}
.tm-response-label{font-size:8px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--teal);margin-bottom:6px;}
.tm-response-text{font-size:13px;color:rgba(255,255,255,.65);line-height:1.65;}

/* ── OUTREACH ── */
.outreach-section{background:var(--carbon);}
.outreach-box{background:rgba(0,102,51,.07);border:1px solid rgba(0,102,51,.18);border-radius:14px;padding:28px 32px;margin-top:40px;}
.outreach-label{font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#5CB87A;margin-bottom:14px;}
.outreach-text{font-family:'Cormorant Garamond',serif;font-size:17px;font-weight:300;color:rgba(242,239,230,.75);line-height:1.7;font-style:italic;}
.outreach-meta{display:flex;align-items:center;gap:16px;margin-top:16px;padding-top:16px;border-top:1px solid rgba(242,239,230,.06);}
.outreach-person{font-size:12px;font-weight:500;color:var(--bone);}
.outreach-role{font-size:11px;color:var(--slate);}
.outreach-contact{font-size:11px;color:rgba(242,239,230,.3);}
.outreach-principle{margin-top:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;}
.principle{background:rgba(242,239,230,.03);border:1px solid rgba(242,239,230,.06);border-radius:8px;padding:12px 14px;}
.principle-num{font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:300;color:var(--teal);margin-bottom:4px;line-height:1;}
.principle-text{font-size:11px;color:rgba(242,239,230,.4);line-height:1.5;}

/* ── FOOTER ── */
footer{background:var(--carbon);border-top:1px solid rgba(242,239,230,.05);padding:32px 64px;display:flex;justify-content:space-between;align-items:center;}
.footer-brand{font-family:'Cormorant Garamond',serif;font-size:14px;color:rgba(242,239,230,.25);}
.footer-note{font-size:10px;color:rgba(242,239,230,.15);letter-spacing:.5px;}

/* ── COLUMN HEADERS ── */
.col-headers{display:grid;grid-template-columns:1fr 60px 1fr;gap:0;margin-bottom:3px;}
.col-header{padding:10px 26px;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;}
.col-header.ham{color:#5CB87A;background:rgba(0,102,51,.08);border-radius:10px 0 0 0;}
.col-header.bridge{background:var(--carbon3);display:flex;align-items:center;justify-content:center;}
.col-header.tm{color:var(--teal);background:rgba(26,122,94,.07);border-radius:0 10px 0 0;text-align:right;}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .hero,.hero-inner{grid-template-columns:1fr;}
  section{padding:48px 24px;}
  .hero{padding:60px 24px 48px;}
  .detail-inner,.build-grid{grid-template-columns:1fr;}
  .col-headers{display:none;}
  .pillar{grid-template-columns:1fr;}
  .pillar-bridge{display:none;}
}
</style>
</head>
<body>

<!-- HERO -->
<div class="hero">
  <div class="hero-inner reveal">
    <div>
      <div class="hero-eyebrow">Strategic system simulation · Confidential</div>
      <h1 class="hero-title">
        <span class="ham-color">Hammarby</span> <span class="x">×</span><br>
        TalentMaster™
      </h1>
      <p class="hero-sub">What Hammarby has built manually in seven years — and what it looks like when it runs on TalentMaster. Five pillars. One system. Zero extra headcount.</p>
    </div>
    <div class="hero-meta reveal delay-2">
      <div class="hero-badge ham">Hammarby IF</div>
      <div class="hero-badge tm">TalentMaster™</div>
      <div style="height:8px;"></div>
      <div class="hero-note">0.89% → 20.6% homegrown</div>
      <div class="hero-note">210+ MSEK in transfers</div>
      <div class="hero-note">5 full-time staff</div>
    </div>
  </div>
</div>


<!-- SIMULATION -->
<section>
  <div class="inner">
    <div class="section-eyebrow reveal">System mapping</div>
    <h2 class="section-title reveal delay-1">Five pillars.<br><em>One platform.</em></h2>
    <p class="section-lead reveal delay-2">Click each pillar to see how Hammarby's system maps to TalentMaster — what exists today, what is being built, and what it looks like in practice.</p>

    <div class="col-headers reveal delay-3">
      <div class="col-header ham">Hammarby IF — what they do</div>
      <div class="col-header bridge"></div>
      <div class="col-header tm">TalentMaster — how it runs</div>
    </div>

    <div class="pillars reveal delay-3">

      <!-- PILLAR 1: Style of Play → DNA -->
      <div class="pillar" data-pillar="1" onclick="togglePillar(1)">
        <div class="pillar-ham">
          <div class="pillar-eyebrow">Hammarby Pillar 1</div>
          <div class="pillar-title">Style of Play</div>
          <div class="pillar-desc">A shared playing philosophy for the entire club. Principles — not formulas. Every coach implements it their own way. Used in recruitment, IDP and training design.</div>
          <div class="pillar-tags"><span class="tag tag-ham">Club philosophy</span><span class="tag tag-ham">Coach autonomy</span><span class="tag tag-ham">Manual</span></div>
        </div>
        <div class="pillar-bridge"><div class="bridge-arrow">→</div><div class="bridge-num">01</div></div>
        <div class="pillar-tm">
          <div class="pillar-eyebrow">TalentMaster equivalent</div>
          <div class="pillar-title">DNA Builder + Configuration</div>
          <div class="pillar-desc">Five pillars: Playing philosophy · Technical identity · Psychological profile · Physical style · Community. Built once per season by the Sporting Director. Activates across all team and player views automatically.</div>
          <div class="pillar-tags"><span class="tag tag-tm">DNA Builder</span><span class="tag tag-tm">5 pillars</span><span class="tag tag-tm">✅ Built</span></div>
        </div>
      </div>
      <div class="detail-panel" id="detail-1">
        <div class="detail-inner">
          <div class="detail-ham">
            <div class="detail-label">Hammarby — how it works today</div>
            <div class="detail-quote">"Each coach interprets the Style of Play in their own way — we give principles, not formulas."</div>
            <div class="detail-items">
              <div class="detail-item"><div class="detail-item-dot ham"></div><div>Philosophy document: 41-page PDF with routines and principles</div></div>
              <div class="detail-item"><div class="detail-item-dot ham"></div><div>Updated seasonally in staff meetings</div></div>
              <div class="detail-item"><div class="detail-item-dot ham"></div><div>Coach leaves → philosophy stays in document, not in data</div></div>
              <div class="detail-item"><div class="detail-item-dot build"></div><div>Gap: No measurement of whether coaches actually implement it</div></div>
            </div>
          </div>
          <div class="detail-tm">
            <div class="detail-label">TalentMaster — what it looks like</div>
            <div class="mock-ui">
              <div class="mock-header">KPV Juniors — Club DNA · Spring 2026</div>
              <svg class="mock-spider" viewBox="0 0 200 180" xmlns="http://www.w3.org/2000/svg">
                <polygon points="100,25 160,72 138,148 62,148 40,72" fill="none" stroke="rgba(242,239,230,.08)" stroke-width="1"/>
                <polygon points="100,48 140,86 124,136 76,136 60,86" fill="none" stroke="rgba(242,239,230,.05)" stroke-width="1"/>
                <polygon points="100,92 118,113 112,130 88,130 82,113" fill="none" stroke="rgba(242,239,230,.04)" stroke-width="1"/>
                <polygon points="100,32 152,77 133,143 67,143 48,77" fill="rgba(26,122,94,.12)" stroke="#1A7A5E" stroke-width="1.5" stroke-linejoin="round"/>
                <circle cx="100" cy="32" r="3.5" fill="#C8102E"/>
                <circle cx="152" cy="77" r="3.5" fill="#1A7A5E"/>
                <circle cx="133" cy="143" r="3.5" fill="#A855F7"/>
                <circle cx="67" cy="143" r="3.5" fill="#2ED573"/>
                <circle cx="48" cy="77" r="3.5" fill="#C8882A"/>
                <text x="100" y="18" text-anchor="middle" font-size="8" fill="rgba(242,239,230,.4)" font-family="DM Sans">PLAYING PHIL.</text>
                <text x="170" y="78" font-size="7" fill="rgba(242,239,230,.35)" font-family="DM Sans">TECHNICAL</text>
                <text x="133" y="158" text-anchor="middle" font-size="7" fill="rgba(242,239,230,.35)" font-family="DM Sans">PSYCH.</text>
                <text x="55" y="158" text-anchor="middle" font-size="7" fill="rgba(242,239,230,.35)" font-family="DM Sans">PHYSICAL</text>
                <text x="10" y="78" font-size="7" fill="rgba(242,239,230,.35)" font-family="DM Sans">COMMUNITY</text>
              </svg>

{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "tm_admin/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    }
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "**/.*/**",
      ".claude/**",
      ".firebase/**",
      ".git/**",
      ".github/**",
      "Claude outputs/**",
      "archive/**",
      "assets/kuvat/**",
      "docs/**",
      "functions/**",
      "node_modules/**",
      "scripts/**",
      "src/**",
      "tests/**",
      "tm_admin/**",
      "**/*.cjs",
      "**/*.md",
      "**/*.py",
      "**/*.xlsx",
      "**/.*",
      "*.config.js",
      "TalentMaster_ADAR_Koulutus.html",
      "TalentMaster_Agent_v1.html",
      "TalentMaster_HeadOfTalent_Dashboard.html",
      "TalentMaster_Kayttajatutkimus.html",
      "TalentMaster_Kayttoonotto_Pilotti.html",
      "TalentMaster_Kortit.html",
      "TalentMaster_Kortti_Demo.html",
      "TalentMaster_Koulutus.html",
      "TalentMaster_Koulutuskokonaisuus_Palloliitto.html",
      "TalentMaster_Kysely_v2.html",
      "TalentMaster_Pelihavainto_Palloliitto.html",
      "TalentMaster_Player_Home.html",
      "TalentMaster_Solo_Koti.html",
      "TalentMaster_Solo_Lupa.html",
      "TalentMaster_Solo_Profiili.html",
      "TalentMaster_SportDirector_v1.html",
      "TalentMaster_TalentID_v1.html",
      "TalentMaster_Testaus.html",
      "TalentMaster_Testaus_v8.html",
      "TalentMaster_UTJ_v1.html",
      "TalentMaster_UserResearch_EN.html",
      "TalentMaster_VP_v22.html",
      "TalentMaster_Vaihe1_Roolimatriisi.html",
      "TalentMaster_Vaihe2_Flow.html",
      "TalentMaster_Valmentaja_Matriisi.html",
      "TalentMaster_Valmentajakortti.html",
      "firebase.json",
      "firestore.indexes.json",
      "package*.json"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), geolocation=()"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://apis.google.com https://www.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://browser.sentry-cdn.com; connect-src 'self' https://*.googleapis.com https://firestore.googleapis.com https://*.firebaseio.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.cloudfunctions.net https://*.ingest.de.sentry.io https://raw.githubusercontent.com https://terokoskela7-cmyk.github.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; frame-src https://*.firebaseapp.com https://talentmaster-pilot.firebaseapp.com; worker-src 'self'; object-src 'none'; base-uri 'self'"
          }
        ]
      },
      {
        "source": "/sw_*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
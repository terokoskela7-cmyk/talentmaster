# TalentMaster Cloud Functions — ympäristömuuttujat (MALLI)
# Kopioi tämä tiedostoksi functions/.env ja täytä arvot. functions/.env EI kuulu versionhallintaan (.gitignore).
#
# SALAISET avaimet (SENDGRID_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY) EIVÄT tule tänne —
# ne ovat Firebase Secret Managerissa ja bindataan runWith({secrets:[...]}) → process.env ajonaikaisesti.
# Ks. CLAUDE.md §13.

# SendGrid-lähettäjäosoite (EI salainen → tavallinen env-var)
SENDGRID_FROM_EMAIL=noreply@talentmasterid.com

# Valmennusapuri — mallireitti (EI salainen). Vaihtoehdot: vertex | bedrock | anthropic
#   vertex    = Vertex AI EU (oletus; odottaa EU-kiintiötä)
#   bedrock   = AWS Bedrock EU (Plan B). Avaimet Secret Managerissa: AWS_BEDROCK_ACCESS_KEY_ID + AWS_BEDROCK_SECRET_ACCESS_KEY
#   anthropic = suora API, VAIN kehitys/synteettinen data (ei EU-residenssiä)
# VALMENNUSAPURI_PROVIDER=bedrock
# VALMENNUSAPURI_MALLI=eu.anthropic.claude-sonnet-4-6     # bedrock: vain eu.-profiili (koodi estää global./us.)
# VALMENNUSAPURI_ALUE=eu-north-1                          # bedrock: AWS-alue eu-*; vertex: eu

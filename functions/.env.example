# TalentMaster Cloud Functions — ympäristömuuttujat (MALLI)
# Kopioi tämä tiedostoksi functions/.env ja täytä arvot. functions/.env EI kuulu versionhallintaan (.gitignore).
#
# SALAISET avaimet (SENDGRID_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY) EIVÄT tule tänne —
# ne ovat Firebase Secret Managerissa ja bindataan runWith({secrets:[...]}) → process.env ajonaikaisesti.
# Ks. CLAUDE.md §13.

# ⚠ CI-DEPLOY (deploy-functions.yml) EI LUE TÄTÄ TIEDOSTOA eikä functions/.env:iä. Jokaisella ei-salaisella
#   asetuksella on oltava OLETUSARVO KOODISSA (process.env.X || 'oletus'); tämä tiedosto vain ohittaa sen
#   paikallisessa deployssa. Salaiset avaimet eivät koskaan saa oletusarvoa.
#
# SendGrid-lähettäjäosoite (EI salainen; oletus koodissa: noreply@talentmasterid.com)
SENDGRID_FROM_EMAIL=noreply@talentmasterid.com

# Valmennusapuri — mallireitti (EI salainen). Vaihtoehdot: vertex | bedrock | anthropic
#   bedrock   = AWS Bedrock EU (OLETUS 28.9.2026, myös CI-deployssa).
#   vertex    = Vertex AI EU (odottaa EU-kiintiötä). Avaimet Secret Managerissa: AWS_BEDROCK_ACCESS_KEY_ID + AWS_BEDROCK_SECRET_ACCESS_KEY
#   anthropic = suora API, VAIN kehitys/synteettinen data (ei EU-residenssiä)
# VALMENNUSAPURI_PROVIDER=bedrock
# VALMENNUSAPURI_MALLI=eu.anthropic.claude-sonnet-4-6     # bedrock: vain eu.-profiili (koodi estää global./us.)
# VALMENNUSAPURI_ALUE=eu-north-1                          # bedrock: AWS-alue eu-*; vertex: eu

# Valmennusapuri — K1 kustannus (29.10.2026). EI salaisia. KAIKKI liput oletuksena pois; päälle vain
# laatuportin (aja_testit.mjs A–D) jälkeen, yksi kerrallaan: OSIOHAKU → VM_YDIN → REITITYS.
# VALMENNUSAPURI_OSIOHAKU=1                # K1b: ydin + kysymykseen osuvat osiot (korvaa aihejaon)
# VALMENNUSAPURI_OSIOBUDJETTI_VA=60000     # merkkiä, ydin mukaan lukien
# VALMENNUSAPURI_OSIOBUDJETTI_HP=120000
# VALMENNUSAPURI_VM_YDIN=1                 # K1c: välimuisti vain [ohjeistus + ydin] (vaatii OSIOHAKU=1)
# VALMENNUSAPURI_VM_TTL=1h                 # K1c: oletus 5m; Bedrock tukee 1h:ta Sonnet 4.6:lle ja Haiku 4.5:lle
# VALMENNUSAPURI_KEVYT_MALLI=eu.anthropic.claude-haiku-4-5-20251001-v1:0   # K1d: vain eu.-profiili (EU-vartija)
# VALMENNUSAPURI_REITITYS=1                # K1d: VA + osiohaun osumat → kevyt malli; HP aina perusmalli
# VALMENNUSAPURI_SEURABUDJETTI=1           # K1e: kuukausilaskuri + pysäytys 100 %:ssa (SA ei kuluta)
# VALMENNUSAPURI_SEURABUDJETTI_USD=30      # oletusraja; seurakohtainen: valmennusapuri_seurat/{seuraId}.budjettiUsd
# Hinta-arvio lokiin ($/M tokenia; oletukset koodissa). Kevyelle mallille samat _KEVYT_-etuliitteellä.
# VALMENNUSAPURI_HINTA_SYOTE=3
# VALMENNUSAPURI_HINTA_TUOTOS=15
# VALMENNUSAPURI_HINTA_VM_KIRJ=3.75
# VALMENNUSAPURI_HINTA_VM_KIRJ_1H=6
# VALMENNUSAPURI_HINTA_VM_LUKU=0.30
# VALMENNUSAPURI_HINTA_KEVYT_SYOTE=1
# VALMENNUSAPURI_HINTA_KEVYT_TUOTOS=5
# VALMENNUSAPURI_HINTA_KEVYT_VM_KIRJ=1.25
# VALMENNUSAPURI_HINTA_KEVYT_VM_KIRJ_1H=2
# VALMENNUSAPURI_HINTA_KEVYT_VM_LUKU=0.10

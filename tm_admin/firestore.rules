rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // APUFUNKTIOT
    // ─────────────────────────────────────────────────────────────────────

    function onKirjautunut() {
      return request.auth != null;
    }

    // Super-admin: admins/{uid} dokumentti olemassa
    function onSuperAdmin() {
      return onKirjautunut() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // VP vp_uid-kentän kautta — ei vaadi kayttajat-alikokoelmaa
    // KRIITTINEN FIX: vanha Rules vaati kayttajat-dokumenttia jota VP:llä ei ole
    function onSeuranVP(seuraId) {
      return onKirjautunut() &&
        get(/databases/$(database)/documents/seurat/$(seuraId)).data.vp_uid
          == request.auth.uid;
    }

    // Kayttajat-alikokoelmassa oleva henkilö (valmentajat, sihteerit jne.)
    function onSeuranKayttaja(seuraId) {
      return onKirjautunut() &&
        exists(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid));
    }

    // Valmentaja tai vastaava rooli
    function onSeuranValmentaja(seuraId) {
      return onKirjautunut() &&
        exists(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.rooli
          in ['valmentaja','talenttivalmentaja','fysiikkavalmentaja',
              'testivastaava','fysioterapeutti','vp','seurasihteeri',
              'urheilutoimenjohtaja'];
    }

    // Ylläpito: super-admin TAI VP TAI ylläpitorooli
    function onSeuranYllApito(seuraId) {
      return onSuperAdmin()
        || onSeuranVP(seuraId)
        || (onSeuranKayttaja(seuraId) &&
            get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.rooli
              in ['vp','urheilutoimenjohtaja','seurasihteeri']);
    }

    // Pääsy seuraan yleisesti
    function onPaasySeuraan(seuraId) {
      return onSuperAdmin() || onSeuranVP(seuraId) || onSeuranKayttaja(seuraId);
    }

    // ─────────────────────────────────────────────────────────────────────
    // ADMINS
    // ─────────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if onKirjautunut() && request.auth.uid == uid;
      allow write: if onSuperAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────
    // SEURAT
    // FIX: onPaasySeuraan() sisältää nyt onSeuranVP() joten VP pääsee
    //      lukemaan seuradokumentin ilman kayttajat-alikokoelmaa
    // ─────────────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read:  if onPaasySeuraan(seuraId);
      allow write: if onSeuranYllApito(seuraId);

      // ── JOUKKUEET ──────────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read:  if onPaasySeuraan(seuraId);
        allow write: if onSeuranYllApito(seuraId);

        match /kartoitukset/{kartoitusId} {
          allow read:  if onPaasySeuraan(seuraId);
          allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
        }

        match /pelaajat/{pelaajaId} {
          allow read:  if onPaasySeuraan(seuraId);
          allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
        }

        match /paivan_tehtava/{pvmId} {
          allow read:  if onKirjautunut();
          allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
        }
      }

      // ── PELAAJAT ───────────────────────────────────────────────────────
      match /pelaajat/{pelaajaId} {
        allow read: if onSuperAdmin()
          || onPaasySeuraan(seuraId)
          || (onKirjautunut() && request.auth.uid == pelaajaId)
          || (onKirjautunut() && resource.data.huoltajaEmail == request.auth.token.email);

        allow create: if onSuperAdmin()
          || onSeuranValmentaja(seuraId)
          || onKirjautunut();

       allow update: if onSuperAdmin() || onSeuranValmentaja(seuraId)
              || (onKirjautunut() && request.auth.uid == pelaajaId)
              || (onKirjautunut() && resource.data.huoltajaEmail == request.auth.token.email)
              || (resource.data.suostumusTila == 'odottaa'
                  && request.resource.data.suostumusTila == 'annettu');

        allow delete: if onSeuranYllApito(seuraId);

        match /tehtava_kuitattu/{pvmId} {
          allow read:  if onSuperAdmin()
            || onPaasySeuraan(seuraId)
            || (onKirjautunut() && request.auth.uid == pelaajaId);
          allow write: if onSuperAdmin()
            || (onKirjautunut() && request.auth.uid == pelaajaId);
        }

        match /idp/{idpId} {
          allow read: if onSuperAdmin()
            || onPaasySeuraan(seuraId)
            || (onKirjautunut() && request.auth.uid == pelaajaId)
            || (onKirjautunut() &&
                get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.huoltajaEmail
                  == request.auth.token.email);
          allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
        }
      }

      // ── KÄYTTÄJÄT (henkilöstö) ─────────────────────────────────────────
      match /kayttajat/{kayttajaId} {
        allow read: if onSuperAdmin()
          || onSeuranYllApito(seuraId)
          || (onKirjautunut() && request.auth.uid == kayttajaId);
        allow write: if onSuperAdmin() || onSeuranYllApito(seuraId);
      }

      // ── TAPAHTUMAT ─────────────────────────────────────────────────────
      match /tapahtumat/{tapahtumaId} {
        allow read:   if onPaasySeuraan(seuraId) || onKirjautunut();
        allow create: if onSuperAdmin() || onSeuranValmentaja(seuraId) || onSeuranVP(seuraId);
        allow update: if onSuperAdmin() || onSeuranValmentaja(seuraId) || onSeuranVP(seuraId);
        allow delete: if onSeuranYllApito(seuraId);

        match /pelaajat/{pelaajaId} {
          allow read:  if onPaasySeuraan(seuraId);
          allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
        }
      }

      // ── KUTSUT ─────────────────────────────────────────────────────────
      match /kutsut/{kutsuId} {
        allow read:   if onSuperAdmin() || onSeuranYllApito(seuraId) || onKirjautunut();
        allow create: if onKirjautunut();
        allow update: if onSuperAdmin() || onSeuranYllApito(seuraId) || onKirjautunut();
        allow delete: if onSeuranYllApito(seuraId);
      }

      // ── KRITEERIT ──────────────────────────────────────────────────────
      match /kriteerit/{kriteeriId} {
        allow read:  if onPaasySeuraan(seuraId);
        allow write: if onSeuranYllApito(seuraId);
      }

      // ── KAUSIRAKENNE ───────────────────────────────────────────────────
      match /kausirakenne/{eventId} {
        allow read:  if onPaasySeuraan(seuraId);
        allow write: if onSeuranYllApito(seuraId);
      }

      // ── MENTOROINNIT ───────────────────────────────────────────────────
      match /mentoroinnit/{mentorointiId} {
        allow read:  if onSuperAdmin() || onSeuranYllApito(seuraId);
        allow write: if onSuperAdmin() || onSeuranYllApito(seuraId);
      }

      // ── HYVINVOINTI ────────────────────────────────────────────────────
      match /hyvinvointi/{hvId} {
        allow read:  if onSuperAdmin() || onSeuranYllApito(seuraId);
        allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
      }

      // ── KIRJAUKSET (seuran sisäiset harjoituskirjaukset) ───────────────
      match /kirjaukset/{kirjausId} {
        allow read:  if onPaasySeuraan(seuraId);
        allow write: if onSuperAdmin() || onSeuranValmentaja(seuraId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────
    // COLLECTIONGROUP: kayttajat
    // FIX: ilman tätä collectionGroup('kayttajat').where('uid','==',uid)
    //      heittää permission-denied — tämä sääntö puuttui kokonaan
    // ─────────────────────────────────────────────────────────────────────
    match /{path=**}/kayttajat/{kayttajaId} {
      allow read: if onSuperAdmin()
        || (onKirjautunut() && request.auth.uid == kayttajaId)
        || (onKirjautunut() && resource.data.uid == request.auth.uid);
    }

    // ─────────────────────────────────────────────────────────────────────
    // AUDIT
    // ─────────────────────────────────────────────────────────────────────
    match /audit/{auditId} {
      allow read:  if onSuperAdmin();
      allow write: if onKirjautunut();
    }

    // ─────────────────────────────────────────────────────────────────────
    // VANHAT KOKOELMAT (yhteensopivuus)
    // ─────────────────────────────────────────────────────────────────────
    match /kirjaukset/{kirjausId} {
      allow read:  if onKirjautunut();
      allow write: if onKirjautunut();
    }

    match /kirjaukset_joukkue/{id} {
      allow read:  if onKirjautunut();
      allow write: if onKirjautunut();
    }

    match /kirjaukset_tapahtumat/{id} {
      allow read:  if onKirjautunut();
      allow write: if onKirjautunut();
    }

  }
}

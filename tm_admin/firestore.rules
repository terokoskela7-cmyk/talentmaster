rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════
// TalentMaster™ — firestore.rules v2.8
//
// Lähde:  tm_admin/firestore.rules
// Deploy: Firebase Console → Firestore → Rules → liitä → Julkaise
//         (EI GitHub Actionsilla — saa 403, CLAUDE.md §17 #10)
//
// Muutokset v2.7 → v2.8 (Bio-ikä — PHV/Mirwald):
//   + seurat/{sid}/pelaajat/{pid}/biologinen_ika/{mittausPvm} — Testaus_v9:n
//     kasvumittaus-protokolla kirjoittaa PHV-mittaushistorian tänne.
//     VP-pikakentät (phv_tila, biologinenIka_viimeisin) menevät suoraan
//     pelaajadokumenttiin (pelaajat-update sallii valmentajan jo ennestään).
//     Vanhempien pituudet (isa_pituus_cm/aiti_pituus_cm) tallennetaan
//     rekisteröinnissä pelaajadokumenttiin — ei vaadi uutta blokkia.
//
// Muutokset v2.6 → v2.7 (Testaus_v8 kalenterikopio):
//   + seurat/{sid}/joukkueet/{jid}/kalenteri/{kid} — alikokoelma jonka
//     Testaus_v8._tallennaTapahtuma kirjoittaa testitapahtuman luonnin
//     yhteydessä (pikaviittaus joukkueen kalenteriin). Aiemmin puuttuva
//     match-blokki aiheutti "Missing or insufficient permissions"-virheen
//     vaikka pää-testitapahtuma tallentui onnistuneesti.
//     CLAUDE.md §17 #18 — Rules eivät periydy alikokoelmiin automaattisesti.
//
// Muutokset v2.5 → v2.6 (Sprint 3.1 — Historiapohja-tuonti):
//   + seurat/{sid}/pelaajat/{pid}/testitulokset/{pvm}_{protokolla} —
//     Excel_Tuonti.html:n historiapohja-moodin kirjoituspolku. Tukee
//     vanhan testidatan tuontia ilman testitapahtumaa.
//     read:  SA | omaSeura (johto|valmentaja) | anonymous (PIN) | huoltaja
//     write: SA | omaSeura (johto)
//
// Muutokset v2.4 → v2.5 (Sprint 3):
//   * idp_jono — tila-arvo 'odottaa' tuettu rinnakkain 'ehdotettu'-arvon
//     kanssa (uusi standardi). Valmentaja saa muokata omaa ehdotustaan
//     niin kauan kuin tila in ['ehdotettu','odottaa'].
//   + meta/{key} — VP:n metadatakanava (esim. phv_snapshot Sprint 3
//     signaaleille — VP/UTJ/seurasihteeri kirjoittaa, koko seura lukee).
//
// Muutokset v2.3 → v2.4 (Sprint 2):
//   + seurat/{sid}/pelaajat/{pid}/vp_muistiinpanot/{mid} — VP:n muistiinpanot
//     pelaajalle, näkyvyys-flageilla naytaValmentajalle / naytaPelaajalle
//
// Muutokset v2.1.0 → v2.3:
//   + onLapsenHuoltaja(seuraId, pelaajaId) — vanhempi tunnistetaan
//     huoltajaEmail-kentän kautta (case-insensitive vertailu)
//   + Vanhemman luku lisätty: pelaajat, havainnot, kirjaukset, idp,
//     testitapahtumat/tulokset
//   + kehut/{kehuId} — vanhempi luo, pelaaja lukee + kuittaa nahty-kentän
//   + testitapahtumat/{id} + tulokset/{pelaajaId}  (CLAUDE.md §17 #19, §23)
//   + idp_jono/{id}
//   + valmentajat/{uid} + kontribuutio + tuloskortti
//   + viestit/{viestiId}
//
// Säilyy v2.1.0:sta:
//   • Anonyymi (PIN) saa lukea seurat/{id}/pelaajat + havainnot
//   • Super admin: rooli=='super_admin' TAI admins/{uid} exists
//   • Legacy claim 'superadmin' tuettu rinnakkain (CLAUDE.md §24)
//   • Pelaajatason kayttajat-alikokoelma VP:lle (Henkilöstö-näkymä)
//   • Jokainen alikokoelma omalla match-blokilla (§17 #18 — ei periydy)
// ══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // APUFUNKTIOT
    // ──────────────────────────────────────────────────────────────────────
    function onKirjautunut() {
      return request.auth != null;
    }

    function onSuperAdmin() {
      return request.auth.token.rooli == 'super_admin'
          || request.auth.token.rooli == 'superadmin'   // legacy (CLAUDE.md §24)
          || request.auth.token.super_admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onOmaSeura(seuraId) {
      return request.auth.token.seuraId == seuraId;
    }

    function onAnonymous() {
      // Anonymous Auth — pelaajan PIN-kirjautuminen Pelaaja-näkymässä
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function onValmentajaRooli() {
      return request.auth.token.rooli in [
        'valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja',
        'vp', 'urheilutoimenjohtaja', 'seurasihteeri', 'testivastaava'
      ];
    }

    function onJohtoRooli() {
      return request.auth.token.rooli in [
        'vp', 'urheilutoimenjohtaja', 'seurasihteeri'
      ];
    }

    function onOmanSeuranValmentaja(seuraId) {
      return onOmaSeura(seuraId) && onValmentajaRooli();
    }

    // v2.3 — pelaajan dokumentti getterillä (Firestore välimuistittaa)
    function pelaajaData(seuraId, pelaajaId) {
      return get(
        /databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)
      ).data;
    }

    // v2.3 — Huoltaja-tunnistus pelaajadokumentin huoltajaEmail-kentästä.
    // Vertailu lowercased — pelaajaa luotaessa huoltajaEmail voi olla
    // sekamuotoinen (esim. "TeroKoskela7@gmail.com"), mutta Firebase Auth
    // normalisoi tokenin emailin lowercased-muotoon.
    function onLapsenHuoltaja(seuraId, pelaajaId) {
      return onKirjautunut()
          && request.auth.token.email is string
          && pelaajaData(seuraId, pelaajaId).huoltajaEmail is string
          && request.auth.token.email.lower()
             == pelaajaData(seuraId, pelaajaId).huoltajaEmail.lower();
    }

    // ──────────────────────────────────────────────────────────────────────
    // ADMINS — super admin -taulukko
    // ──────────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if onKirjautunut();
      allow write: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // SEURAT — pääkokoelma + kaikki alikokoelmat
    // ──────────────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
      allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

      // ── PELAAJAT ────────────────────────────────────────────────────────
      // read: super admin | oma seura | anonyymi PIN | huoltaja (v2.3)
      // Anonyymi PIN -lukuoikeus on pakollinen: Pelaaja-näkymä hakee oman
      // pelaajadokumentin PIN-koodin validoimiseksi ennen kuin tietää uid:n.
      match /pelaajat/{pelaajaId} {
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId))
                      || onAnonymous()
                      || (onKirjautunut()
                          && request.auth.token.email is string
                          && resource.data.huoltajaEmail is string
                          && request.auth.token.email.lower()
                             == resource.data.huoltajaEmail.lower());
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── Havainnot — pelaajan henkilökohtaiset ADAR-kortit ─────────────
        // read: + anonyymi PIN (Pelaaja-näkymä) + huoltaja (v2.3)
        // update: + anonyymi PIN, jotta pelaaja_lukenut-merkintä toimii (§13 P6)
        match /havainnot/{havaintoId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous();
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Päivittäiset kirjaukset (T/D/S/P) ─────────────────────────────
        match /kirjaukset/{pvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()   // pelaaja kirjaa itse PIN-tilassa
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId);
          allow update: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId);
        }

        // ── Tapahtumat (LEGACY — käytä mieluummin testitapahtumat) ────────
        match /tapahtumat/{tapahtumaId} {
          allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
          allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        }

        // ── IDP (kausikohtainen kehityssuunnitelma) ───────────────────────
        match /idp/{idpId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── VP-muistiinpanot per pelaajalle (v2.4) ────────────────────────
        // VP tekee muistiinpanon pelaajasta. Näkyvyys flaggeilla:
        // naytaValmentajalle: valmentaja-roolit saavat lukea
        // naytaPelaajalle:    anonyymi PIN-pelaaja saa lukea
        // Default: vain VP/UTJ/seurasihteeri näkevät.
        match /vp_muistiinpanot/{muistiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (resource.data.naytaValmentajalle == true
                            && onOmanSeuranValmentaja(seuraId))
                        || (resource.data.naytaPelaajalle == true
                            && onAnonymous());
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── Testitulokset (v2.6) — historiapohja-tuonti ──────────────────
        // Excel_Tuonti.html:n historia-moodi kirjoittaa tänne. Doc-ID on
        // muotoa {pvm}_{protokolla} (esim. "2026-05-13_tekniikkakilpailu")
        // jotta sama pelaaja samana päivänä eri protokollalla ei ylikirjoita.
        // Pelaaja näkee omat tuloksensa PIN-tilassa; huoltaja näkee lapsensa.
        match /testitulokset/{pvmProto} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── Biologinen ikä (v2.8) — Mirwald PHV -mittaushistoria ──────────
        // Testaus_v9 (kasvumittaus-protokolla) kirjoittaa tänne; doc-ID on
        // mittauspäivä (esim. "2026-05-25"). VP-pikakentät (phv_tila,
        // biologinenIka_viimeisin) kirjoitetaan suoraan pelaajadokumenttiin
        // (pelaajat-update sallii valmentajan, ei hasOnly-rajoitusta).
        // Pelaaja näkee oman PHV-tilansa PIN-tilassa; huoltaja näkee lapsensa.
        // Firestore EI periydy alikokoelmiin → oma blokki pakollinen (§17 #18).
        match /biologinen_ika/{mittausPvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Kehut — vanhemman lähettämä kehu pelaajalle (v2.3) ────────────
        // Yksityinen vanhempi → pelaaja -kanava. Valmentajalla EI lukuoikeutta:
        // pedagoginen suoja, kehu on perheen sisäinen viestintä.
        // Pelaaja PIN-tilassa (onAnonymous) saa lukea + kuitata 'nahty:true',
        // mutta EI muokata muita kenttiä → diff.affectedKeys.hasOnly([...]).
        match /kehut/{kehuId} {
          allow read:   if onSuperAdmin()
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow update: if onSuperAdmin()
                        || (onAnonymous()
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['nahty', 'nahtyKlo']));
          allow delete: if onSuperAdmin();
        }
      }

      // ── KAYTTAJAT (seuran henkilöstö — Henkilöstö-näkymä) ─────────────
      match /kayttajat/{uid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || request.auth.uid == uid;
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || request.auth.uid == uid;
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── HAVAINNOT (seurataso — pelaajatasolle ks. pelaajat/{id}/havainnot) ──
      match /havainnot/{havaintoId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── JOUKKUEET ──────────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── kalenteri/{kalenteriId} (v2.7) ────────────────────────────────
        // Testaus_v8._tallennaTapahtuma kirjoittaa tänne pikaviittauksen
        // luodusta testitapahtumasta (tyyppi:'testi', ref, pvm, nimi…).
        // Sallittu valmentaja-rooleille kaikkien seuran sisällä.
        match /kalenteri/{kalenteriId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KUTSUT ────────────────────────────────────────────────────────
      match /kutsut/{kutsuId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || resource.data.tila == 'odottaa';
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── ADAR (seurataso — peliäly-arvioinnit) ──────────────────────────
      match /adar/{adarId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
      }

      // ── MENTOROINNIT ───────────────────────────────────────────────────
      match /mentoroinnit/{mentorointiId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin()
                     || (onOmaSeura(seuraId)
                         && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
      }

      // ── ERRORS (seurataso) ─────────────────────────────────────────────
      match /errors/{errorId} {
        allow read:           if onSuperAdmin();
        allow create:         if onKirjautunut() && onOmaSeura(seuraId);
        allow update, delete: if onSuperAdmin();
      }

      // ══════════════════════════════════════════════════════════════════
      // v2.3 — UUDET ALIKOKOELMAT
      // ══════════════════════════════════════════════════════════════════

      // ── TESTITAPAHTUMAT (CLAUDE.md §17 #19, §23) ──────────────────────
      // Korvaa vanhentuneen pelaajat/{id}/testit-rakenteen.
      // Kirjoittajat: Testaus_v8, Harjoitettavuus_Lomake_v4, Excel_Tuonti
      match /testitapahtumat/{tapahtumaId} {
        allow read:   if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // tulokset/{pelaajaId} — pelaajakohtaiset testitulokset.
        // Huoltaja näkee oman lapsen tulokset (IDP_Kortti_v4 lukee tätä).
        match /tulokset/{pelaajaId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── IDP_JONO — IDP-aktivointiehdotusten jono ──────────────────────
      // Valmentaja ehdottaa IDP:tä → VP/UTJ hyväksyy. Valmentaja saa
      // muokata omaa ehdotustaan niin kauan kuin tila on 'ehdotettu' tai
      // 'odottaa' (v2.5 — uusi standardi käyttöön rinnakkain vanhan kanssa).
      match /idp_jono/{idpId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.tila in ['ehdotettu', 'odottaa']
                          && resource.data.valmentajaUid == request.auth.uid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── META — VP:n metadatakanava (Sprint 3) ─────────────────────────
      // Esim. phv_snapshot — kasvuvaiheessa olevien pelaajien lukumäärä
      // viime laskennalta, jotta renderSignals voi tunnistaa kasvun.
      // Koko seura lukee (signaali näkyy myös valmentajalle), VP/UTJ
      // /seurasihteeri kirjoittaa.
      match /meta/{metaKey} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── VALMENTAJAT — valmentajan oma datatila (CLAUDE.md §10) ────────
      match /valmentajat/{valmentajaUid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // valmentajat/{uid}/kontribuutio/{palloID} — pelaajakohtainen vaikutus
        match /kontribuutio/{palloID} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // valmentajat/{uid}/tuloskortti/{tuloskorttiId} — VP arvioi valmentajaa
        match /tuloskortti/{tuloskorttiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── VIESTIT — seuran sisäiset viestit ─────────────────────────────
      // Lähettäjä + vastaanottaja näkevät. Vastaanottaja saa muokata
      // (luku-merkintä). Vain super admin saa poistaa (audit-jälki).
      match /viestit/{viestiId} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && (request.auth.uid == resource.data.vastaanottajaUid
                              || request.auth.uid == resource.data.lahettajaUid
                              || onJohtoRooli()));
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && onKirjautunut()
                          && request.resource.data.lahettajaUid == request.auth.uid);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && request.auth.uid == resource.data.vastaanottajaUid);
        allow delete: if onSuperAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // KÄYTTÄJÄT — ylätason profiilit
    // ──────────────────────────────────────────────────────────────────────
    match /kayttajat/{uid} {
      allow read:  if onSuperAdmin() || request.auth.uid == uid;
      allow write: if onSuperAdmin() || request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // SUOSTUMUKSET — ylätaso (Rekisterointi_Suostumus.html kirjoittaa)
    // ──────────────────────────────────────────────────────────────────────
    match /suostumukset/{suostumusId} {
      allow read:   if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow create: if true;  // suostumuslomake on julkinen
      allow update: if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow delete: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // ERRORS — ylätason virheloki
    // ──────────────────────────────────────────────────────────────────────
    match /errors/{errorId} {
      allow read:           if onSuperAdmin();
      allow create:         if onKirjautunut();
      allow update, delete: if onSuperAdmin();
    }
  }
}

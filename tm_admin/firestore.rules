rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════
// TalentMaster™ — firestore.rules v3.4
//
// Lähde:  tm_admin/firestore.rules
// Deploy: Firebase Console → Firestore → Rules → liitä → Julkaise
//         (EI GitHub Actionsilla — saa 403, CLAUDE.md §17 #10)
//
// Muutokset v3.3 → v3.4 (kalenteri-kokoelma):
//   + seurat/{sid}/kalenteri/{tapahtumaId} — seuran pääkalenteri (KALENTERI_ARKKITEHTUURI.md §3).
//     VP/johto: full CRUD. Valmentaja: create + field-level update (muistiinpanot, tila, soft-delete).
//     Ei hard-deletea (audit-jälki, soft-delete update-kautta).
//   + seurat/{sid}/kalenteri/{tapahtumaId}/lasnaolijat/{uid} — läsnäolovahvistukset.
//     Osallistuja saa päivittää oman läsnäolonsa.
//
// Muutokset v3.2 → v3.3 (kirjaus-permissionit, PÄÄTÖS 1+2):
//   + kirjaukset: VP + talenttivalmentaja (oma seura) eksplisiittinen kirjoitusoikeus.
//   + onU12Huoltaja() — huoltaja saa kirjata alle 13v -lapselle kun lahde=='vanhempi'.
//     Kaikissa kirjauksissa pakollinen lahde-kenttä (valmentaja|pelaaja|vanhempi|vp|talenttivalmentaja).
//
// Muutokset v3.1 → v3.2 (universaali testi-arkkitehtuuri):
//   + seurat/{sid}/konfiguraatio/{konfId} — seuran normijärjestelmä (maa/kieli).
//     Ladataan tuonti/analyysihetkellä; mahdollistaa kv-normit (DFB/KNVB) tulevaisuudessa.
//
// Muutokset v3.0 → v3.1 (VP_v25 Sprint A):
//   + seurat/{sid}/toimenpiteet/{tid} —
//     TalentMasterin automaattiset ehdotukset +
//     VP:n kuittaus/muokkaus/hylkäys.
//     Ei delete: audit-jälki säilyy aina.
//
// Muutokset v2.9 → v3.0 (Master_v16 — TKI-palaute + harjoitusprioriteetti):
//   + seurat/{sid}/pelaajat/{pid}/palautteet/{pvm}_tki — valmentajan TKI-palaute
//     pelaajalle. nakyvyys-flag ('pelaaja'|'vain_valmentaja') gateaa pelaajan luvun.
//   + seurat/{sid}/joukkueet/{jid}/harjoitusprioriteetti/{id} — joukkueen
//     harjoitusprioriteetti testidatasta (doc 'aktiivinen'); koko seura lukee.
//   Firestore EI periydy alikokoelmiin → omat blokit pakolliset (§17 #18).
//
// Muutokset v2.8 → v2.9 (VP kalenteri):
//   + seurat/{sid}/tapahtumat/{id} — SEURATASON yleistapahtumat +
//     VP_v22:n mentorointi-pikamalli (tyyppi:'mentorointi'/'kokous').
//     Ilman tätä mentoroinnin tallennus + viikkonäkymän luku kaatuvat.
//     HUOM: eri kuin pelaajatason legacy /pelaajat/{id}/tapahtumat.
//   + seurat/{sid}/vp_kalenteri/{id} — VP:n deadlinet/muistutukset (amber).
//
// Muutokset v2.7 → v2.8 (Bio-ikä — PHV/Mirwald):
//   + seurat/{sid}/pelaajat/{pid}/biologinen_ika/{mittausPvm} — Testaus_v9:n
//     kasvumittaus-protokolla kirjoittaa PHV-mittaushistorian tänne.
//     VP-pikakentät (phv_tila, biologinenIka_viimeisin) menevät suoraan
//     pelaajadokumenttiin (pelaajat-update sallii valmentajan jo ennestään).
//     Vanhempien pituudet (isa_pituus_cm/aiti_pituus_cm) tallennetaan
//     rekisteröinnissä pelaajadokumenttiin — ei vaadi uutta blokkia.
//
// Muutokset v2.6 → v2.7 (Testaus_v8 kalenterikopio):
//   + seurat/{sid}/joukkueet/{jid}/kalenteri/{kid} — alikokoelma jonka
//     Testaus_v8._tallennaTapahtuma kirjoittaa testitapahtuman luonnin
//     yhteydessä (pikaviittaus joukkueen kalenteriin). Aiemmin puuttuva
//     match-blokki aiheutti "Missing or insufficient permissions"-virheen
//     vaikka pää-testitapahtuma tallentui onnistuneesti.
//     CLAUDE.md §17 #18 — Rules eivät periydy alikokoelmiin automaattisesti.
//
// Muutokset v2.5 → v2.6 (Sprint 3.1 — Historiapohja-tuonti):
//   + seurat/{sid}/pelaajat/{pid}/testitulokset/{pvm}_{protokolla} —
//     Excel_Tuonti.html:n historiapohja-moodin kirjoituspolku. Tukee
//     vanhan testidatan tuontia ilman testitapahtumaa.
//     read:  SA | omaSeura (johto|valmentaja) | anonymous (PIN) | huoltaja
//     write: SA | omaSeura (johto)
//
// Muutokset v2.4 → v2.5 (Sprint 3):
//   * idp_jono — tila-arvo 'odottaa' tuettu rinnakkain 'ehdotettu'-arvon
//     kanssa (uusi standardi). Valmentaja saa muokata omaa ehdotustaan
//     niin kauan kuin tila in ['ehdotettu','odottaa'].
//   + meta/{key} — VP:n metadatakanava (esim. phv_snapshot Sprint 3
//     signaaleille — VP/UTJ/seurasihteeri kirjoittaa, koko seura lukee).
//
// Muutokset v2.3 → v2.4 (Sprint 2):
//   + seurat/{sid}/pelaajat/{pid}/vp_muistiinpanot/{mid} — VP:n muistiinpanot
//     pelaajalle, näkyvyys-flageilla naytaValmentajalle / naytaPelaajalle
//
// Muutokset v2.1.0 → v2.3:
//   + onLapsenHuoltaja(seuraId, pelaajaId) — vanhempi tunnistetaan
//     huoltajaEmail-kentän kautta (case-insensitive vertailu)
//   + Vanhemman luku lisätty: pelaajat, havainnot, kirjaukset, idp,
//     testitapahtumat/tulokset
//   + kehut/{kehuId} — vanhempi luo, pelaaja lukee + kuittaa nahty-kentän
//   + testitapahtumat/{id} + tulokset/{pelaajaId}  (CLAUDE.md §17 #19, §23)
//   + idp_jono/{id}
//   + valmentajat/{uid} + kontribuutio + tuloskortti
//   + viestit/{viestiId}
//
// Säilyy v2.1.0:sta:
//   • Anonyymi (PIN) saa lukea seurat/{id}/pelaajat + havainnot
//   • Super admin: rooli=='super_admin' TAI admins/{uid} exists
//   • Legacy claim 'superadmin' tuettu rinnakkain (CLAUDE.md §24)
//   • Pelaajatason kayttajat-alikokoelma VP:lle (Henkilöstö-näkymä)
//   • Jokainen alikokoelma omalla match-blokilla (§17 #18 — ei periydy)
// ══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // APUFUNKTIOT
    // ──────────────────────────────────────────────────────────────────────
    function onKirjautunut() {
      return request.auth != null;
    }

    function onSuperAdmin() {
      return request.auth.token.rooli == 'super_admin'
          || request.auth.token.rooli == 'superadmin'   // legacy (CLAUDE.md §24)
          || request.auth.token.super_admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onOmaSeura(seuraId) {
      return request.auth.token.seuraId == seuraId;
    }

    function onAnonymous() {
      // Anonymous Auth — pelaajan PIN-kirjautuminen Pelaaja-näkymässä
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function onValmentajaRooli() {
      // HUOM: seurasihteeri + testivastaava POISTETTU tästä (2026-06-05) — ne eivät saa
      // broad valmennusdata-kirjoitusta. Rajatut oikeudet onSeuraSihteeri/onTestivastaava-kautta.
      return request.auth.token.rooli in [
        'valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja',
        'vp', 'urheilutoimenjohtaja'
      ];
    }

    function onJohtoRooli() {
      return request.auth.token.rooli in [
        'vp', 'urheilutoimenjohtaja', 'seurasihteeri'
      ];
    }

    // (Seurasihteerin oikeudet hoituvat onJohtoRooli():n kautta — erillinen onSeuraSihteeri
    //  poistettu 2026-06-08 käyttämättömänä; kompilaattori varoitti unused + invalid 'request'.)

    // Testivastaava — kirjoittaa VAIN testitapahtumat + testitulokset, lukee pelaajaprofiilit.
    function onTestivastaava(seuraId) {
      return request.auth.token.rooli == 'testivastaava' && onOmaSeura(seuraId);
    }

    function onOmanSeuranValmentaja(seuraId) {
      return onOmaSeura(seuraId) && onValmentajaRooli();
    }

    // v2.3 — pelaajan dokumentti getterillä (Firestore välimuistittaa)
    function pelaajaData(seuraId, pelaajaId) {
      return get(
        /databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)
      ).data;
    }

    // v2.3 — Huoltaja-tunnistus pelaajadokumentin huoltajaEmail-kentästä.
    // Vertailu lowercased — pelaajaa luotaessa huoltajaEmail voi olla
    // sekamuotoinen (esim. "TeroKoskela7@gmail.com"), mutta Firebase Auth
    // normalisoi tokenin emailin lowercased-muotoon.
    function onLapsenHuoltaja(seuraId, pelaajaId) {
      return onKirjautunut()
          && request.auth.token.email is string
          && pelaajaData(seuraId, pelaajaId).huoltajaEmail is string
          && request.auth.token.email.lower()
             == pelaajaData(seuraId, pelaajaId).huoltajaEmail.lower();
    }

    // v3.3 (PÄÄTÖS 2) — huoltaja saa KIRJATA U12-lapselle (alle 13v) kun lahde=='vanhempi'.
    //   1) sähköposti täsmää huoltajaEmail-kenttään (onLapsenHuoltaja)
    //   2) pelaaja alle 13v: syntymaVuosi >= kuluva vuosi − 12 (sama kuin sovelluksen u12-vaihe)
    //   3) kirjauksen lahde == 'vanhempi'
    //   HUOM: request.time.year() antaa kalenterivuoden (käyttäjän toMillis-kaavasta puuttui
    //   1970-offset → olisi ollut aina tosi).
    function onU12Huoltaja(seuraId, pelaajaId) {
      return onLapsenHuoltaja(seuraId, pelaajaId)
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi is int
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi >= (request.time.year() - 12)
          && request.resource.data.lahde == 'vanhempi';
    }

    // ── A5: aikaleima-kentän eheys (luotu) ────────────────────────────────
    // Estää orderBy/where-näkymättömyyden kahdesta syystä:
    //   • luotu PUUTTUU  → orderBy('luotu') jättää dokumentin kokonaan pois
    //   • luotu ISO-STRING → Firestoren tyyppijärjestys erottaa sen Timestampeista
    //     (timestamp < string) → limit/where-kyselyt eivät näe sitä.
    // create: luotu pakollinen + timestamp.
    // update: jos luotu on muuttuvien kenttien joukossa, sen on oltava timestamp;
    //   muuten ohitus → lukukuittaukset (nahty ym.) ja muut field-level-päivitykset
    //   toimivat eikä luotu-kenttää voi pudottaa overwrite-setillä.
    // ⚠ DEPLOY VASTA kun kirjoittajat korjattu + olemassa oleva data migroitu
    //   (havainnot/kirjaukset). Ks. docs/SKAALAUTUVUUS_JA_TEKNINEN_VELKA.md §A5.
    function luotuLuontiKelpaa() {
      // 'luotu' in ... ENNEN is timestamp -tarkistusta: estää evaluointivirheen
      // ("Property luotu is undefined") kun kenttä puuttuu → siisti false (= hylkää).
      return 'luotu' in request.resource.data
          && request.resource.data.luotu is timestamp;
    }
    function luotuPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['luotu'])
          || ('luotu' in request.resource.data
              && request.resource.data.luotu is timestamp);
    }
    // A5-jälki: sama `aika`-kentälle (mentorointiviestit seurat/{}/viestit) — estää regression
    // (data + VP_v25-writer ovat jo Timestamp; vartija lukitsee).
    function aikaLuontiKelpaa() {
      return 'aika' in request.resource.data
          && request.resource.data.aika is timestamp;
    }
    function aikaPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aika'])
          || ('aika' in request.resource.data
              && request.resource.data.aika is timestamp);
    }

    // ──────────────────────────────────────────────────────────────────────
    // ADMINS — super admin -taulukko
    // ──────────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if onKirjautunut();
      allow write: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // SEURAT — pääkokoelma + kaikki alikokoelmat
    // ──────────────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
      allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

      // ── TOIMENPITEET — TalentMasterin ehdotukset + VP:n kuittaukset (v3.1) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Ei delete: historia/audit-jälki
      // säilyy aina (tila ehdotus|kuitattu|muokattu|hylatty). VP/SA luo + päivittää.
      match /toimenpiteet/{tid} {
        allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── KONFIGURAATIO (v3.2) — seuran normijärjestelmä (normijarjestelma/maa/kieli) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Luku koko seuralle; kirjoitus VP/SA.
      match /konfiguraatio/{konfId} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }

      // ── HARJOITUSARVIOINNIT (HARJOITUSARVIOINTI_SPEC §9) ──────────────────
      // Kaksimallinen harjoitusarviointi (A Palloliitto-laatu / B valmennustaidot).
      // read: SA | oma seura (valmentaja näkee omat, johto kaikki). create/update: johto + oman seuran valmentaja + SA.
      // delete: vain SA. Pikakentät (harjoituslaatu_/valmennustaito_) kirjoitetaan kayttajat-dokumenttiin (oma blokki alla).
      match /harjoitusarvioinnit/{arvioId} {
        allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
        allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId);
        allow delete:         if onSuperAdmin();

        // ── Palautekerros (Vaihe 2.1, HARJOITUSARVIOINTI_VAIHE2_SPEC §5) — kaksi ERI alikokoelmaa,
        // koska Firestore-luku on dokumenttitasolla (kenttää ei voi piilottaa lukijalta). Rules eivät periydy → omat blokit.
        // JAETTU = näkyy valmentajalle (oma seura). YKSITYINEN = vain johto/SA (valmentaja EI saa lukea).
        match /palaute_jaettu/{palauteId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == request.resource.data.tekija_uid;
          allow update: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == resource.data.tekija_uid;
          allow delete: if onSuperAdmin();
        }
        match /palaute_yksityinen/{palauteId} {
          allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());   // KRIITTINEN: valmentaja ei saa lukea
          allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }
      }

      // ── PELAAJAT ────────────────────────────────────────────────────────
      // read: super admin | oma seura | anonyymi PIN | huoltaja (v2.3)
      // Anonyymi PIN -lukuoikeus on pakollinen: Pelaaja-näkymä hakee oman
      // pelaajadokumentin PIN-koodin validoimiseksi ennen kuin tietää uid:n.
      match /pelaajat/{pelaajaId} {
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId))
                      || onAnonymous()
                      || (onKirjautunut()
                          && request.auth.token.email is string
                          && resource.data.huoltajaEmail is string
                          && request.auth.token.email.lower()
                             == resource.data.huoltajaEmail.lower());
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || onTestivastaava(seuraId)   // testituonnin profiili-pikakentät (hh_taso/hh_viimeisin/mas_kmh)
                      || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                      // PIN-pelaaja (anonyymi) saa päivittää VAIN oman xp/streak-pelillistyksen
                      // (_tallennaKirjaus-batch). Sama luottamusmalli kuin kirjaukset-onAnonymous.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['xp', 'streak', 'streak_paivitetty']))
                      // PIN-pelaaja: D3-psyykkinen itsearvio (§C) — vain d3-pikakentät omaan dokumenttiin.
                      // Valmentajan pisteet[dim].valmentaja säilyvät: client tekee merge nykyisistä (sama
                      // anon-luottamusmalli kuin xp/kirjaukset; nested-validointia rules ei tee).
                      // d3_varmuus = johdettu pikakenttä (D3_KALIBRAATIO_SPEC malli A): pelaaja kirjoittaa
                      // 'itsearvio'/'trianguloitu' lahteet[]:stä → kuuluu sallittuihin avaimiin.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['d3_viimeisin', 'd3_taso', 'd3_pvm', 'd3_varmuus']));
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── Havainnot — pelaajan henkilökohtaiset ADAR-kortit ─────────────
        // read: + anonyymi PIN (Pelaaja-näkymä) + huoltaja (v2.3)
        // update: + anonyymi PIN, jotta pelaaja_lukenut-merkintä toimii (§13 P6)
        match /havainnot/{havaintoId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous())
                        && luotuPaivitysKelpaa();                     // A5
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Reviewit — MDT-tarkistuskirjaukset (MDT_RAPORTTI / review-kadenssi) ──
        // create/update: johto (VP/UTJ/seurasihteeri) + oman seuran valmentaja + SA. delete: vain SA.
        // Pikakentät (review_viimeisin_pvm/-tyyppi) kirjoitetaan pelaaja-dokumenttiin → pelaajat-update-säännön piirissä.
        match /reviewit/{reviewId} {
          allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
          allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId);
          allow delete:         if onSuperAdmin();
        }

        // ── Päivittäiset kirjaukset (T/D/S/P) ─────────────────────────────
        // PÄÄTÖS 1: jokaisessa kirjauksessa lahde-kenttä (valmentaja|pelaaja|vanhempi|vp|talenttivalmentaja).
        // PÄÄTÖS 2: VP + talenttivalmentaja (oma seura) saavat kirjata eksplisiittisesti (sisältyvät jo
        //   onOmanSeuranValmentaja():iin — klausuulit selventävät policy-päätöksen); huoltaja saa kirjata
        //   U12-lapselle kun lahde=='vanhempi' (onU12Huoltaja).
        match /kirjaukset/{pvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()   // pelaaja kirjaa itse PIN-tilassa
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId))
                        && luotuPaivitysKelpaa();                     // A5
        }

        // ── Tapahtumat (LEGACY — käytä mieluummin testitapahtumat) ────────
        match /tapahtumat/{tapahtumaId} {
          allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
          allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        }

        // ── IDP (kausikohtainen kehityssuunnitelma) ───────────────────────
        match /idp/{idpId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── VP-muistiinpanot per pelaajalle (v2.4) ────────────────────────
        // VP tekee muistiinpanon pelaajasta. Näkyvyys flaggeilla:
        // naytaValmentajalle: valmentaja-roolit saavat lukea
        // naytaPelaajalle:    anonyymi PIN-pelaaja saa lukea
        // Default: vain VP/UTJ/seurasihteeri näkevät.
        match /vp_muistiinpanot/{muistiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (resource.data.naytaValmentajalle == true
                            && onOmanSeuranValmentaja(seuraId))
                        || (resource.data.naytaPelaajalle == true
                            && onAnonymous());
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── Testitulokset (v2.6) — historiapohja-tuonti ──────────────────
        // Excel_Tuonti.html:n historia-moodi kirjoittaa tänne. Doc-ID on
        // muotoa {pvm}_{protokolla} (esim. "2026-05-13_tekniikkakilpailu")
        // jotta sama pelaaja samana päivänä eri protokollalla ei ylikirjoita.
        // Pelaaja näkee omat tuloksensa PIN-tilassa; huoltaja näkee lapsensa.
        match /testitulokset/{pvmProto} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          // Kirjoitus: VP/UTJ (johto) + testivastaava. EI seurasihteeri (valmennusdata).
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId);
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Biologinen ikä (v2.8) — Mirwald PHV -mittaushistoria ──────────
        // Testaus_v9 (kasvumittaus-protokolla) kirjoittaa tänne; doc-ID on
        // mittauspäivä (esim. "2026-05-25"). VP-pikakentät (phv_tila,
        // biologinenIka_viimeisin) kirjoitetaan suoraan pelaajadokumenttiin
        // (pelaajat-update sallii valmentajan, ei hasOnly-rajoitusta).
        // Pelaaja näkee oman PHV-tilansa PIN-tilassa; huoltaja näkee lapsensa.
        // Firestore EI periydy alikokoelmiin → oma blokki pakollinen (§17 #18).
        match /biologinen_ika/{mittausPvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Kehut — vanhemman lähettämä kehu pelaajalle (v2.3) ────────────
        // Yksityinen vanhempi → pelaaja -kanava. Valmentajalla EI lukuoikeutta:
        // pedagoginen suoja, kehu on perheen sisäinen viestintä.
        // Pelaaja PIN-tilassa (onAnonymous) saa lukea + kuitata 'nahty:true',
        // mutta EI muokata muita kenttiä → diff.affectedKeys.hasOnly([...]).
        match /kehut/{kehuId} {
          allow read:   if onSuperAdmin()
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onLapsenHuoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || (onAnonymous()
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['nahty', 'nahtyKlo'])))
                        && luotuPaivitysKelpaa();                     // A5
          allow delete: if onSuperAdmin();
        }

        // ── PALAUTTEET (v3.0) — valmentajan TKI-palaute pelaajalle ────────
        // Master_v16 Testit→Tulokset. nakyvyys:'pelaaja' → pelaaja (PIN +
        // huoltaja) näkee; 'vain_valmentaja' → vain seuran henkilöstö.
        // Doc-ID {pvm}_tki. Firestore ei periydy → oma blokki (§17 #18).
        match /palautteet/{palauteId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || (resource.data.nakyvyys == 'pelaaja'
                            && (onAnonymous() || onLapsenHuoltaja(seuraId, pelaajaId)));
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KAYTTAJAT (seuran henkilöstö — Henkilöstö-näkymä) ─────────────
      // Pikakentät (harjoituslaatu_/valmennustaito_, §26) kirjoitetaan tänne: oma UID (itsearvio) tai johto (havainnointi).
      // Ei-SA-päivitys EI saa muuttaa rooli/seuraId-kenttiä (roolinvaihto vain vaihdaKayttajanRooli-CF:n kautta, §13).
      match /kayttajat/{uid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || request.auth.uid == uid;
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin()
                      || (( (onOmaSeura(seuraId) && onJohtoRooli()) || request.auth.uid == uid )
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rooli', 'seuraId']));
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── REFLEKTIOT (Vaihe 2.3b-1) — valmentajan OMA yksityinen kasvupäiväkirja (standalone-merkinnät + ääni).
        // VAIN oma uid + SA. Johto/VP EI lue (eroaa arviointiin sidotusta reflektiosta, joka näkyy harjoitusarvioinnit-dokissa).
        // Rules eivät periydy → oma blokki. Ääni Storagessa (oma Storage-ruleset, polku peilaa tätä).
        match /reflektiot/{reflId} {
          allow read, write: if onSuperAdmin() || request.auth.uid == uid;
        }
      }

      // ── HAVAINNOT (seurataso — pelaajatasolle ks. pelaajat/{id}/havainnot) ──
      match /havainnot/{havaintoId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── JOUKKUEET ──────────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── kalenteri/{kalenteriId} (v2.7) ────────────────────────────────
        // Testaus_v8._tallennaTapahtuma kirjoittaa tänne pikaviittauksen
        // luodusta testitapahtumasta (tyyppi:'testi', ref, pvm, nimi…).
        // Sallittu valmentaja-rooleille kaikkien seuran sisällä.
        match /kalenteri/{kalenteriId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── harjoitusprioriteetti/{id} (v3.0) ─────────────────────────────
        // Master_v16: valmentaja asettaa joukkueen harjoitusprioriteetin
        // testidatasta (doc 'aktiivinen'). Koko seura lukee (Tänään-fokus +
        // mahdollinen Pelaaja-näkymä). Firestore ei periydy → oma blokki.
        match /harjoitusprioriteetti/{prioriteettiId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId) || onAnonymous();
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KUTSUT ────────────────────────────────────────────────────────
      match /kutsut/{kutsuId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || resource.data.tila == 'odottaa';
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── ADAR (seurataso — peliäly-arvioinnit) ──────────────────────────
      match /adar/{adarId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
      }

      // ── MENTOROINNIT ───────────────────────────────────────────────────
      match /mentoroinnit/{mentorointiId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin()
                     || (onOmaSeura(seuraId)
                         && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
      }

      // ── ERRORS (seurataso) ─────────────────────────────────────────────
      match /errors/{errorId} {
        allow read:           if onSuperAdmin();
        allow create:         if onKirjautunut() && onOmaSeura(seuraId);
        allow update, delete: if onSuperAdmin();
      }

      // ══════════════════════════════════════════════════════════════════
      // v2.3 — UUDET ALIKOKOELMAT
      // ══════════════════════════════════════════════════════════════════

      // ── TESTITAPAHTUMAT (CLAUDE.md §17 #19, §23) ──────────────────────
      // Korvaa vanhentuneen pelaajat/{id}/testit-rakenteen.
      // Kirjoittajat: Testaus_v8, Harjoitettavuus_Lomake_v4, Excel_Tuonti
      match /testitapahtumat/{tapahtumaId} {
        allow read:   if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // tulokset/{pelaajaId} — pelaajakohtaiset testitulokset.
        // Huoltaja näkee oman lapsen tulokset (IDP_Kortti_v4 lukee tätä).
        match /tulokset/{pelaajaId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── TAPAHTUMAT (seurataso, v2.9) — yleistapahtumat + mentoroinnit ──
      // VP_v22 mentorointi-pikamalli (tyyppi:'mentorointi') + Master_v16
      // yleistapahtumat (harjoitus/ottelu/kokous). EI sama kuin pelaajatason
      // legacy /pelaajat/{id}/tapahtumat eikä testitapahtumat.
      match /tapahtumat/{tapahtumaId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── VP_KALENTERI (v2.9) — VP:n deadlinet ja muistutukset (amber) ───
      match /vp_kalenteri/{id} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── KALENTERI (v3.4) — seuran pääkalenteri (KALENTERI_ARKKITEHTUURI.md §3) ──
      // Korvaa legacy tapahtumat + vp_kalenteri + joukkueet/{jid}/kalenteri yhdellä
      // kokoelmalla. Kaikki tapahtumatyypit: testi, ottelu, harjoitus, palaveri,
      // mentorointi, kalibraatiopaja, IDP-seuranta, talenttileiri, muu.
      //
      // Soft-delete: poistettu=true, EI oikeaa deletea (audit-jälki).
      // Valmentajan field-level -rajoitus (KIMI K1): vain muistiinpanot + aikaleima.
      match /kalenteri/{tapahtumaId} {
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId));

        // Luonti: VP/johto + valmentajaroolit (oma seura)
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || onOmanSeuranValmentaja(seuraId);

        // Päivitys: VP/johto saa muokata kaikkea.
        // Valmentaja saa muokata VAIN muistiinpanot + paivitetty + muokkaaja_uid
        // (KALENTERI_ARKKITEHTUURI.md §7, KIMI K1).
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['muistiinpanot', 'paivitetty', 'muokkaaja_uid',
                                       'tila', 'poistettu', 'poistettu_uid', 'poistettu_pvm']));

        // Ei hard-deletea — soft-delete (poistettu:true) update-kautta
        allow delete: if onSuperAdmin();

        // ── Läsnäolijat (alikokoelma) ──
        // Pelaaja/valmentajan läsnäolovahvistus per tapahtuma.
        match /lasnaolijat/{osallistujaId} {
          allow read:   if onSuperAdmin()
                        || (onKirjautunut() && onOmaSeura(seuraId));
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == osallistujaId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── IDP_JONO — IDP-aktivointiehdotusten jono ──────────────────────
      // Valmentaja ehdottaa IDP:tä → VP/UTJ hyväksyy. Valmentaja saa
      // muokata omaa ehdotustaan niin kauan kuin tila on 'ehdotettu' tai
      // 'odottaa' (v2.5 — uusi standardi käyttöön rinnakkain vanhan kanssa).
      match /idp_jono/{idpId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.tila in ['ehdotettu', 'odottaa']
                          && resource.data.valmentajaUid == request.auth.uid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── META — VP:n metadatakanava (Sprint 3) ─────────────────────────
      // Esim. phv_snapshot — kasvuvaiheessa olevien pelaajien lukumäärä
      // viime laskennalta, jotta renderSignals voi tunnistaa kasvun.
      // Koko seura lukee (signaali näkyy myös valmentajalle), VP/UTJ
      // /seurasihteeri kirjoittaa.
      match /meta/{metaKey} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── VALMENTAJAT — valmentajan oma datatila (CLAUDE.md §10) ────────
      match /valmentajat/{valmentajaUid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // valmentajat/{uid}/kontribuutio/{palloID} — pelaajakohtainen vaikutus
        match /kontribuutio/{palloID} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // valmentajat/{uid}/tuloskortti/{tuloskorttiId} — VP arvioi valmentajaa
        match /tuloskortti/{tuloskorttiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── VIESTIT — seuran sisäiset viestit ─────────────────────────────
      // Lähettäjä + vastaanottaja näkevät. Vastaanottaja saa muokata
      // (luku-merkintä). Vain super admin saa poistaa (audit-jälki).
      match /viestit/{viestiId} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && (request.auth.uid == resource.data.vastaanottajaUid
                              || request.auth.uid == resource.data.lahettajaUid
                              || onJohtoRooli()));
        allow create: if (onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && onKirjautunut()
                          && request.resource.data.lahettajaUid == request.auth.uid))
                      && aikaLuontiKelpaa();                          // A5-jälki
        allow update: if (onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && request.auth.uid == resource.data.vastaanottajaUid))
                      && aikaPaivitysKelpaa();                        // A5-jälki
        allow delete: if onSuperAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // KÄYTTÄJÄT — ylätason profiilit
    // ──────────────────────────────────────────────────────────────────────
    match /kayttajat/{uid} {
      allow read:  if onSuperAdmin() || request.auth.uid == uid;
      allow write: if onSuperAdmin() || request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // SUOSTUMUKSET — ylätaso (Rekisterointi_Suostumus.html kirjoittaa)
    // ──────────────────────────────────────────────────────────────────────
    match /suostumukset/{suostumusId} {
      allow read:   if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow create: if true;  // suostumuslomake on julkinen
      allow update: if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow delete: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // ERRORS — ylätason virheloki
    // ──────────────────────────────────────────────────────────────────────
    match /errors/{errorId} {
      allow read:           if onSuperAdmin();
      allow create:         if onKirjautunut();
      allow update, delete: if onSuperAdmin();
    }
  }
}

rules_version = '2';
// ══════════════════════════════════════════════════════════════════════════
// TalentMaster™ — firestore.rules v3.18
//
// Lähde:  tm_admin/firestore.rules
// Deploy: PR → N4-CI deployaa automaattisesti (Console-käsityö poistui).
//
// Muutokset v3.17 → v3.18 (TIETOTURVAKORJAUS — kommentin kirjoitusportti vuoti seurarajan yli):
//   ! onStaffKirjoitus() puuttui sulkeet: (onOmaSeura && onValmentajaRooli) || onKaavioHyvaksyja().
//     Jälkimmäinen haara on seuraneutraali roolitesti → MINKÄ TAHANSA seuran vp/UTJ saattoi
//     luoda kommentin toisen seuran kaavion lankaan. Luku oli koko ajan suojattu (onStaffLuku
//     vaatii onOmaSeura), joten kyse oli sokkokirjoituksesta tunnettuun polkuun — ei vuodosta.
//     Korjaus: onSuperAdmin() || (onOmaSeura(seuraId) && (onValmentajaRooli() || onKaavioHyvaksyja())).
//     Regressio lukittu: tests/rules/kaavio.rules.test.js cross-seura-deny (punainen ennen korjausta).
//     Auditoitu: kaikki muut onKaavioHyvaksyja()-kutsukohdat ovat onOmaSeura-vartion sisällä.
//
// Muutokset v3.16 → v3.17 (Katselmuksen kommenttilanka — erä E):
//   + seurat/{sid}/kaaviot/{kid}/kommentit/{cid}: append-only staff-lanka. read = emokaavion
//     lukuportti (kaavioLukuOkDoc(get(emo))) + oma seura + valmentaja/johto — PELAAJA EI NÄE,
//     vaikka näkisi hyväksytyn kaavion (palaute on staffin työkalu). create vaatii
//     kirjoittaja == auth.uid, tyyppi in ['kommentti','hylkays'], aika == request.time,
//     teksti 1–2000 merkkiä. update KIELLETTY (myös kirjoittajalta), delete vain SA.
//   · kaavioLukuOk() → kaavioLukuOkDoc(d) + ohut kääre: alikokoelmassa resource.data on
//     kommentti, joten yksityisyys on kysyttävä emodokista.
//   · Kommentin KIRJOITUS on kapeampi kuin luku: seurasihteeri lukee (hän näkee kaaviotkin)
//     muttei kirjoita — sama rajaus kuin onKaavioHyvaksyja():ssa, koska katselmuspalaute on
//     valmennussisältöä eikä hallintoa.
//
// Muutokset v3.15 → v3.16 (Keskeneräinen luonnos — review.yksityinen):
//   + kaavioYksityinen() / kaavioTekija() / kaavioLukuOk(): yksityinen luonnos näkyy VAIN
//     tekijälle (review.luonut) ja SA:lle. Puuttuva kenttä = julkinen (taaksepäinyhteensopiva).
//     Hyväksytty ei voi olla yksityinen — katselmuksen läpäissyt on julkaistu määritelmällisesti.
//   ⚠ Johto (VP/UTJ) EI näe keskeneräisiä. Tämä on tulkinta ("yksityinen = ei valmis
//     kenellekään"), ei vahvistettu päätös — muutospiste on kaavioLukuOk() + policyn
//     kaavioVoiLukea, molemmat merkitty samalla varoituksella.
//
// Muutokset v3.14 → v3.15 (Kaavion kohdistus — neljäs taso 'valmentaja'):
//   + kaavioNakyvyysLuontiOk(): 'valmentaja' sallittujen tasojen joukkoon. Se on HENKILÖSTÖ-
//     REITITYS (kenelle valmentajalle kuva annetaan käytettäväksi), ei pelaajayleisö — se ei
//     laajenna pelaajien näkyvyyttä lainkaan, joten se ei vaadi hyväksyjää.
//   · review.valmentajaId — UUSI kohdekenttä. EI erillistä sääntömuutosta: kaaviot-blokissa ei
//     ole kenttäkohtaista allowlistia (create/update kirjoittavat koko dokumentin), joten uusi
//     review-kenttä kulkee olemassa olevien porttien läpi.
//   · Lukuportti ENNALLAAN: oman seuran valmentaja lukee jo KAIKKI seuran kaaviot kaikissa
//     tiloissa (allow read alla), joten valmentajalle osoitettu kaavio näkyy hänen pankissaan
//     ilman uutta ehtoa. Erillinen "valmentajaId == uid" -lisäys olisi kuollut sääntörivi.
//
// Muutokset v3.13 → v3.14 (Piirrokset Vaihe 1 — toissijainen pelipaikka):
//   + seurat/{sid}/pelaajat/{pid} update — field-level-allowlistiin 'tt_positio_toissijainen'
//     ensisijaisen rinnalle (sama omistajuus: valmentajaroolit + johto). Fysioterapeutti EI saa
//     tätä kenttää (sen allowlist pysyy jaksofokus + jaksofokus_historia).
//
// Muutokset (näkyvyystason roolilukko — kaaviot):
//   + kaavioNakyvyysLuontiOk() / kaavioNakyvyysMuutosOk(): seuratason näkyvyyden ('seura') saa
//     asettaa VAIN onKaavioHyvaksyja() (vp | urheilutoimenjohtaja | SA). Valmentaja luo ja
//     kohdistaa oman joukkueensa sisältöä ('joukkue'|'pelaaja'); seuran yhteisen kirjaston
//     kuratoi metodologiajohto. Muokkausportti koskee NOSTOA seuratasolle — jo seuratasoisen
//     kaavion sisältömuokkaus säilyy valmentajalla joukkuerajauksen puitteissa.
//
// Muutokset v3.12 → v3.13 (Seurakerros TIER 1 — seurakohtaiset konseptit):
//   + seurat/{sid}/konseptit/{avain} — kaanonin (lib/tm_teknistaktiset.js) päälle tuleva
//     seuraoverride: nimi/kpi/pelaaja_miksi/pelitilanne/kysymykset/piilotettu + seuran omat
//     (avain 'seura_*'). read: KOKO seura (valmentaja tarvitsee konseptit renderiin).
//     write: VAIN onKonseptiMuokkaaja() = vp | urheilutoimenjohtaja (+ SA). Valmentaja EI —
//     muuten seuran konseptikieli hajoaisi joukkueittain (§37 roolimalli). Valmentajan oma
//     kerros on TIER 2 (konseptin VALINTA + per-pelaaja tavoitteet), joka on ennallaan.
//     seurasihteeri EI mukana: hallinnollinen rooli, ei pedagoginen.
//     delete sallittu muokkaajalle: "palauta kaanoniin" = override-dokumentin poisto.
//
// Muutokset v3.11 → v3.12 (Vaihe 7.2a — fysiikkaohjelmakirjasto):
//   + seurat/{sid}/ohjelmat/{id} — deterministinen ohjelmakirjasto. read: oma seura.
//     create/update: oman seuran valmentajaroolit (sis. fysiikkavalmentaja) + fysioterapeutti
//     + johto. KOVA DELETE ESTETTY (vain SA) — arkistointi = update (arkistoitu:true). §6.
//
// Muutokset v3.10 → v3.11 (Vaihe 7 — fysiikkajakso, fysioterapeutti-klausuuli):
//   + seurat/{sid}/pelaajat/{pid} update — fysioterapeutti saa field-level-writen
//     VAIN ['jaksofokus', 'jaksofokus_historia'] (fyysisen jakson sulku/arvio, §4/§37).
//     EI tt_positio_aktiivinen (ei kuulu fysioterapeutille). fysiikkavalmentaja kuuluu jo
//     onValmentajaRooli → toimii ilman muutosta. Fysioterapeutti EI onValmentajaRooli-listassa
//     (ei luo kalenteritapahtumia) — TIETOINEN RAJAUS, ei "korjata".
//
// Muutokset v3.9 → v3.10 (Vaihe 3a — IDP-kausitavoite):
//   + seurat/{sid}/pelaajat/{pid}/idp_kausi/{vuosi} — kausitavoite (IDP-ydin,
//     IDP_YDIN_SPEC §2). Kirjoitus johto + oman seuran valmentaja (§15-pattern).
//     LUKU myös pelaajalle (PIN/anon) — kausitavoite jaetaan 3c-peilissä
//     (§7.22-turvallinen render); ERI kuin raaka arviointi (jota anon ei lue).
//     Pikakentät idp_tila/idp_edistyma/idp_fokus pelaajadokumenttiin (jo sallittu).
//     doc-ID = vuosi ilman "/" (§11).
//
// Muutokset v3.8 → v3.9 (Vaihe 2b — ominaisuusarviointi, Palloliitto-taksonomia):
//   + seurat/{sid}/pelaajat/{pid}/arviointi/{kausiId} — havaittu 1–5 -arvio
//     (Palloliitto Player Development Card). Aikuisten työkalu (§7.22): luku VAIN
//     SA + oman seuran henkilöstö (EI anon/pelaaja eikä huoltaja — raaka "Poor"
//     ei näy lapselle/perheelle). Kirjoitus valmentaja/johto. doc-ID = kausi ilman
//     "/" (esim. 2026-27, §11 — "2026/27" tulkittui polkuerottimeksi → korjattu).
//     Ilman tätä blokkia tallennus kaatui "Missing or insufficient permissions".
//
// Muutokset v3.7 → v3.8 (Solo Polku B, SOLO_P0_TIETOMALLI_SPEC.md §9):
//   + lupapyynnot/{requestId} — lapsi luo (status 'odottaa'), get omalla requestId:llä, EI list;
//     update/delete VAIN CF (Admin SDK hyväksynnässä).
//   ~ players/{id} — read jaettu get/list; lapsi (anonymous + child_pin) saa single-doc GET +
//     rajatun UPDATEn omaan dokkiin (ei muuta parent_uid/child_pin/playerCode/seuraId). EI list anonyymille.
//
// Muutokset v3.6 → v3.7 (Solo Player™ P0, SOLO_P0_TIETOMALLI_SPEC.md §4):
//   + parents/{uid}      — vanhemman tili (vain oma uid).
//   + players/{playerId} — Solo-pelaaja (litteä), omistus parent_uid == auth.uid + alikokoelmat.
//   + playerCodes/{code} — club-bridge-indeksi (luo oma vanhempi; luku kirjautuneelle).
//   ERILLINEN lohko klubin seurat/-puusta. Polku B (lupapyynnot + lapsi-PIN) = PR 2.
//
// Muutokset v3.5 → v3.6 (V1 kuorma & fiilis, KUORMA_FIILIS_SPEC.md §5):
//   ~ kalenteri/{id} update field-level (valmentaja, ei-omistaja) sallii nyt myös
//     'valmentaja_rpe' + 'valmentaja_rpe_pvm' (valmentajan session-RPE -arvio).
//     Johto/omistaja (luoja_uid==uid) saa jo täyden updaten → ei muutosta heille.
//
// Muutokset v3.4 → v3.5 (kalenteri-omistajuus + läsnäolo, KALENTERI_ARKKITEHTUURI.md §7):
//   ~ seurat/{sid}/kalenteri/{tapahtumaId} update — valmentaja/talenttivalmentaja saa nyt
//     TÄYDEN muokkauksen OMIIN tapahtumiinsa (resource.data.luoja_uid == auth.uid) JA
//     field-level muokkauksen MUIDEN tapahtumiin (vain muistiinpanot + läsnäolo-kooste + audit).
//   ~ create — valmentajaroolilta vaaditaan luoja_uid == auth.uid (omistajuus aina kirjautuu).
//   ~ lasnaolijat/{osallistujaId} — valmentaja/johto saa merkitä läsnäolon kenelle tahansa
//     pelaajalle (osallistujaId = pelaajaId); pelaaja vahvistaa edelleen OMAN (uid==osallistujaId).
//
// Muutokset v3.3 → v3.4 (kalenteri-kokoelma):
//   + seurat/{sid}/kalenteri/{tapahtumaId} — seuran pääkalenteri (KALENTERI_ARKKITEHTUURI.md §3).
//     VP/johto: full CRUD. Valmentaja: create + field-level update (muistiinpanot, tila, soft-delete).
//     Ei hard-deletea (audit-jälki, soft-delete update-kautta).
//   + seurat/{sid}/kalenteri/{tapahtumaId}/lasnaolijat/{uid} — läsnäolovahvistukset.
//     Osallistuja saa päivittää oman läsnäolonsa.
//
// Muutokset v3.2 → v3.3 (kirjaus-permissionit, PÄÄTÖS 1+2):
//   + kirjaukset: VP + talenttivalmentaja (oma seura) eksplisiittinen kirjoitusoikeus.
//   + onU12Huoltaja() — huoltaja saa kirjata alle 13v -lapselle kun lahde=='vanhempi'.
//     Kaikissa kirjauksissa pakollinen lahde-kenttä (valmentaja|pelaaja|vanhempi|vp|talenttivalmentaja).
//
// Muutokset v3.1 → v3.2 (universaali testi-arkkitehtuuri):
//   + seurat/{sid}/konfiguraatio/{konfId} — seuran normijärjestelmä (maa/kieli).
//     Ladataan tuonti/analyysihetkellä; mahdollistaa kv-normit (DFB/KNVB) tulevaisuudessa.
//
// Muutokset v3.0 → v3.1 (VP_v25 Sprint A):
//   + seurat/{sid}/toimenpiteet/{tid} —
//     TalentMasterin automaattiset ehdotukset +
//     VP:n kuittaus/muokkaus/hylkäys.
//     Ei delete: audit-jälki säilyy aina.
//
// Muutokset v2.9 → v3.0 (Master_v16 — TKI-palaute + harjoitusprioriteetti):
//   + seurat/{sid}/pelaajat/{pid}/palautteet/{pvm}_tki — valmentajan TKI-palaute
//     pelaajalle. nakyvyys-flag ('pelaaja'|'vain_valmentaja') gateaa pelaajan luvun.
//   + seurat/{sid}/joukkueet/{jid}/harjoitusprioriteetti/{id} — joukkueen
//     harjoitusprioriteetti testidatasta (doc 'aktiivinen'); koko seura lukee.
//   Firestore EI periydy alikokoelmiin → omat blokit pakolliset (§17 #18).
//
// Muutokset v2.8 → v2.9 (VP kalenteri):
//   + seurat/{sid}/tapahtumat/{id} — SEURATASON yleistapahtumat +
//     VP_v22:n mentorointi-pikamalli (tyyppi:'mentorointi'/'kokous').
//     Ilman tätä mentoroinnin tallennus + viikkonäkymän luku kaatuvat.
//     HUOM: eri kuin pelaajatason legacy /pelaajat/{id}/tapahtumat.
//   + seurat/{sid}/vp_kalenteri/{id} — VP:n deadlinet/muistutukset (amber).
//
// Muutokset v2.7 → v2.8 (Bio-ikä — PHV/Mirwald):
//   + seurat/{sid}/pelaajat/{pid}/biologinen_ika/{mittausPvm} — Testaus_v9:n
//     kasvumittaus-protokolla kirjoittaa PHV-mittaushistorian tänne.
//     VP-pikakentät (phv_tila, biologinenIka_viimeisin) menevät suoraan
//     pelaajadokumenttiin (pelaajat-update sallii valmentajan jo ennestään).
//     Vanhempien pituudet (isa_pituus_cm/aiti_pituus_cm) tallennetaan
//     rekisteröinnissä pelaajadokumenttiin — ei vaadi uutta blokkia.
//
// Muutokset v2.6 → v2.7 (Testaus_v8 kalenterikopio):
//   + seurat/{sid}/joukkueet/{jid}/kalenteri/{kid} — alikokoelma jonka
//     Testaus_v8._tallennaTapahtuma kirjoittaa testitapahtuman luonnin
//     yhteydessä (pikaviittaus joukkueen kalenteriin). Aiemmin puuttuva
//     match-blokki aiheutti "Missing or insufficient permissions"-virheen
//     vaikka pää-testitapahtuma tallentui onnistuneesti.
//     CLAUDE.md §17 #18 — Rules eivät periydy alikokoelmiin automaattisesti.
//
// Muutokset v2.5 → v2.6 (Sprint 3.1 — Historiapohja-tuonti):
//   + seurat/{sid}/pelaajat/{pid}/testitulokset/{pvm}_{protokolla} —
//     Excel_Tuonti.html:n historiapohja-moodin kirjoituspolku. Tukee
//     vanhan testidatan tuontia ilman testitapahtumaa.
//     read:  SA | omaSeura (johto|valmentaja) | anonymous (PIN) | huoltaja
//     write: SA | omaSeura (johto)
//
// Muutokset v2.4 → v2.5 (Sprint 3):
//   * idp_jono — tila-arvo 'odottaa' tuettu rinnakkain 'ehdotettu'-arvon
//     kanssa (uusi standardi). Valmentaja saa muokata omaa ehdotustaan
//     niin kauan kuin tila in ['ehdotettu','odottaa'].
//   + meta/{key} — VP:n metadatakanava (esim. phv_snapshot Sprint 3
//     signaaleille — VP/UTJ/seurasihteeri kirjoittaa, koko seura lukee).
//
// Muutokset v2.3 → v2.4 (Sprint 2):
//   + seurat/{sid}/pelaajat/{pid}/vp_muistiinpanot/{mid} — VP:n muistiinpanot
//     pelaajalle, näkyvyys-flageilla naytaValmentajalle / naytaPelaajalle
//
// Muutokset v2.1.0 → v2.3:
//   + onLapsenHuoltaja(seuraId, pelaajaId) — vanhempi tunnistetaan
//     huoltajaEmail-kentän kautta (case-insensitive vertailu)
//   + Vanhemman luku lisätty: pelaajat, havainnot, kirjaukset, idp,
//     testitapahtumat/tulokset
//   + kehut/{kehuId} — vanhempi luo, pelaaja lukee + kuittaa nahty-kentän
//   + testitapahtumat/{id} + tulokset/{pelaajaId}  (CLAUDE.md §17 #19, §23)
//   + idp_jono/{id}
//   + valmentajat/{uid} + kontribuutio + tuloskortti
//   + viestit/{viestiId}
//
// Säilyy v2.1.0:sta:
//   • Anonyymi (PIN) saa lukea seurat/{id}/pelaajat + havainnot
//   • Super admin: rooli=='super_admin' TAI admins/{uid} exists
//   • Legacy claim 'superadmin' tuettu rinnakkain (CLAUDE.md §24)
//   • Pelaajatason kayttajat-alikokoelma VP:lle (Henkilöstö-näkymä)
//   • Jokainen alikokoelma omalla match-blokilla (§17 #18 — ei periydy)
// ══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // APUFUNKTIOT
    // ──────────────────────────────────────────────────────────────────────
    function onKirjautunut() {
      return request.auth != null;
    }

    function onSuperAdmin() {
      return request.auth.token.rooli == 'super_admin'
          || request.auth.token.rooli == 'superadmin'   // legacy (CLAUDE.md §24)
          || request.auth.token.super_admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onOmaSeura(seuraId) {
      return request.auth.token.seuraId == seuraId;
    }

    function onAnonymous() {
      // Anonymous Auth — pelaajan PIN-kirjautuminen Pelaaja-näkymässä
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function onValmentajaRooli() {
      // HUOM: seurasihteeri + testivastaava POISTETTU tästä (2026-06-05) — ne eivät saa
      // broad valmennusdata-kirjoitusta. Rajatut oikeudet onSeuraSihteeri/onTestivastaava-kautta.
      return request.auth.token.rooli in [
        'valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja',
        'vp', 'urheilutoimenjohtaja'
      ];
    }

    function onJohtoRooli() {
      return request.auth.token.rooli in [
        'vp', 'urheilutoimenjohtaja', 'seurasihteeri'
      ];
    }

    // Seurakerros TIER 1 — kuka saa muokata seuran konseptikieltä (kaanonin override).
    // TARKOITUKSELLA KAPEAMPI kuin onJohtoRooli(): seurasihteeri on hallinnollinen rooli,
    // ei pedagoginen. VP (Fotbollsutvecklare) / urheilutoimenjohtaja (Head of Talent) omistavat
    // seuran konseptikielen; valmentaja valitsee konseptin ja asettaa pelaajatavoitteet (TIER 2).
    function onKonseptiMuokkaaja(seuraId) {
      return onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja'];
    }

    // (Seurasihteerin oikeudet hoituvat onJohtoRooli():n kautta — erillinen onSeuraSihteeri
    //  poistettu 2026-06-08 käyttämättömänä; kompilaattori varoitti unused + invalid 'request'.)

    // Testivastaava — kirjoittaa VAIN testitapahtumat + testitulokset, lukee pelaajaprofiilit.
    function onTestivastaava(seuraId) {
      return request.auth.token.rooli == 'testivastaava' && onOmaSeura(seuraId);
    }

    function onOmanSeuranValmentaja(seuraId) {
      return onOmaSeura(seuraId) && onValmentajaRooli();
    }

    // ── KAAVIOT (v3.6) ────────────────────────────────────────────────────────────────
    // Hyväksyjä on TAHALLAAN kapeampi kuin onJohtoRooli(): se sisältäisi seurasihteerin,
    // joka ei ole valmennusrooli eikä saa hyväksyä valmennussisältöä.
    function onKaavioHyvaksyja() {
      return request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja'] || onSuperAdmin();
    }
    function kaavioTila(d)      { return d.get('review', {}).get('status', 'luonnos'); }
    function kaavioJoukkue(d)   { return d.get('review', {}).get('joukkueId', null); }
    // NÄKYVYYSTASON ROOLILUKKO. Hallintomalli: valmentaja luo ja kohdistaa OMAN joukkueensa
    // sisältöä; seuran yhteisen kirjaston kuratoi metodologiajohto (VP/urheilutoimenjohtaja/SA).
    // Puuttuva kenttä tulkitaan 'seura'ksi — lupaportti on FAIL-CLOSED: määrittelemätön näkyvyys
    // ei saa olla helpompi reitti kuin eksplisiittinen.
    function kaavioNakyvyys(d) { return d.get('review', {}).get('nakyvyys', 'seura'); }
    // Luonti: seuratason saa asettaa vain hyväksyjä. 'valmentaja' on HENKILÖSTÖREITITYS (kenelle
    // valmentajalle kuva annetaan käytettäväksi), ei pelaajayleisö — se ei laajenna pelaajien
    // näkyvyyttä lainkaan (lib/tm_kaavio_policy.js kaavioKohdistuu → false), joten sen asettaminen
    // ei vaadi hyväksyjää sen enempää kuin joukkue/pelaaja-kohdistuskaan.
    function kaavioNakyvyysLuontiOk() {
      return kaavioNakyvyys(request.resource.data) in ['joukkue', 'pelaaja', 'valmentaja'] || onKaavioHyvaksyja();
    }
    // Muokkaus: portti koskee NOSTOA seuratasolle, ei absoluuttista arvoa. Jos kaavio on JO
    // seuratasoinen, valmentaja saa yhä muokata sen sisältöä oman joukkuerajauksensa puitteissa —
    // muuten VP:n hyväksymän kaavion pieninkin korjaus olisi yhtäkkiä kielletty. Laskeminen
    // seuratasolta joukkue/pelaaja-tasolle on sallittua (se kaventaa näkyvyyttä, ei laajenna).
    function kaavioNakyvyysMuutosOk() {
      return kaavioNakyvyys(request.resource.data) != 'seura'
          || kaavioNakyvyys(resource.data) == 'seura'
          || onKaavioHyvaksyja();
    }
    // Sallitut statussiirrot. Suora luonnos→hyvaksytty on KIELLETTY (katselmus ei saa ohittua).
    function kaavioSiirtoOk(vanha, uusi) {
      return uusi == vanha
          || (vanha == 'luonnos'    && uusi == 'odottaa')
          || (vanha == 'hylatty'    && uusi == 'odottaa')
          || (vanha == 'hyvaksytty' && uusi == 'odottaa')
          || (vanha == 'odottaa'    && (uusi == 'hyvaksytty' || uusi == 'hylatty') && onKaavioHyvaksyja());
    }
    // Uudelleenhyväksyntä: hyväksytyn kaavion muokkaus pudottaa sen takaisin odottamaan,
    // PAITSI jos muokkaaja on jo hyväksyntävaltuutettu (itse-kierros ei lisää kontrollia).
    function kaavioUudelleenhyvaksyntaOk(vanha, uusi) {
      return vanha != 'hyvaksytty' || onKaavioHyvaksyja() || uusi == 'odottaa';
    }
    // OPTIMISTINEN VERSIOLUKKO (v3.7). Kaavio on kokonaisuutena korvattava dokumentti: spec
    // kirjoitetaan aina kokonaan, joten hiljainen ylikirjoitus menettäisi KOKO toisen piirroksen.
    // Client lukee versio:n auki avatessaan ja kirjoittaa +1; jos toinen ehti väliin, resource on
    // jo kasvanut → tämä ehto kaatuu ja client joutuu lataamaan uudelleen. Vain TÄSMÄLLEEN +1:
    // hyppy ohittaisi välissä tehdyn muutoksen, lasku palauttaisi vanhan tilan.
    // YKSITYINEN LUONNOS (v3.16). "Ei vielä valmis", EI valmentajien välinen piilotus: seuran
    // sisäinen näkyvyys on tarkoituksellista ja palaa heti julkaisusta (review.yksityinen=false).
    // Puuttuva kenttä = julkinen → vanhat luonnokset eivät katoa kenenkään näkyvistä.
    // Hyväksytty ei voi olla yksityinen: katselmuksen läpäissyt on määritelmällisesti julkaistu.
    function kaavioYksityinen(d) {
      return d.get('review', {}).get('yksityinen', false) == true
          && kaavioTila(d) != 'hyvaksytty';
    }
    function kaavioTekija(d) { return d.get('review', {}).get('luonut', null); }
    // ⚠ PÄÄTÖS JOTA EI OLE VAHVISTETTU: näkeekö johto (VP/UTJ) keskeneräiset? Tässä TIUKEMPI
    // linja — EI näe, koska "yksityinen" tarkoittaa ei valmista KENELLEKÄÄN. SA näkee (ylläpito,
    // oma haara allow readissä). Jos johto tarvitsee oversightin, muutos on tämä yksi ehto +
    // lib/tm_kaavio_policy.js kaavioVoiLukea — molemmat merkitty samalla kommentilla.
    // Doc-parametrinen, koska kommentti-alikokoelman on kysyttävä EMOKAAVIOSTA: alikokoelmassa
    // resource.data on kommentti, ei kaavio.
    function kaavioLukuOkDoc(d) {
      return !kaavioYksityinen(d) || kaavioTekija(d) == request.auth.uid;
    }
    function kaavioLukuOk() { return kaavioLukuOkDoc(resource.data); }

    function kaavioVersio(d) { return d.get('review', {}).get('versio', 0); }
    function kaavioVersioOk() {
      return kaavioVersio(request.resource.data) == kaavioVersio(resource.data) + 1;
    }

    // Permissio-joukkulukko — valmentajan oma joukkue säännöistä (self-contained, rules-get; ei claims-riippuvuutta).
    // kayttajat/{uid}.joukkueet = ID-lista (Seura-näkymä; VP:llä tyhjä → hoitaa kaikkia johto-ohituksella).
    function valmentajanJoukkueet(seuraId) {
      return get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.get('joukkueet', []);
    }
    // Valmentaja saa kirjoittaa VAIN oman joukkueensa pelaajiin (ID-täsmäys pelaajan joukkueet[] ∩ valmentajan joukkueet[]).
    // Joukkuerajauksen OHITTAA → koko seura (seura-lukko onOmanSeuranValmentaja säilyy silti):
    //   · johto (VP/urheilutoimenjohtaja, onJohtoRooli)
    //   · talenttivalmentaja — vastuu ulottuu seuran kaikkiin joukkueisiin/talentteihin (ei joukkuerajattu).
    //     EI lisätä onJohtoRooli:on (talenttivalmentaja ei ole hallintorooli); ohitus vain tässä joukkulukossa.
    // SA erikseen kutsupaikoissa.
    // Fail-closed: pelaajalla/valmentajalla ei joukkueet-kenttää → [] → hasAny false → estetty (ellei ohittava rooli).
    function onOmanJoukkueenValmentaja(seuraId, pelaajaId) {
      return onOmanSeuranValmentaja(seuraId)
          && ( onJohtoRooli()
            || request.auth.token.rooli == 'talenttivalmentaja'
            || pelaajaData(seuraId, pelaajaId).get('joukkueet', []).hasAny(valmentajanJoukkueet(seuraId)) );
    }

    // v2.3 — pelaajan dokumentti getterillä (Firestore välimuistittaa)
    function pelaajaData(seuraId, pelaajaId) {
      return get(
        /databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)
      ).data;
    }

    // v2.3 — Huoltaja-tunnistus pelaajadokumentin huoltajaEmail-kentästä.
    // Vertailu lowercased — pelaajaa luotaessa huoltajaEmail voi olla
    // sekamuotoinen (esim. "TeroKoskela7@gmail.com"), mutta Firebase Auth
    // normalisoi tokenin emailin lowercased-muotoon.
    function onLapsenHuoltaja(seuraId, pelaajaId) {
      return onKirjautunut()
          && request.auth.token.email is string
          && pelaajaData(seuraId, pelaajaId).huoltajaEmail is string
          && request.auth.token.email.lower()
             == pelaajaData(seuraId, pelaajaId).huoltajaEmail.lower();
    }

    // v3.3 (PÄÄTÖS 2) — huoltaja saa KIRJATA U12-lapselle (alle 13v) kun lahde=='vanhempi'.
    //   1) sähköposti täsmää huoltajaEmail-kenttään (onLapsenHuoltaja)
    //   2) pelaaja alle 13v: syntymaVuosi >= kuluva vuosi − 12 (sama kuin sovelluksen u12-vaihe)
    //   3) kirjauksen lahde == 'vanhempi'
    //   HUOM: request.time.year() antaa kalenterivuoden (käyttäjän toMillis-kaavasta puuttui
    //   1970-offset → olisi ollut aina tosi).
    function onU12Huoltaja(seuraId, pelaajaId) {
      return onLapsenHuoltaja(seuraId, pelaajaId)
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi is int
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi >= (request.time.year() - 12)
          && request.resource.data.lahde == 'vanhempi';
    }

    // ── A5: aikaleima-kentän eheys (luotu) ────────────────────────────────
    // Estää orderBy/where-näkymättömyyden kahdesta syystä:
    //   • luotu PUUTTUU  → orderBy('luotu') jättää dokumentin kokonaan pois
    //   • luotu ISO-STRING → Firestoren tyyppijärjestys erottaa sen Timestampeista
    //     (timestamp < string) → limit/where-kyselyt eivät näe sitä.
    // create: luotu pakollinen + timestamp.
    // update: jos luotu on muuttuvien kenttien joukossa, sen on oltava timestamp;
    //   muuten ohitus → lukukuittaukset (nahty ym.) ja muut field-level-päivitykset
    //   toimivat eikä luotu-kenttää voi pudottaa overwrite-setillä.
    // ⚠ DEPLOY VASTA kun kirjoittajat korjattu + olemassa oleva data migroitu
    //   (havainnot/kirjaukset). Ks. docs/SKAALAUTUVUUS_JA_TEKNINEN_VELKA.md §A5.
    function luotuLuontiKelpaa() {
      // 'luotu' in ... ENNEN is timestamp -tarkistusta: estää evaluointivirheen
      // ("Property luotu is undefined") kun kenttä puuttuu → siisti false (= hylkää).
      return 'luotu' in request.resource.data
          && request.resource.data.luotu is timestamp;
    }
    function luotuPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['luotu'])
          || ('luotu' in request.resource.data
              && request.resource.data.luotu is timestamp);
    }
    // A5-jälki: sama `aika`-kentälle (mentorointiviestit seurat/{}/viestit) — estää regression
    // (data + VP_v25-writer ovat jo Timestamp; vartija lukitsee).
    function aikaLuontiKelpaa() {
      return 'aika' in request.resource.data
          && request.resource.data.aika is timestamp;
    }
    function aikaPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aika'])
          || ('aika' in request.resource.data
              && request.resource.data.aika is timestamp);
    }

    // ──────────────────────────────────────────────────────────────────────
    // ADMINS — super admin -taulukko
    // ──────────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if onKirjautunut();
      allow write: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // SEURAT — pääkokoelma + kaikki alikokoelmat
    // ──────────────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
      allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

      // ── KAAVIOT (v3.6) — seurakohtaiset teknis-taktiset kaaviot + review-silmukka ──
      // Kaksikerros: kanoninen /kaaviot/{avain} (master) + tämä seurataso (omat + override).
      // Sama spec.avain seuratasolla VOITTAA kanonisen (näyttölogiikka, ei sääntö).
      //
      // ⚠ PELAAJAN KOHDISTUSTA EI VOI PAKOTTAA. PIN-pelaaja on Anonymous Auth → tokenissa ei ole
      //   pelaaja- eikä seuraidentiteettiä (onAnonymous() tarkistaa vain sign_in_providerin).
      //   Siksi palvelin pakottaa pelaajalle VAIN status=='hyvaksytty'. review.nakyvyys /
      //   joukkueId / pelaajaIds ovat UI-TASOINEN suodatin (lib/tm_kaavio_policy.js
      //   kaavioKohdistuu) — ÄLÄ lue tätä sääntöä lupaukseksi kohdistuksen pakottamisesta.
      //   Kuittaus (review.ymmarretty) kirjoitetaan siksi Cloud Functionilla, ei clientistä.
      match /kaaviot/{kaavioId} {
        // Kovennus (B2): hyväksytyn luku vaatii EKSPLISIITTISESTI kirjautumisen. Aiemmin
        // kirjautumaton estyi vain siksi että onSuperAdmin() kaatui eval-virheeseen — se on
        // sivuvaikutus, ei sääntö. Nyt kielto on luettavissa säännöstä.
        allow read: if onKirjautunut() && (
                         onSuperAdmin()
                      || (kaavioLukuOk() && (
                              (onOmaSeura(seuraId) && (onValmentajaRooli() || onJohtoRooli()))
                           || kaavioTila(resource.data) == 'hyvaksytty')));

        // Luonti: oman seuran valmentaja/johto. Uusi kaavio EI voi syntyä hyväksyttynä.
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onValmentajaRooli()
                          && kaavioTila(request.resource.data) in ['luonnos', 'odottaa']
                          && kaavioVersio(request.resource.data) == 0
                          && kaavioNakyvyysLuontiOk());

        // Päivitys: seura-skooppi + sallittu statussiirto + uudelleenhyväksyntä.
        // Joukkuerajaus: valmentajalla oltava kaavion joukkueId omissa joukkueissaan; johto ja
        // talenttivalmentaja ohittavat rajauksen seuran sisällä (sama kuvio kuin pelaajakirjoitus).
        allow update: if kaavioVersioOk() && (
                         onSuperAdmin()
                      || (onOmaSeura(seuraId) && onValmentajaRooli()
                          && kaavioNakyvyysMuutosOk()
                          && kaavioSiirtoOk(kaavioTila(resource.data), kaavioTila(request.resource.data))
                          && kaavioUudelleenhyvaksyntaOk(kaavioTila(resource.data), kaavioTila(request.resource.data))
                          && ( onKaavioHyvaksyja()
                            || request.auth.token.rooli == 'talenttivalmentaja'
                            || (kaavioJoukkue(resource.data) != null
                                && valmentajanJoukkueet(seuraId).hasAny([kaavioJoukkue(resource.data)])) )));

        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onKaavioHyvaksyja());

        // ── KATSELMUKSEN KOMMENTTILANKA (erä E) ────────────────────────────────────────
        // Hylkäys ilman perustelua oli umpikuja: valmentaja sai "hylätty" tietämättä miksi.
        // Lanka on ALIKOKOELMA, ei review.kommentit[]-taulukko — taulukko vaatisi doc-updaten
        // joka kommentista, mikä törmäisi optimistiseen versiolukkoon (kaavioVersioOk) ja
        // rinnakkaisiin kirjoituksiin. Append-only-alikokoelma on puhdas lisäys.
        //
        // ⚠ ALIKOKOELMA EI PERI YLÄPUOLEN SÄÄNTÖJÄ (§12) → portit toistetaan tässä.
        //   resource.data on KOMMENTTI, joten yksityisyys kysytään emokaaviosta get():llä.
        //
        // STAFF-LANKA: pelaaja EI näe tätä, vaikka näkisi hyväksytyn kaavion. Palaute on
        // valmentajan ja VP:n välinen työkalu ("liikaa pelaajia kentällä"), ei pelaajalle
        // suunnattua sisältöä. Pelaajan oma kysymys on erillinen CF-reitti (anon-rajoite).
        match /kommentit/{kommenttiId} {
          function emoKaavio() {
            return get(/databases/$(database)/documents/seurat/$(seuraId)/kaaviot/$(kaavioId)).data;
          }
          // LUKU = sama joukko joka näkee kaavion (sis. seurasihteerin: hän näkee kaaviotkin).
          function onStaffLuku() {
            return onOmaSeura(seuraId) && (onValmentajaRooli() || onJohtoRooli());
          }
          // KIRJOITUS on kapeampi, samasta syystä kuin onKaavioHyvaksyja(): seurasihteeri ei ole
          // valmennusrooli. Katselmuspalaute on valmennussisältöä ("karsi kolmeen pelaajaan"),
          // ei hallintoa — sen kirjoittaminen kuuluu samoille rooleille jotka omistavat kaavion.
          //
          // ⚠ SULKEET OVAT PAKOLLISET. Ilman niitä && sitoo ennen ||, jolloin ehdoksi tulee
          //   (onOmaSeura && onValmentajaRooli) || onKaavioHyvaksyja()
          // ja jälkimmäinen haara on SEURANEUTRAALI roolitesti → minkä tahansa seuran vp/UTJ
          // olisi voinut kirjoittaa tämän seuran lankaan (sokkokirjoitus tunnettuun polkuun;
          // luku oli aina suojattu). onKaavioHyvaksyja() on tarkoituksella pelkkä roolitesti —
          // SEURARAJAUS KUULUU KUTSUJALLE, ja kaikissa muissa kutsukohdissa se on onOmaSeura-
          // vartion sisällä. SA:lla oma eksplisiittinen haara, kuten kaaviotason porteissa:
          // ylläpito-ohitus pidetään näkyvänä eikä salakuljeteta roolitestin sisällä.
          function onStaffKirjoitus() {
            return onSuperAdmin()
                || (onOmaSeura(seuraId) && (onValmentajaRooli() || onKaavioHyvaksyja()));
          }
          // Yksityisen luonnoksen lanka seuraa kaaviota: vain tekijä (ja SA).
          allow read: if onSuperAdmin() || (onStaffLuku() && kaavioLukuOkDoc(emoKaavio()));

          // Append-only. kirjoittaja == auth.uid estää väärennetyn tekijätiedon; aika ==
          // request.time pakottaa serverTimestampin (client ei voi valita kellonaikaa langassa).
          allow create: if onStaffKirjoitus()
                        && request.resource.data.kirjoittaja == request.auth.uid
                        && request.resource.data.tyyppi in ['kommentti', 'hylkays']
                        && 'aika' in request.resource.data
                        && request.resource.data.aika == request.time
                        && request.resource.data.teksti is string
                        && request.resource.data.teksti.size() > 0
                        && request.resource.data.teksti.size() <= 2000;

          // Muokkaus kielletty myös kirjoittajalta: lanka on katselmuksen jälki, ei muistio.
          // Jälkikäteen siistitty hylkäysperustelu tekisi historiasta epäluotettavan.
          allow update: if false;
          allow delete: if onSuperAdmin();
        }
      }

      // ── TOIMENPITEET — TalentMasterin ehdotukset + VP:n kuittaukset (v3.1) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Ei delete: historia/audit-jälki
      // säilyy aina (tila ehdotus|kuitattu|muokattu|hylatty). VP/SA luo + päivittää.
      match /toimenpiteet/{tid} {
        allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── KONSEPTIT (v3.13) — SEURAKERROS TIER 1 ──────────────────────────────────────
      // Kerrosmalli: TIER 0 kaanon (lib, read-only) → TIER 1 tämä → TIER 2 yksilö (pelaajadata).
      // Dokumentti on HARVA override: vain muutetut kentät. Avain = kaanonin avain (y_h0…) tai
      // seuran oma 'seura_<slug>'. Rules EIVÄT periydy → oma blokki.
      //   read   koko seura — valmentaja tarvitsee resolvoidut konseptit renderiin.
      //   write  VAIN vp/urheilutoimenjohtaja (+SA) — ks. onKonseptiMuokkaaja().
      //   delete sama portti: "palauta kaanoniin" poistaa koko override-dokumentin.
      // Sisältö on seuran pedagogista tekstiä (ei pelaajaa yksilöivää) → ei GDPR-erityiskäsittelyä.
      match /konseptit/{konseptiAvain} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
        allow update: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
        allow delete: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
      }

      // ── KONFIGURAATIO (v3.2) — seuran normijärjestelmä (normijarjestelma/maa/kieli) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Luku koko seuralle; kirjoitus VP/SA.
      match /konfiguraatio/{konfId} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }

      // ── HARJOITUSARVIOINNIT (HARJOITUSARVIOINTI_SPEC §9) ──────────────────
      // Kaksimallinen harjoitusarviointi (A Palloliitto-laatu / B valmennustaidot).
      // read: SA | oma seura (valmentaja näkee omat, johto kaikki). create/update: johto + oman seuran valmentaja + SA.
      // delete: vain SA. Pikakentät (harjoituslaatu_/valmennustaito_) kirjoitetaan kayttajat-dokumenttiin (oma blokki alla).
      match /harjoitusarvioinnit/{arvioId} {
        allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
        allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId);
        allow delete:         if onSuperAdmin();

        // ── Palautekerros (Vaihe 2.1, HARJOITUSARVIOINTI_VAIHE2_SPEC §5) — kaksi ERI alikokoelmaa,
        // koska Firestore-luku on dokumenttitasolla (kenttää ei voi piilottaa lukijalta). Rules eivät periydy → omat blokit.
        // JAETTU = näkyy valmentajalle (oma seura). YKSITYINEN = vain johto/SA (valmentaja EI saa lukea).
        match /palaute_jaettu/{palauteId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == request.resource.data.tekija_uid;
          allow update: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == resource.data.tekija_uid;
          allow delete: if onSuperAdmin();
        }
        match /palaute_yksityinen/{palauteId} {
          allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());   // KRIITTINEN: valmentaja ei saa lukea
          allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }
      }

      // ── PELAAJAT ────────────────────────────────────────────────────────
      // read: super admin | oma seura | anonyymi PIN | huoltaja (v2.3)
      // Anonyymi PIN -lukuoikeus on pakollinen: Pelaaja-näkymä hakee oman
      // pelaajadokumentin PIN-koodin validoimiseksi ennen kuin tietää uid:n.
      match /pelaajat/{pelaajaId} {
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId))
                      || onAnonymous()
                      || (onKirjautunut()
                          && request.auth.token.email is string
                          && resource.data.huoltajaEmail is string
                          && request.auth.token.email.lower()
                             == resource.data.huoltajaEmail.lower());
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)   // permissio-joukkulukko: ADAR-pikakentät ym. vain oman joukkueen pelaajaan (johto ohittaa)
                      || onTestivastaava(seuraId)   // testituonnin profiili-pikakentät (hh_taso/hh_viimeisin/mas_kmh)
                      || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                      // PIN-pelaaja (anonyymi) saa päivittää VAIN oman xp/streak-pelillistyksen
                      // (_tallennaKirjaus-batch). Sama luottamusmalli kuin kirjaukset-onAnonymous.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['xp', 'streak', 'streak_paivitetty']))
                      // PIN-pelaaja: D3-psyykkinen itsearvio (§C) — vain d3-pikakentät omaan dokumenttiin.
                      // Valmentajan pisteet[dim].valmentaja säilyvät: client tekee merge nykyisistä (sama
                      // anon-luottamusmalli kuin xp/kirjaukset; nested-validointia rules ei tee).
                      // d3_varmuus = johdettu pikakenttä (D3_KALIBRAATIO_SPEC malli A): pelaaja kirjoittaa
                      // 'itsearvio'/'trianguloitu' lahteet[]:stä → kuuluu sallittuihin avaimiin.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['d3_viimeisin', 'd3_taso', 'd3_pvm', 'd3_varmuus']))
                      // IDP-kortti v2 §4 — PIN-pelaaja: oma sitoumus-pikakenttä (idp_sitoumus_pvm). Sama anon-luottamusmalli.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['idp_sitoumus_pvm']))
                      // P7-c.4a — PIN-pelaaja/vanhempi: oma notif-asetus (opt-out / hiljaiset tunnit). Sama anon-luottamusmalli.
                      || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['notif_asetukset']))
                      // Vaihe 4a — jaksofokus + tt_positio_aktiivinen (operatiivinen teknis-taktinen pelitavoite, §4
                      // roolimalli). Kenttäomistajuus: valmentaja/talenttivalmentaja/VP (onValmentajaRooli) saavat
                      // jo koko-dokin updaten (yllä); tämä tekee EKSPLISIITTISEKSI että myös johto (onJohtoRooli =
                      // vp/utj/seurasihteeri) saa tarkan field-level-writen näihin kahteen pikakenttään (§26 talent-
                      // hallinta, §37). Ei vaadi hyväksyntää (ei byrokratisoida jaksoja); talenttirajaus = UI-taso
                      // (kuten muut valmentaja-writet). Kausitavoite (IDP §3a/idp_kausi) pysyy VP-hyväksyttynä erikseen.
                      // Vaihe 6 — jaksofokus_historia (meso-syklin sulku, append pikakenttä-array §26):
                      // sama kenttäomistajuus kuin jaksofokus (joukkuevalmentaja/talenttivalmentaja/VP sulkee omat
                      // pelaajansa). Sulku kirjoittaa jaksofokus (korvaa/nollaa) + jaksofokus_historia (append) yhdessä.
                      // Piirrokset Vaihe 1 · B2 (v3.14) — tt_positio_toissijainen: TOISSIJAINEN pelipaikka.
                      // Sama kenttäomistajuus ja sama portti kuin ensisijaisella (tt_positio_aktiivinen);
                      // pelipaikkakonseptit tarjotaan kummallekin. Fysioterapeutti EI saa tätä (ks. alla).
                      || (onOmaSeura(seuraId) && (onValmentajaRooli() || onJohtoRooli())
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['jaksofokus', 'tt_positio_aktiivinen', 'tt_positio_toissijainen', 'jaksofokus_historia']))
                      // Vaihe 7 (v3.11) — fysioterapeutti: fyysisen jakson sulku/arvio. VAIN jaksofokus +
                      // jaksofokus_historia (EI tt_positio_aktiivinen — ei kuulu fysioterapeutille). §4/§37.
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti'
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['jaksofokus', 'jaksofokus_historia']))
                      // FA-potentiaali (Scouting-linssi) — scoutin projektio uran katosta, VP/johto asettaa
                      // (_vpVoiMuokata; SA kattaa yllä). EI scout-roolia (myöhempi identiteettimuutos). Field-level:
                      // vain scout_potentiaali*-pikakentät (ei koske 5D/IDP:tä). ⏳ ODOTTAA CONSOLE-DEPLOYTA (§12).
                      || (onOmaSeura(seuraId) && onJohtoRooli()
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['scout_potentiaali', 'scout_potentiaali_taso', 'scout_potentiaali_huomiot', 'scout_potentiaali_pvm', 'scout_potentiaali_arvioija']));
        // GDPR (#96): pelaajan pääDocin poisto VAIN SA (client). Aiempi johto-client-delete poisti vain
        // pääDocin → JÄTTI orvoiksi alikokoelmat + ristiviitteet + Storage-media + Auth (GDPR-rikkomus,
        // spec §0.1/§0.5). Johto poistaa nyt RTBF-CF:n (poistaPelaajaGDPR) kautta, joka tekee TÄYDEN
        // recursiveDelete-siivouksen Admin SDK:lla (ohittaa Rules). Asiakas/anon/valmentaja: ei delete.
        allow delete: if onSuperAdmin();

        // ── Havainnot — pelaajan henkilökohtaiset ADAR-kortit ─────────────
        // read: + anonyymi PIN (Pelaaja-näkymä) + huoltaja (v2.3)
        // update: + anonyymi PIN, jotta pelaaja_lukenut-merkintä toimii (§13 P6)
        match /havainnot/{havaintoId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId))   // permissio-joukkulukko (johto ohittaa)
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                        || onAnonymous())
                        && luotuPaivitysKelpaa();                     // A5
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Tavoitteet (IDP-tavoitteet, Vaihe 2 — docs/MDT_RAPORTTI_SPEC §0) — valmentaja kirjaa omille pelaajilleen ──
        // read: SA | oma seura (VP/johto näkee kaikki, valmentaja oman joukkueen UI:ssa). create/update: SA |
        // oman seuran valmentaja (joukkuerajaus UI-tasolla kuten havainnot; Rules rajaa oman seuran valmentajaan).
        // delete: SA | johto. luotu-vartija A5. Pikakenttä tavoite_aktiivinen_kpl → pelaaja-dokumenttiin (pelaajat-update).
        match /tavoitteet/{tavoiteId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)) && luotuLuontiKelpaa();    // A5
          allow update: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)) && luotuPaivitysKelpaa();   // A5
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Reviewit — MDT-tarkistuskirjaukset (MDT_RAPORTTI / review-kadenssi) ──
        // create/update: johto (VP/UTJ/seurasihteeri) + oman seuran valmentaja + SA. delete: vain SA.
        // Pikakentät (review_viimeisin_pvm/-tyyppi) kirjoitetaan pelaaja-dokumenttiin → pelaajat-update-säännön piirissä.
        match /reviewit/{reviewId} {
          allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
          allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId);
          allow delete:         if onSuperAdmin();
        }

        // ── Päivittäiset kirjaukset (T/D/S/P) ─────────────────────────────
        // PÄÄTÖS 1: jokaisessa kirjauksessa lahde-kenttä (valmentaja|pelaaja|vanhempi|vp|talenttivalmentaja).
        // PÄÄTÖS 2: VP + talenttivalmentaja (oma seura) saavat kirjata eksplisiittisesti (sisältyvät jo
        //   onOmanSeuranValmentaja():iin — klausuulit selventävät policy-päätöksen); huoltaja saa kirjata
        //   U12-lapselle kun lahde=='vanhempi' (onU12Huoltaja).
        match /kirjaukset/{pvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()   // pelaaja kirjaa itse PIN-tilassa
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onAnonymous()
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId))
                        && luotuPaivitysKelpaa();                     // A5
        }

        // ── P7-c.4a — KULUTTAJA-NOTIFIKAATIOT (kalenterimuistutus/muutos/peruutus, NOTIFIKAATIOT_JA_MOBIILI.md §B) ──
        // CF (admin SDK) kirjoittaa; anon-PIN (pelaaja/vanhempi) lukee + merkitsee luetuksi OMAT. Anon-uid ≠ pelaajaId
        // → ei uid-skooppausta (sama laaja anon-malli kuin c.1/c.3). CREATE vain SA/CF → client (myös anon) EI voi
        // väärentää toisen notifia (turvakriittinen). Anon-update rajattu affectedKeysilla vain 'luettu'-merkintään.
        match /notifikaatiot/{notifId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId) || onAnonymous() || onLapsenHuoltaja(seuraId, pelaajaId);
          allow update: if onSuperAdmin()
                        || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luettu', 'luettu_pvm']));
          allow create: if onSuperAdmin();   // vain CF/SA (admin-SDK) — client ei väärennä
          allow delete: if onSuperAdmin();
        }

        // ── Tapahtumat (LEGACY — käytä mieluummin testitapahtumat) ────────
        match /tapahtumat/{tapahtumaId} {
          allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
          allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        }

        // ── IDP (kausikohtainen kehityssuunnitelma) ───────────────────────
        match /idp/{idpId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── VP-muistiinpanot per pelaajalle (v2.4) ────────────────────────
        // VP tekee muistiinpanon pelaajasta. Näkyvyys flaggeilla:
        // naytaValmentajalle: valmentaja-roolit saavat lukea
        // naytaPelaajalle:    anonyymi PIN-pelaaja saa lukea
        // Default: vain VP/UTJ/seurasihteeri näkevät.
        match /vp_muistiinpanot/{muistiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (resource.data.naytaValmentajalle == true
                            && onOmanSeuranValmentaja(seuraId))
                        || (resource.data.naytaPelaajalle == true
                            && onAnonymous());
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── Testitulokset (v2.6) — historiapohja-tuonti ──────────────────
        // Excel_Tuonti.html:n historia-moodi kirjoittaa tänne. Doc-ID on
        // muotoa {pvm}_{protokolla} (esim. "2026-05-13_tekniikkakilpailu")
        // jotta sama pelaaja samana päivänä eri protokollalla ei ylikirjoita.
        // Pelaaja näkee omat tuloksensa PIN-tilassa; huoltaja näkee lapsensa.
        match /testitulokset/{pvmProto} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          // Kirjoitus: VP/UTJ (johto) + testivastaava. EI seurasihteeri (valmennusdata).
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId);
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Biologinen ikä (v2.8) — Mirwald PHV -mittaushistoria ──────────
        // Testaus_v9 (kasvumittaus-protokolla) kirjoittaa tänne; doc-ID on
        // mittauspäivä (esim. "2026-05-25"). VP-pikakentät (phv_tila,
        // biologinenIka_viimeisin) kirjoitetaan suoraan pelaajadokumenttiin
        // (pelaajat-update sallii valmentajan, ei hasOnly-rajoitusta).
        // Pelaaja näkee oman PHV-tilansa PIN-tilassa; huoltaja näkee lapsensa.
        // Firestore EI periydy alikokoelmiin → oma blokki pakollinen (§17 #18).
        match /biologinen_ika/{mittausPvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Arviointi — Palloliitto-taksonomia, havaittu 1–5 (Vaihe 2b) ───
        // VP/valmentajan asiantuntija-arvio (aikuisten työkalu, §7.22): luku VAIN
        // SA + oman seuran henkilöstö — EI anon (pelaaja) eikä huoltaja (raaka
        // "Poor"-arvio ei näy lapselle/perheelle). Kirjoitus valmentaja/johto.
        // doc-ID = kausi ilman "/" (esim. 2026-27, §11). Pikakentät
        // (arviointi_havaittu/_pvm/_kehys) menevät pelaajadokumenttiin (jo sallittu).
        match /arviointi/{kausiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()));
          allow create: if onSuperAdmin()
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId)   // permissio-joukkulukko (johto ohittaa)
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── IDP-kausitavoite (Vaihe 3a, IDP-ydin) ────────────────────────
        // seurat/{sid}/pelaajat/{pid}/idp_kausi/{vuosi} → { tavoitteet: [tavoite-objekti] } (IDP_YDIN_SPEC §2).
        // Kirjoitus: johto + oman seuran valmentaja (§15-pattern, kuten arviointi). LUKU myös pelaajalle (PIN/anon):
        // kausitavoite JAETAAN pelaajalle 3c-peilissä (§7.22-turvallinen render) — eri kuin raaka arviointi (ei anon).
        // Pikakentät (idp_tila/idp_edistyma/idp_fokus) pelaajadokumenttiin (jo sallittu). doc-ID = vuosi ilman "/" (§11).
        match /idp_kausi/{vuosi} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()))
                        || onAnonymous();   // pelaaja lukee oman kausitavoitteensa (3c-peili)
          allow create: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        // IDP-kortti v2 §4 — PIN-pelaaja saa luoda OMAN sitoumuksensa jos dokkia ei vielä ole (vain pelaaja_sitoumus).
                        || (onAnonymous() && request.resource.data.keys().hasOnly(['pelaaja_sitoumus'])
                            && request.resource.data.pelaaja_sitoumus.vahvistettu_pvm == null);
          allow update: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        // IDP-kortti v2 §4 — PIN-pelaaja: OMA sitoumus (vain pelaaja_sitoumus + paivitetty). EI tavoitteita,
                        // EI VP-vahvistusta (vahvistettu_pvm pysyy nykyisenä/null — vain VP/johto asettaa sen).
                        || (onAnonymous()
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pelaaja_sitoumus', 'paivitetty'])
                            && request.resource.data.pelaaja_sitoumus.vahvistettu_pvm ==
                               (('pelaaja_sitoumus' in resource.data) ? resource.data.pelaaja_sitoumus.get('vahvistettu_pvm', null) : null));
          allow delete: if onSuperAdmin();
        }

        // ── Kehut — vanhemman lähettämä kehu pelaajalle (v2.3) ────────────
        // Yksityinen vanhempi → pelaaja -kanava. Valmentajalla EI lukuoikeutta:
        // pedagoginen suoja, kehu on perheen sisäinen viestintä.
        // Pelaaja PIN-tilassa (onAnonymous) saa lukea + kuitata 'nahty:true',
        // mutta EI muokata muita kenttiä → diff.affectedKeys.hasOnly([...]).
        match /kehut/{kehuId} {
          allow read:   if onSuperAdmin()
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onLapsenHuoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || (onAnonymous()
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['nahty', 'nahtyKlo'])))
                        && luotuPaivitysKelpaa();                     // A5
          allow delete: if onSuperAdmin();
        }

        // ── PALAUTTEET (v3.0) — valmentajan TKI-palaute pelaajalle ────────
        // Master_v16 Testit→Tulokset. nakyvyys:'pelaaja' → pelaaja (PIN +
        // huoltaja) näkee; 'vain_valmentaja' → vain seuran henkilöstö.
        // Doc-ID {pvm}_tki. Firestore ei periydy → oma blokki (§17 #18).
        match /palautteet/{palauteId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || (resource.data.nakyvyys == 'pelaaja'
                            && (onAnonymous() || onLapsenHuoltaja(seuraId, pelaajaId)));
          allow create: if onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId);   // permissio-joukkulukko (johto ohittaa)
          allow update: if onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KAYTTAJAT (seuran henkilöstö — Henkilöstö-näkymä) ─────────────
      // Pikakentät (harjoituslaatu_/valmennustaito_, §26) kirjoitetaan tänne: oma UID (itsearvio) tai johto (havainnointi).
      // Ei-SA-päivitys EI saa muuttaa rooli/seuraId-kenttiä (roolinvaihto vain vaihdaKayttajanRooli-CF:n kautta, §13).
      match /kayttajat/{uid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || request.auth.uid == uid;
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin()
                      || (( (onOmaSeura(seuraId) && onJohtoRooli()) || request.auth.uid == uid )
                          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rooli', 'seuraId']));
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── REFLEKTIOT (Vaihe 2.3b-1) — valmentajan OMA yksityinen kasvupäiväkirja (standalone-merkinnät + ääni).
        // VAIN oma uid + SA. Johto/VP EI lue (eroaa arviointiin sidotusta reflektiosta, joka näkyy harjoitusarvioinnit-dokissa).
        // Rules eivät periydy → oma blokki. Ääni Storagessa (oma Storage-ruleset, polku peilaa tätä).
        match /reflektiot/{reflId} {
          allow read, write: if onSuperAdmin() || request.auth.uid == uid;
        }

        // ── NOTIFIKAATIOT (N1, NOTIFIKAATIOT_JA_MOBIILI.md §B) — in-app notifit.
        // Client lukee + merkitsee luetuksi VAIN omat; CREATE vain CF (admin-SDK ohittaa Rules) → client ei voi väärentää
        // toisen notifia. Rules eivät periydy → oma blokki.
        match /notifikaatiot/{notifId} {
          allow read, update: if onSuperAdmin() || request.auth.uid == uid;
          allow create:       if onSuperAdmin();   // vain CF/SA — normaali client ei luo
          allow delete:       if onSuperAdmin();
        }
      }

      // ── HAVAINNOT (seurataso — pelaajatasolle ks. pelaajat/{id}/havainnot) ──
      match /havainnot/{havaintoId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── JOUKKUEET ──────────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // ── kalenteri/{kalenteriId} (v2.7) ────────────────────────────────
        // Testaus_v8._tallennaTapahtuma kirjoittaa tänne pikaviittauksen
        // luodusta testitapahtumasta (tyyppi:'testi', ref, pvm, nimi…).
        // Sallittu valmentaja-rooleille kaikkien seuran sisällä.
        match /kalenteri/{kalenteriId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── harjoitusprioriteetti/{id} (v3.0) ─────────────────────────────
        // Master_v16: valmentaja asettaa joukkueen harjoitusprioriteetin
        // testidatasta (doc 'aktiivinen'). Koko seura lukee (Tänään-fokus +
        // mahdollinen Pelaaja-näkymä). Firestore ei periydy → oma blokki.
        match /harjoitusprioriteetti/{prioriteettiId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId) || onAnonymous();
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KUTSUT ────────────────────────────────────────────────────────
      match /kutsut/{kutsuId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || resource.data.tila == 'odottaa';
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── ADAR (seurataso — peliäly-arvioinnit) ──────────────────────────
      match /adar/{adarId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
      }

      // ── MENTOROINNIT ───────────────────────────────────────────────────
      match /mentoroinnit/{mentorointiId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin()
                     || (onOmaSeura(seuraId)
                         && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
      }

      // ── ERRORS (seurataso) ─────────────────────────────────────────────
      match /errors/{errorId} {
        allow read:           if onSuperAdmin();
        allow create:         if onKirjautunut() && onOmaSeura(seuraId);
        allow update, delete: if onSuperAdmin();
      }

      // ══════════════════════════════════════════════════════════════════
      // v2.3 — UUDET ALIKOKOELMAT
      // ══════════════════════════════════════════════════════════════════

      // ── TESTITAPAHTUMAT (CLAUDE.md §17 #19, §23) ──────────────────────
      // Korvaa vanhentuneen pelaajat/{id}/testit-rakenteen.
      // Kirjoittajat: Testaus_v8, Harjoitettavuus_Lomake_v4, Excel_Tuonti
      match /testitapahtumat/{tapahtumaId} {
        allow read:   if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // tulokset/{pelaajaId} — pelaajakohtaiset testitulokset.
        // Huoltaja näkee oman lapsen tulokset (IDP_Kortti_v4 lukee tätä).
        match /tulokset/{pelaajaId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onAnonymous()
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── TAPAHTUMAT (seurataso, v2.9) — yleistapahtumat + mentoroinnit ──
      // VP_v22 mentorointi-pikamalli (tyyppi:'mentorointi') + Master_v16
      // yleistapahtumat (harjoitus/ottelu/kokous). EI sama kuin pelaajatason
      // legacy /pelaajat/{id}/tapahtumat eikä testitapahtumat.
      match /tapahtumat/{tapahtumaId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── VP_KALENTERI (v2.9) — VP:n deadlinet ja muistutukset (amber) ───
      match /vp_kalenteri/{id} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── SEURANTA_KUITTAUKSET (Vaihe C) — VP:n hälytyskuittaukset (audit-jälki). ─────
      // VP-seurantanäkymä: johto kuittaa valmentajan hälytyksen (Ei havaintoja 30pv ym.).
      // Kirjoitus = VP/johto (onJohtoRooli); luku = oman seuran jäsenet (oversight).
      // EI hard-deletea (audit-linja) → delete vain SA. Valmentaja EI saa kuitata itseään.
      match /seuranta_kuittaukset/{kuittausId} {
        allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
        allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete:         if onSuperAdmin();
      }

      // ── KALENTERI (v3.5) — seuran pääkalenteri (KALENTERI_ARKKITEHTUURI.md §3/§7) ──
      // Korvaa legacy tapahtumat + vp_kalenteri + joukkueet/{jid}/kalenteri yhdellä
      // kokoelmalla. Kaikki tapahtumatyypit: testi, ottelu, harjoitus, palaveri,
      // mentorointi, kalibraatiopaja, IDP-seuranta, talenttileiri, muu.
      //
      // Omistajuus (v3.5): johto = täysi CRUD; valmentaja/talenttivalmentaja = täysi
      // muokkaus OMIIN (luoja_uid == auth.uid), MUIDEN tapahtumiin vain field-level
      // (muistiinpanot + läsnäolo-kooste + audit). Soft-delete: poistettu=true, EI hard-deletea.
      match /kalenteri/{tapahtumaId} {
        // P7-c.1: anon-luku (PIN-pelaaja/vanhempi näkee seuran aikataulun). Peilaa pelaajat-dokin anon-read-mallia
        // — anonyymillä ei ole seuraId-claimia Rules-skooppaukseen → luku on laaja; joukkue-/roster-suodatus tehdään
        // APPISSA (query), ei Rulesissa (sama tietoinen kompromissi kuin pelaajat/harjoitusprioriteetti). Write ENNALLAAN.
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId))
                      || onAnonymous();

        // Luonti: VP/johto (vapaa) TAI valmentajarooli joka asettaa luoja_uid == oma uid.
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && request.resource.data.luoja_uid == request.auth.uid);

        // Päivitys:
        //  · SA / johto → kaikki
        //  · valmentaja OMAAN tapahtumaan (luoja_uid == uid) → kaikki
        //  · valmentaja MUIDEN tapahtumaan → vain field-level
        //    (muistiinpanot + läsnäolo-kooste + aikaleima; EI soft-deletea/nimeä/aikaa muille).
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.luoja_uid == request.auth.uid)
                      || (onOmanSeuranValmentaja(seuraId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['muistiinpanot', 'paivitetty', 'muokkaaja_uid',
                                       'lasnaolo_kooste', 'valmentaja_rpe', 'valmentaja_rpe_pvm']));

        // Ei hard-deletea — soft-delete (poistettu:true) update-kautta
        allow delete: if onSuperAdmin();

        // ── Läsnäolijat (alikokoelma) — KALENTERI_ARKKITEHTUURI.md §7 ──
        // Valmentaja/johto merkitsee läsnäolon per pelaaja (osallistujaId = pelaajaId).
        // Pelaaja vahvistaa OMAN läsnäolonsa (uid == osallistujaId).
        match /lasnaolijat/{osallistujaId} {
          allow read:   if onSuperAdmin()
                        || (onKirjautunut() && onOmaSeura(seuraId))
                        || onAnonymous();   // P7-c.1: PIN-pelaaja/vanhempi näkee läsnäolon (oma poissaolo-write vasta c.3)
          // P7-c.3 + RSVP-erotus: PIN-pelaaja/vanhempi (anon) ilmoittaa oman SAATAVUUTENSA (RSVP: tulossa/estynyt).
          // Anon-token ei kanna pelaajaId:tä (uid ≠ osallistujaId) → ei uid-skooppausta; laaja anon-luottamusmalli
          // rajattuna affectedKeysilla VAIN saatavuus (+ paivitetty/rooli). ⚠️ Turvaparannus: anon EI voi kirjoittaa
          // 'tila':aa (= valmentajan TOTEUTUNUT läsnäolo) → pelaaja ei voi väärentää läsnäoloaan. Ei syytä (GDPR Art. 9).
          // create: resource.data == null → diff ei toimi → keys().hasOnly. update: diff().affectedKeys().hasOnly.
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && request.auth.uid == osallistujaId)
                        || (onAnonymous() && request.resource.data.keys().hasOnly(['saatavuus', 'paivitetty', 'rooli']));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && request.auth.uid == osallistujaId)
                        || (onAnonymous() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saatavuus', 'paivitetty', 'rooli']));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── IDP_JONO — IDP-aktivointiehdotusten jono ──────────────────────
      // Valmentaja ehdottaa IDP:tä → VP/UTJ hyväksyy. Valmentaja saa
      // muokata omaa ehdotustaan niin kauan kuin tila on 'ehdotettu' tai
      // 'odottaa' (v2.5 — uusi standardi käyttöön rinnakkain vanhan kanssa).
      match /idp_jono/{idpId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.tila in ['ehdotettu', 'odottaa']
                          && resource.data.valmentajaUid == request.auth.uid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── META — VP:n metadatakanava (Sprint 3) ─────────────────────────
      // Esim. phv_snapshot — kasvuvaiheessa olevien pelaajien lukumäärä
      // viime laskennalta, jotta renderSignals voi tunnistaa kasvun.
      // Koko seura lukee (signaali näkyy myös valmentajalle), VP/UTJ
      // /seurasihteeri kirjoittaa.
      match /meta/{metaKey} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── OHJELMAT — fysiikkaohjelmakirjasto (Vaihe 7.2a, v3.12) ─────────
      // Deterministinen kirjasto: tallenna/versioi/arkistoi fyysiset ohjelmat, liitä jaksoon.
      // Kirjoitus: oman seuran valmentajaroolit (sis. fysiikkavalmentaja) + fysioterapeutti + johto.
      // Luku: oma seura. KOVA DELETE ESTETTY — arkistointi = update (arkistoitu:true). §6.
      match /ohjelmat/{ohjelmaId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin()
                      || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti')
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin()
                      || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti')
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }

      // ── VALMENTAJAT — valmentajan oma datatila (CLAUDE.md §10) ────────
      match /valmentajat/{valmentajaUid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // valmentajat/{uid}/kontribuutio/{palloID} — pelaajakohtainen vaikutus
        match /kontribuutio/{palloID} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // valmentajat/{uid}/tuloskortti/{tuloskorttiId} — VP arvioi valmentajaa
        match /tuloskortti/{tuloskorttiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── VIESTIT — seuran sisäiset viestit ─────────────────────────────
      // Lähettäjä + vastaanottaja näkevät. Vastaanottaja saa muokata
      // (luku-merkintä). Vain super admin saa poistaa (audit-jälki).
      match /viestit/{viestiId} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && (request.auth.uid == resource.data.vastaanottajaUid
                              || request.auth.uid == resource.data.lahettajaUid
                              || onJohtoRooli()));
        allow create: if (onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && onKirjautunut()
                          && request.resource.data.lahettajaUid == request.auth.uid))
                      && aikaLuontiKelpaa();                          // A5-jälki
        allow update: if (onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && request.auth.uid == resource.data.vastaanottajaUid))
                      && aikaPaivitysKelpaa();                        // A5-jälki
        allow delete: if onSuperAdmin();
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // KÄYTTÄJÄT — ylätason profiilit
    // ──────────────────────────────────────────────────────────────────────
    match /kayttajat/{uid} {
      allow read:  if onSuperAdmin() || request.auth.uid == uid;
      allow write: if onSuperAdmin() || request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // SUOSTUMUKSET — ylätaso (Rekisterointi_Suostumus.html kirjoittaa)
    // ──────────────────────────────────────────────────────────────────────
    match /suostumukset/{suostumusId} {
      allow read:   if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow create: if true;  // suostumuslomake on julkinen
      allow update: if onSuperAdmin()
                    || request.auth.uid == suostumusId
                    || resource.data.suostumusTila == 'odottaa';
      allow delete: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // ERRORS — ylätason virheloki
    // ──────────────────────────────────────────────────────────────────────
    match /errors/{errorId} {
      allow read:           if onSuperAdmin();
      allow create:         if onKirjautunut();
      allow update, delete: if onSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // SOLO PLAYER™ (P0) — ERILLINEN LOHKO klubin seurat/-puusta.
    // Vanhempi omistaa (parent_uid == auth.uid). SOLO_P0_TIETOMALLI_SPEC.md §4.
    // ÄLÄ sekoita klubin Rulesiin. (Polku B: lupapyynnot + lapsi-PIN = PR 2.)
    // ══════════════════════════════════════════════════════════════════════
    // Vanhemman tili (doc-id = Firebase Auth uid)
    match /parents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Solo-pelaaja (litteä) — vain omistava vanhempi (P0).
    match /players/{playerId} {
      // Vanhempi: täysi omistus. Lapsi (anonymous, Polku B): single-doc GET + rajattu UPDATE omaan
      // dokkiin (child_pin). PlayerCode/playerId resolvoidaan lupapyynnöstä → ei enumeraatiota.
      // EI list anonyymille (estää koko players-kokoelman luvun). SOLO_P0_SPEC §9.
      allow get:    if (request.auth != null && request.auth.uid == resource.data.parent_uid)
                    || (onAnonymous() && resource.data.child_pin != null);
      allow list:   if request.auth != null && request.auth.uid == resource.data.parent_uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.parent_uid;
      allow update: if (request.auth != null && request.auth.uid == resource.data.parent_uid)
                    || (onAnonymous() && resource.data.child_pin != null
                        && request.resource.data.parent_uid == resource.data.parent_uid
                        && request.resource.data.child_pin  == resource.data.child_pin
                        && request.resource.data.playerCode == resource.data.playerCode
                        && request.resource.data.seuraId    == resource.data.seuraId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.parent_uid;
      // Alikokoelmat (tkk_historia, suostumukset) — omistajuus pelaajadokin parent_uid:sta
      match /{sub=**} {
        allow read, write: if request.auth != null
                           && get(/databases/$(database)/documents/players/$(playerId)).data.parent_uid == request.auth.uid;
      }
    }
    // PlayerCode-indeksi (club-bridge, P2-valmis) — luo oma vanhempi; luku kirjautuneelle.
    match /playerCodes/{code} {
      allow create:         if request.auth != null && request.auth.uid == request.resource.data.parent_uid;
      allow read:           if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.parent_uid;
    }
    // Lupapyynnöt (Polku B) — lapsi luo, vanhempi hyväksyy VAIN CF:ssä (Admin SDK). SOLO_P0_SPEC §9.
    // ── KAAVIOT · KANONINEN KERROS (v3.6) ────────────────────────────────────────────
    // kaaviot/{avain} — jaettu curriculum-sisältö (avain = curriculum-avain, sama kaikille
    // seuroille → EI duplikointia seuroittain). 109-generoinnin kohde (erä D).
    // Luku kaikille kirjautuneille (ml. PIN-pelaaja); kirjoitus VAIN super_adminille.
    match /kaaviot/{avain} {
      allow read:  if onKirjautunut();
      allow write: if onSuperAdmin();
    }

    match /lupapyynnot/{requestId} {
      allow create:         if request.resource.data.status == 'odottaa';   // requestId arvaamaton (UUID); rate-limit CF:ssä
      allow get:            if true;                                          // lapsen laite pollaa OMAA requestId:tä (token vain hakijalla)
      allow list:           if false;                                        // ei enumeraatiota
      allow update, delete: if false;                                        // VAIN CF (Admin SDK) hyväksynnässä/hylkäyksessä
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    // APUFUNKTIOT — yhtenäinen tarkistuslogiikka koko tiedostossa
    // Muutos: lisätty onOmaUid() + onSeuranJasenJaSeuraId()
    // ════════════════════════════════════════════════════════════

    function onKirjautunut() {
      return request.auth != null;
    }

    function onSuperAdmin() {
      return onKirjautunut() &&
        request.auth.token.rooli == 'super_admin';
    }

    function onRooli(rooli) {
      return onKirjautunut() &&
        request.auth.token.rooli == rooli;
    }

    function onSeuranJasen(seuraId) {
      return onKirjautunut() &&
        request.auth.token.seuraId == seuraId;
    }

    // ── UUSI: Tarkistaa että käyttäjä on oma UID ─────────────────
    // Korjaa: admins-kokoelma oli allow read: if true
    function onOmaUid(uid) {
      return onKirjautunut() && request.auth.uid == uid;
    }

    // ── UUSI: Yhdistelmätarkistus kirjoituksiin ───────────────────
    // Korjaa: cross-tenant ongelma — käyttäjä ei voi kirjoittaa
    // toisen seuran seuraId:llä vaikka olisi kirjautunut
    function onSeuranJasenJaSeuraId(seuraId) {
      return onSeuranJasen(seuraId) &&
        request.resource.data.seuraId == seuraId;
    }

    function onPelaajaAnon(seuraId, pelaajaId) {
      return onKirjautunut() &&
        get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.suostumus == true;
    }

    // ════════════════════════════════════════════════════════════
    // ADMINS — KRIITTINEN KORJAUS
    // Ennen: allow read, write: if onSuperAdmin()
    //        → super admin kirjoittaa, mutta luku oli auki kaikille
    // Jälkeen: luku vain omalle UID:lle, kirjoitus vain super adminille
    // ════════════════════════════════════════════════════════════
    match /admins/{uid} {
      // Vain oma uid voi lukea oman admin-dokumentin
      allow read:  if onOmaUid(uid) || onSuperAdmin();
      // Vain super admin voi luoda/muokata admin-dokumentteja
      allow write: if onSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // SEURAT
    // Ennen: allow read: if true  ← kuka tahansa luki koko seuran
    // Jälkeen: luku vain kirjautuneille seuran jäsenille
    // ════════════════════════════════════════════════════════════
    match /seurat/{seuraId} {
      // KORJAUS: oli "if true" — nyt vaaditaan kirjautuminen
      allow read: if onKirjautunut() && onSeuranJasen(seuraId)
                  || onSuperAdmin();
      allow write: if onKirjautunut() && (
        onRooli('vp') && onSeuranJasen(seuraId) ||
        onRooli('seurasihteeri') && onSeuranJasen(seuraId)
      ) || onSuperAdmin();

      // ── Joukkueet ────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId)
                    || onSuperAdmin();
        allow write: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        // ── Kayttajat ──────────────────────────────────────────
        match /kayttajat/{kayttajaId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId)
                      || onSuperAdmin();
          allow write: if onKirjautunut() && (
            onRooli('vp') || onRooli('seurasihteeri')
          ) && onSeuranJasen(seuraId) || onSuperAdmin();
        }
      }

      // ── Pelaajat ─────────────────────────────────────────────
      match /pelaajat/{pelaajaId} {
        allow read: if (
          onKirjautunut() && onSeuranJasen(seuraId)
        ) || (
          onKirjautunut() && onRooli('pelaaja') &&
          request.auth.uid == pelaajaId
        ) || onSuperAdmin();

        allow create: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        // KORJAUS: lisätty seuraId-validointi — estää cross-tenant kirjoitukset
        allow update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja') ||
          onRooli('talenttivalmentaja') || onRooli('fysiikkavalmentaja') ||
          onRooli('fysioterapeutti') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        allow delete: if onRooli('vp') && onSeuranJasen(seuraId)
                      || onSuperAdmin();

        // ── Kirjaukset ────────────────────────────────────────
        match /kirjaukset/{paiva} {
          allow read: if (
            onKirjautunut() && onSeuranJasen(seuraId)
          ) || (
            onKirjautunut() && request.auth.uid == pelaajaId
          ) || onSuperAdmin();

          // KORJAUS: lisätty seuraId-tarkistus kirjoitukseen
          allow create, update: if onKirjautunut()
            && onSeuranJasen(seuraId)
            || onSuperAdmin();
        }
      }

      // ── Havainnot ────────────────────────────────────────────
      match /havainnot/{havaintoId} {
        allow read: if (
          onKirjautunut() && onSeuranJasen(seuraId)
        ) || (
          onKirjautunut() &&
          get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(resource.data.pelaajaId)).data.suostumus == true
        ) || onSuperAdmin();

        // KORJAUS: vaaditaan seuraId täsmäämään — cross-tenant esto
        allow create, update: if onKirjautunut() && (
          onRooli('valmentaja') || onRooli('talenttivalmentaja')
        ) && onSeuranJasen(seuraId)
          && request.resource.data.seuraId == seuraId
          || onSuperAdmin();
      }

      // ── Harjoitukset ─────────────────────────────────────────
      match /harjoitukset/{harjoitusId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Merkinnät ────────────────────────────────────────────
      match /merkinnat/{merkintaId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        // KORJAUS: seuraId-validointi
        allow create, update: if onKirjautunut() && onSeuranJasen(seuraId)
          && request.resource.data.seuraId == seuraId || onSuperAdmin();
      }

      // ── Tapahtumat ───────────────────────────────────────────
      match /tapahtumat/{tapahtumaId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
        allow delete: if onRooli('vp') && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Kartoitukset ─────────────────────────────────────────
      match /joukkueet/{joukkueId}/kartoitukset/{kartoitusId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Kehitystavoitteet ────────────────────────────────────
      match /joukkueet/{joukkueId}/kehitystavoitteet/{kausi} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('urheilutoimenjohtaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── DNA-konfiguraatio ────────────────────────────────────
      match /dna_konfig/{konfigId} {
        allow read:  if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow write: if onKirjautunut() && (
          onRooli('vp') || onRooli('urheilutoimenjohtaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }
    }
  }
}

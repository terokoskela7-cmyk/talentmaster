//
// Muutokset v2.1.0 → v2.3:
//   + onLapsenHuoltaja(seuraId, pelaajaId) — vanhempi tunnistetaan
//     huoltajaEmail-kentän kautta (case-insensitive vertailu)
//   + Vanhemman luku lisätty: pelaajat, havainnot, kirjaukset, idp,
//     testitapahtumat/tulokset
//   + kehut/{kehuId} — vanhempi luo, pelaaja lukee + kuittaa nahty-kentän
//   + testitapahtumat/{id} + tulokset/{pelaajaId}  (CLAUDE.md §17 #19, §23)
//   + idp_jono/{id}
//   + valmentajat/{uid} + kontribuutio + tuloskortti
//   + viestit/{viestiId}
//
// Säilyy v2.1.0:sta:
//   • Anonyymi (PIN) saa lukea seurat/{id}/pelaajat + havainnot
//   • Super admin: rooli=='super_admin' TAI admins/{uid} exists
//   • Legacy claim 'superadmin' tuettu rinnakkain (CLAUDE.md §24)
//   • Pelaajatason kayttajat-alikokoelma VP:lle (Henkilöstö-näkymä)
//   • Jokainen alikokoelma omalla match-blokilla (§17 #18 — ei periydy)
// ══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // APUFUNKTIOT
    // ──────────────────────────────────────────────────────────────────────
    function onKirjautunut() {
      return request.auth != null;
    }

    /* H1 — Palloliiton arvioija. Palauttaa false, kunnes palloliitto/kayttajat/{uid} on luotu,
       joten tama on turvallinen deployata jo ennen kuin kayttajia on (brief §3). */
    function onPalloliitto() {
      return request.auth != null
          && exists(/databases/$(database)/documents/palloliitto/kayttajat/$(request.auth.uid));
    }

    function onSuperAdmin() {
      return request.auth.token.rooli == 'super_admin'
          || request.auth.token.rooli == 'superadmin'   // legacy (CLAUDE.md §24)
          || request.auth.token.super_admin == true
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onOmaSeura(seuraId) {
      return request.auth.token.seuraId == seuraId;
    }

    /* v3.25 — PELAAJAN OMA IDENTITEETTI (Vaihe 0 / PR 1). Token tulee palvelimelta
       (`pelaajaKirjaudu`, PalloID + PIN): { rooli:'pelaaja', pelaajaSeuraId, pelaajaId }.
       ⚠ Claim on `pelaajaSeuraId`, EI `seuraId`: onOmaSeura() lukee pelkän token.seuraId:n, ja moni
       lukusääntö on muotoa onKirjautunut() && onOmaSeura(seuraId) ilman roolitarkistusta — seuraId-claim
       avaisi pelaajalle koko seuran (myös valmentajien havainnot). .get() → puuttuva claim ei kaada. */
    function onPelaaja() {
      return request.auth != null
          && request.auth.token.get('rooli', '') == 'pelaaja'
          && request.auth.token.get('pelaajaSeuraId', '') is string
          && request.auth.token.get('pelaajaId', '') is string;
    }
    function onPelaajaItse(seuraId, pelaajaId) {
      return onPelaaja()
          && request.auth.token.pelaajaSeuraId == seuraId
          && request.auth.token.pelaajaId == pelaajaId;
    }
    function onPelaajanSeura(seuraId) {
      return onPelaaja() && request.auth.token.pelaajaSeuraId == seuraId;
    }

    // v3.43 — kuka lukee seuran julkiset liput (seurat/{id}/liput/*): SA, oman seuran henkilökunta, oman seuran pelaaja. K5: lisää huoltaja tähän (esim. || onSeuranHuoltaja(seuraId)).
    function onLiputLuku(seuraId) {
      return onSuperAdmin()
          || (onKirjautunut() && onOmaSeura(seuraId))
          || onPelaajanSeura(seuraId);
    }

    /* v3.26 — SOLO-LAPSEN OMA IDENTITEETTI (Vaihe 0 / PR 2b). Token `soloLapsiKirjaudu`-funktiolta
       (playerCode + PIN): { rooli:'solo_lapsi', soloPlayerId }. Ei seuraId/pelaajaSeuraId/pelaajaId
       → ei läpäise onOmaSeura/onPelaaja-haaroja. Käytössä VAIN players/{playerId}-blokissa. */
    function onSoloLapsiItse(playerId) {
      return request.auth != null
          && request.auth.token.get('rooli', '') == 'solo_lapsi'
          && request.auth.token.get('soloPlayerId', '') == playerId;
    }

    function onValmentajaRooli() {
      // HUOM: seurasihteeri + testivastaava POISTETTU tästä (2026-06-05) — ne eivät saa
      // broad valmennusdata-kirjoitusta. Rajatut oikeudet onSeuraSihteeri/onTestivastaava-kautta.
      return request.auth.token.rooli in [
        'valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja',
        'vp', 'urheilutoimenjohtaja'
      ];
    }

    function onJohtoRooli() {
      return request.auth.token.rooli in [
        'vp', 'urheilutoimenjohtaja', 'seurasihteeri'
      ];
    }

    // Seurakerros TIER 1 — kuka saa muokata seuran konseptikieltä (kaanonin override).
    // TARKOITUKSELLA KAPEAMPI kuin onJohtoRooli(): seurasihteeri on hallinnollinen rooli,
    // ei pedagoginen. VP (Fotbollsutvecklare) / urheilutoimenjohtaja (Head of Talent) omistavat
    // seuran konseptikielen; valmentaja valitsee konseptin ja asettaa pelaajatavoitteet (TIER 2).
    function onKonseptiMuokkaaja(seuraId) {
      return onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja'];
    }

    // (Seurasihteerin oikeudet hoituvat onJohtoRooli():n kautta — erillinen onSeuraSihteeri
    //  poistettu 2026-06-08 käyttämättömänä; kompilaattori varoitti unused + invalid 'request'.)

    // Testivastaava — kirjoittaa VAIN testitapahtumat + testitulokset, lukee pelaajaprofiilit.
    function onTestivastaava(seuraId) {
      return request.auth.token.rooli == 'testivastaava' && onOmaSeura(seuraId);
    }

    function onOmanSeuranValmentaja(seuraId) {
      return onOmaSeura(seuraId) && onValmentajaRooli();
    }

    // ── KAAVIOT (v3.6) ────────────────────────────────────────────────────────────────
    // Hyväksyjä on TAHALLAAN kapeampi kuin onJohtoRooli(): se sisältäisi seurasihteerin,
    // joka ei ole valmennusrooli eikä saa hyväksyä valmennussisältöä.
    function onKaavioHyvaksyja() {
      return request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja'] || onSuperAdmin();
    }
    function kaavioTila(d)      { return d.get('review', {}).get('status', 'luonnos'); }
    function kaavioJoukkue(d)   { return d.get('review', {}).get('joukkueId', null); }
    // NÄKYVYYSTASON ROOLILUKKO. Hallintomalli: valmentaja luo ja kohdistaa OMAN joukkueensa
    // sisältöä; seuran yhteisen kirjaston kuratoi metodologiajohto (VP/urheilutoimenjohtaja/SA).
    // Puuttuva kenttä tulkitaan 'seura'ksi — lupaportti on FAIL-CLOSED: määrittelemätön näkyvyys
    // ei saa olla helpompi reitti kuin eksplisiittinen.
    function kaavioNakyvyys(d) { return d.get('review', {}).get('nakyvyys', 'seura'); }
    // Luonti: seuratason saa asettaa vain hyväksyjä. 'valmentaja' on HENKILÖSTÖREITITYS (kenelle
    // valmentajalle kuva annetaan käytettäväksi), ei pelaajayleisö — se ei laajenna pelaajien
    // näkyvyyttä lainkaan (lib/tm_kaavio_policy.js kaavioKohdistuu → false), joten sen asettaminen
    // ei vaadi hyväksyjää sen enempää kuin joukkue/pelaaja-kohdistuskaan.
    function kaavioNakyvyysLuontiOk() {
      return kaavioNakyvyys(request.resource.data) in ['joukkue', 'pelaaja', 'valmentaja'] || onKaavioHyvaksyja();
    }
    // Muokkaus: portti koskee NOSTOA seuratasolle, ei absoluuttista arvoa. Jos kaavio on JO
    // seuratasoinen, valmentaja saa yhä muokata sen sisältöä oman joukkuerajauksensa puitteissa —
    // muuten VP:n hyväksymän kaavion pieninkin korjaus olisi yhtäkkiä kielletty. Laskeminen
    // seuratasolta joukkue/pelaaja-tasolle on sallittua (se kaventaa näkyvyyttä, ei laajenna).
    function kaavioNakyvyysMuutosOk() {
      return kaavioNakyvyys(request.resource.data) != 'seura'
          || kaavioNakyvyys(resource.data) == 'seura'
          || onKaavioHyvaksyja();
    }
    // Sallitut statussiirrot. Suora luonnos→hyvaksytty on KIELLETTY (katselmus ei saa ohittua).
    function kaavioSiirtoOk(vanha, uusi) {
      return uusi == vanha
          || (vanha == 'luonnos'    && uusi == 'odottaa')
          || (vanha == 'hylatty'    && uusi == 'odottaa')
          || (vanha == 'hyvaksytty' && uusi == 'odottaa')
          || (vanha == 'odottaa'    && (uusi == 'hyvaksytty' || uusi == 'hylatty') && onKaavioHyvaksyja());
    }
    // Uudelleenhyväksyntä: hyväksytyn kaavion muokkaus pudottaa sen takaisin odottamaan,
    // PAITSI jos muokkaaja on jo hyväksyntävaltuutettu (itse-kierros ei lisää kontrollia).
    function kaavioUudelleenhyvaksyntaOk(vanha, uusi) {
      return vanha != 'hyvaksytty' || onKaavioHyvaksyja() || uusi == 'odottaa';
    }
    // OPTIMISTINEN VERSIOLUKKO (v3.7). Kaavio on kokonaisuutena korvattava dokumentti: spec
    // kirjoitetaan aina kokonaan, joten hiljainen ylikirjoitus menettäisi KOKO toisen piirroksen.
    // Client lukee versio:n auki avatessaan ja kirjoittaa +1; jos toinen ehti väliin, resource on
    // jo kasvanut → tämä ehto kaatuu ja client joutuu lataamaan uudelleen. Vain TÄSMÄLLEEN +1:
    // hyppy ohittaisi välissä tehdyn muutoksen, lasku palauttaisi vanhan tilan.
    // YKSITYINEN LUONNOS (v3.16). "Ei vielä valmis", EI valmentajien välinen piilotus: seuran
    // sisäinen näkyvyys on tarkoituksellista ja palaa heti julkaisusta (review.yksityinen=false).
    // Puuttuva kenttä = julkinen → vanhat luonnokset eivät katoa kenenkään näkyvistä.
    // Hyväksytty ei voi olla yksityinen: katselmuksen läpäissyt on määritelmällisesti julkaistu.
    function kaavioYksityinen(d) {
      return d.get('review', {}).get('yksityinen', false) == true
          && kaavioTila(d) != 'hyvaksytty';
    }
    function kaavioTekija(d) { return d.get('review', {}).get('luonut', null); }
    // ⚠ PÄÄTÖS JOTA EI OLE VAHVISTETTU: näkeekö johto (VP/UTJ) keskeneräiset? Tässä TIUKEMPI
    // linja — EI näe, koska "yksityinen" tarkoittaa ei valmista KENELLEKÄÄN. SA näkee (ylläpito,
    // oma haara allow readissä). Jos johto tarvitsee oversightin, muutos on tämä yksi ehto +
    // lib/tm_kaavio_policy.js kaavioVoiLukea — molemmat merkitty samalla kommentilla.
    // Doc-parametrinen, koska kommentti-alikokoelman on kysyttävä EMOKAAVIOSTA: alikokoelmassa
    // resource.data on kommentti, ei kaavio.
    function kaavioLukuOkDoc(d) {
      return !kaavioYksityinen(d) || kaavioTekija(d) == request.auth.uid;
    }
    function kaavioLukuOk() { return kaavioLukuOkDoc(resource.data); }

    function kaavioVersio(d) { return d.get('review', {}).get('versio', 0); }
    function kaavioVersioOk() {
      return kaavioVersio(request.resource.data) == kaavioVersio(resource.data) + 1;
    }

    // Permissio-joukkulukko — valmentajan oma joukkue säännöistä (self-contained, rules-get; ei claims-riippuvuutta).
    // kayttajat/{uid}.joukkueet = ID-lista (Seura-näkymä; VP:llä tyhjä → hoitaa kaikkia johto-ohituksella).
    function valmentajanJoukkueet(seuraId) {
      return get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.get('joukkueet', []);
    }
    /* v3.58 (K35-6d): kalenteri-dokin tyyppikohtaiset kirjoitusehdot. d = request.resource.data (create/update-uusi) tai resource.data (update-vanha). */
    function kalTyyppi(d) { return d.get('tyyppi', '').lower().trim(); }
    function kalOnSeuranTauko(d) { return kalTyyppi(d) in ['seuran_tauko', 'tauko', 'loma']; }
    function kalOnJoukkueenOma(d) { return kalTyyppi(d) in ['joukkueen_vapaa', 'erikoisohjelma']; }
    function kalOnJoukkue(d) { return d.get('joukkue', null) is string && d.get('joukkue', '').size() > 0; }
    function kalOmaJoukkue(seuraId, d) {
      return onJohtoRooli() || request.auth.token.rooli == 'talenttivalmentaja'
          || (kalOnJoukkue(d) && valmentajanJoukkueet(seuraId).hasAny([d.joukkue]));
    }
    function kalTyyppiSaaKirjoittaa(seuraId, d) {
      return onSuperAdmin() || ((!kalOnSeuranTauko(d) || onJohtoRooli())
          && (!kalOnJoukkueenOma(d) || (kalOnJoukkue(d) && kalOmaJoukkue(seuraId, d))));
    }
    // Valmentaja saa kirjoittaa VAIN oman joukkueensa pelaajiin (ID-täsmäys pelaajan joukkueet[] ∩ valmentajan joukkueet[]).
    // Joukkuerajauksen OHITTAA → koko seura (seura-lukko onOmanSeuranValmentaja säilyy silti):
    //   · johto (VP/urheilutoimenjohtaja, onJohtoRooli)
    //   · talenttivalmentaja — vastuu ulottuu seuran kaikkiin joukkueisiin/talentteihin (ei joukkuerajattu).
    //     EI lisätä onJohtoRooli:on (talenttivalmentaja ei ole hallintorooli); ohitus vain tässä joukkulukossa.
    // SA erikseen kutsupaikoissa.
    // Fail-closed: pelaajalla/valmentajalla ei joukkueet-kenttää → [] → hasAny false → estetty (ellei ohittava rooli).
    // v3.30 (PR 4) — PIN vain palvelimella: selain ei aseta eikä muuta pin-kenttää (Admin SDK ohittaa säännöt).
    function pinEiAsetetaClientista() {
      return !request.resource.data.keys().hasAny(['pin', 'pin_asetettu']);
    }
    /* v3.38 — vastuuhenkilö: vain jos update koskee kenttää. Asettajat: SA | VP/UTJ/talenttivalmentaja omassa seurassa | joukkueen valmentaja (onOmanJoukkueenValmentaja, rooli 'valmentaja').
       Muoto: map {uid, rooli, asetettu_pvm}; uid = seuran käyttäjä (kayttajat-dokumentti tai seura.vp_uid). Poisto (kenttä pois) sallittu asettajille. */
    function vastuuhenkiloAsettaja(seuraId, pelaajaId) {
      return onSuperAdmin()
          || (onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja', 'talenttivalmentaja'])
          || (onOmaSeura(seuraId) && request.auth.token.rooli == 'valmentaja' && onOmanJoukkueenValmentaja(seuraId, pelaajaId));
    }
    function vastuuhenkiloMuotoKelpaa(seuraId, v) {
      return v is map
          && v.keys().hasOnly(['uid', 'rooli', 'asetettu_pvm'])
          && v.keys().hasAll(['uid', 'rooli', 'asetettu_pvm'])
          && v.uid is string && v.uid.size() > 0 && v.uid.size() <= 128
          && v.rooli in ['valmentaja', 'apuvalmentaja', 'talenttivalmentaja', 'vp']
          && v.asetettu_pvm is string && v.asetettu_pvm.size() == 10
          && (exists(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(v.uid))
              || get(/databases/$(database)/documents/seurat/$(seuraId)).data.get('vp_uid', '') == v.uid);
    }
    /* v3.69 (PR 1c-1) — sisainen/tiedot: avaimet = create → request.resource.data.keys(); update → diff(...).affectedKeys(). Scout-potentiaali vain johto/SA; vastuuhenkilo kuten pelaajadokumentissa. */
    function sisainenScoutKelpaa(seuraId, avaimet) {
      return !avaimet.hasAny(['scout_potentiaali', 'scout_potentiaali_taso', 'scout_potentiaali_huomiot', 'scout_potentiaali_pvm', 'scout_potentiaali_arvioija'])
          || onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
    }
    function sisainenVastuuKelpaa(seuraId, pelaajaId, avaimet) {
      return !avaimet.hasAny(['vastuuhenkilo'])
          || (vastuuhenkiloAsettaja(seuraId, pelaajaId)
              && (!('vastuuhenkilo' in request.resource.data) || vastuuhenkiloMuotoKelpaa(seuraId, request.resource.data.vastuuhenkilo)));
    }
    function vastuuhenkiloMuutosKelpaa(seuraId, pelaajaId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['vastuuhenkilo'])
          || (vastuuhenkiloAsettaja(seuraId, pelaajaId)
              && (!('vastuuhenkilo' in request.resource.data) || vastuuhenkiloMuotoKelpaa(seuraId, request.resource.data.vastuuhenkilo)));
    }
    /* v3.39 — pelaajan/huoltajan luoma viesti (R6.4:n pohja): nakyvyys PAKOTETTU 'pelaaja', ei video_url:ia, avainjoukko rajattu, lähettäjä = kirjautunut, luettu:false. */
    /* v3.50 (R6.4): klippivastaus/-kuittaus — vastaus_viestille viittaa saman pelaajan klippiin; vastaanottaja = klipin vastaanottaja (vastuuhenkilö/lähettäjä); ei url:ia. */
    function klippiVastausKelpaa(seuraId) {
      let d = request.resource.data;
      return d.tyyppi in ['klippi_vastaus', 'klippi_kuittaus']
          && d.keys().hasAny(['vastaus_viestille'])
          && d.vastaus_viestille is string && d.vastaus_viestille.size() > 0
          && exists(/databases/$(database)/documents/seurat/$(seuraId)/viestit/$(d.vastaus_viestille))
          && get(/databases/$(database)/documents/seurat/$(seuraId)/viestit/$(d.vastaus_viestille)).data.get('tyyppi', '') == 'klippi'
          && get(/databases/$(database)/documents/seurat/$(seuraId)/viestit/$(d.vastaus_viestille)).data.get('pelaajaId', '') == d.pelaajaId
          && get(/databases/$(database)/documents/seurat/$(seuraId)/viestit/$(d.vastaus_viestille)).data.get('vastaanottajaUid', '') == d.get('vastaanottajaUid', '')
          && (!('teksti' in d) || (d.teksti is string && d.teksti.size() <= 200))
          && (!('valinta' in d) || (d.valinta is string && d.valinta.size() <= 60))
          && (!('kuittaus' in d) || d.kuittaus is bool)
          && (d.tyyppi == 'klippi_vastaus' || onLapsenHuoltaja(seuraId, d.pelaajaId));   // kuittaus (katsoimme yhdessä) vain huoltajalta
    }
    /* v3.63: klipin ryhmäkohde — ryhmä on olemassa, aktiivinen, nimi täsmää; lähettäjä SA / johto / ryhmän valmentaja / valmentaja-rooli. */
    function klippiKohdeKelpaa(seuraId, k) {
      return k is map && k.keys().hasOnly(['tyyppi', 'ryhma_id', 'nimi']) && k.keys().hasAll(['tyyppi', 'ryhma_id', 'nimi'])
          && k.tyyppi == 'ryhma' && k.ryhma_id is string && k.ryhma_id.size() > 0 && k.ryhma_id.size() <= 128 && k.nimi is string && k.nimi.size() > 0 && k.nimi.size() <= 60
          && exists(/databases/$(database)/documents/seurat/$(seuraId)/ryhmat/$(k.ryhma_id))
          && ryhmaDoc(seuraId, k.ryhma_id).get('nimi', '') == k.nimi
          && ryhmaDoc(seuraId, k.ryhma_id).get('aktiivinen', true) == true
          && (onSuperAdmin() || onJohtoRooli() || request.auth.uid in ryhmaDoc(seuraId, k.ryhma_id).get('valmentajat', [])
              || request.auth.token.get('rooli', '') in ['valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja']);
    }
    function klippiLuontiKelpaa(seuraId) {
      let d = request.resource.data;
      return d.url is string && d.url.size() <= 500 && d.url.matches('^https://.+')
          && d.domain is string && d.domain.size() > 0 && d.domain.size() <= 253
          && d.mediatyyppi in ['video', 'kuva', 'linkki']
          && d.klippityyppi in ['onnistui', 'prosessi', 'tulos']
          && d.kysymys is string && d.kysymys.size() >= 1 && d.kysymys.size() <= 160
          && (!('saate' in d) || (d.saate is string && d.saate.size() <= 120))
          && d.nakyvyys in ['pelaaja', 'huoltaja']
          && d.pelaajaId is string && d.pelaajaId.size() > 0
          && d.vastaanottajaUid is string && d.vastaanottajaUid.size() > 0
          && d.klippi_id is string && d.klippi_id.size() > 0
          && d.nakyva_alkaen is timestamp
          && d.tila == 'lahetetty'
          && (!('kohta_s' in d) || d.kohta_s is int)
          && (!('osa' in d) || d.osa in ['a', 'b', 'c'])
          && (!('tukitavoite_id' in d) || d.tukitavoite_id is string)
          && (!('lahde' in d) || d.lahde == 'linkki')
          && (!('kohde' in d) || klippiKohdeKelpaa(seuraId, d.kohde));
    }
    function viestiPelaajanLuonti(seuraId) {
      return ((request.resource.data.keys().hasOnly(['tyyppi','pelaajaId','jakso','osa','luettu','vastaanottajaUid','lahettajaUid','fromRole','fromNimi','teksti','nakyvyys','aika'])
          && request.resource.data.keys().hasAll(['pelaajaId','teksti','nakyvyys','lahettajaUid','luettu','aika']))
          || (request.resource.data.keys().hasOnly(['tyyppi','pelaajaId','vastaanottajaUid','lahettajaUid','fromRole','fromNimi','teksti','valinta','kuittaus','vastaus_viestille','nakyvyys','luettu','aika'])
              && request.resource.data.keys().hasAll(['tyyppi','pelaajaId','vastaus_viestille','nakyvyys','lahettajaUid','luettu','aika'])
              && klippiVastausKelpaa(seuraId)))
          && request.resource.data.nakyvyys == 'pelaaja'
          && request.resource.data.luettu == false
          && request.resource.data.lahettajaUid == request.auth.uid
          && request.resource.data.pelaajaId is string
          && (request.resource.data.get('tyyppi', '') in ['klippi_vastaus', 'klippi_kuittaus'] || (request.resource.data.teksti is string && request.resource.data.teksti.size() > 0 && request.resource.data.teksti.size() <= 2000))
          && (onPelaajaItse(seuraId, request.resource.data.pelaajaId) || onLapsenHuoltaja(seuraId, request.resource.data.pelaajaId));
    }
    function pinEiMuutuClientista() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin', 'pin_asetettu']);
    }
    // v3.33: suostumus + huoltajaEmail vain palvelimella. Luonnissa huoltajaEmail sallitaan (uusi pelaaja / tuonti),
    // suostumusTila vain 'pilotti' tai 'odottaa', ei suostumus-/annettu-kenttiä.
    function suostumusEiAsetetaClientista() {
      return !request.resource.data.keys().hasAny(['suostumus', 'suostumusAnnettu', 'suostumukset'])
          && (!('suostumusTila' in request.resource.data)
              || request.resource.data.suostumusTila in ['pilotti', 'odottaa']);
    }
    function suostumusEiMuutuClientista() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['suostumusTila', 'suostumus', 'suostumusAnnettu', 'suostumukset', 'huoltajaEmail']);
    }

    // v3.54 (S1.1): käyttöaste-aikaleimat vain palvelimella (pelaajaKirjaudu / kirjaaHuoltajaKaynti, Admin SDK). Luonnissa ei saa olla kenttiä; päivityksessä ei saa koskea (poisto mukaan lukien).
    function kayttoasteEiAsetetaClientista() {
      return !request.resource.data.keys().hasAny(['viimeisinKirjautuminen', 'huoltajaViimeisinKaynti']);
    }
    function kayttoasteEiMuutuClientista() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['viimeisinKirjautuminen', 'huoltajaViimeisinKaynti']);
    }

    function onOmanJoukkueenValmentaja(seuraId, pelaajaId) {
      return onOmanSeuranValmentaja(seuraId)
          && ( onJohtoRooli()
            || request.auth.token.rooli == 'talenttivalmentaja'
            || pelaajaData(seuraId, pelaajaId).get('joukkueet', []).hasAny(valmentajanJoukkueet(seuraId)) );
    }

    // v2.3 — pelaajan dokumentti getterillä (Firestore välimuistittaa)
    function pelaajaData(seuraId, pelaajaId) {
      return get(
        /databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)
      ).data;
    }

    // v2.3 — Huoltaja-tunnistus pelaajadokumentin huoltajaEmail-kentästä.
    // Vertailu lowercased — pelaajaa luotaessa huoltajaEmail voi olla
    // sekamuotoinen (esim. "TeroKoskela7@gmail.com"), mutta Firebase Auth
    // normalisoi tokenin emailin lowercased-muotoon.
    // v3.31 (P0): kayttajat-dokumentin pääsykentät vain palvelimella (ks. kayttajat/{uid}).
    function kayttajaPaasyKentatEnnallaan() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'rooli', 'seuraId', 'aktiivinen', 'deaktivoitu', 'deaktivoija_uid', 'aktivoitu', 'aktivoija_uid', 'claimsAsetettu']);
    }

    function onLapsenHuoltaja(seuraId, pelaajaId) {
      return onKirjautunut()
          && request.auth.token.email is string
          && pelaajaData(seuraId, pelaajaId).huoltajaEmail is string
          && request.auth.token.email.lower()
             == pelaajaData(seuraId, pelaajaId).huoltajaEmail.lower();
    }

    // v3.55 (B4) — huoltajan saatavuusvastaus (lasnaolijat): vahvistettu sähköposti + suostumus annettu (samalla linjalla kuin v3.51:n viestiluku); rooli pakotetaan 'huoltaja' (ei kirjoita pelaajana);
    // vain RSVP-arvot; kenttärajaus kutsujassa: create → keys().hasOnly, update → diff().affectedKeys().hasOnly (päivitys ei kosketa henkilökunnan `tila`-kenttää).
    function huoltajaRsvp(seuraId, pelaajaId) {
      return onLapsenHuoltaja(seuraId, pelaajaId)
          && request.auth.token.get('email_verified', false) == true
          && pelaajaData(seuraId, pelaajaId).get('suostumusTila', '') == 'annettu'
          && request.resource.data.get('rooli', '') == 'huoltaja'
          && request.resource.data.get('saatavuus', '') in ['tulossa', 'estynyt'];
    }

    // v3.3 (PÄÄTÖS 2) — huoltaja saa KIRJATA U12-lapselle (alle 13v) kun lahde=='vanhempi'.
    //   1) sähköposti täsmää huoltajaEmail-kenttään (onLapsenHuoltaja)
    //   2) pelaaja alle 13v: syntymaVuosi >= kuluva vuosi − 12 (sama kuin sovelluksen u12-vaihe)
    //   3) kirjauksen lahde == 'vanhempi'
    //   HUOM: request.time.year() antaa kalenterivuoden (käyttäjän toMillis-kaavasta puuttui
    //   1970-offset → olisi ollut aina tosi).
    function onU12HuoltajaIka(seuraId, pelaajaId) {   // v3.37: ikä + sähköposti ilman lahde-ehtoa (kuittaus kirjoittaa vain oman kenttänsä)
      return onLapsenHuoltaja(seuraId, pelaajaId)
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi is int
          && pelaajaData(seuraId, pelaajaId).syntymaVuosi >= (request.time.year() - 12);
    }
    function onU12Huoltaja(seuraId, pelaajaId) {
      return onU12HuoltajaIka(seuraId, pelaajaId)
          && request.resource.data.lahde == 'vanhempi';
    }

    // ── A5: aikaleima-kentän eheys (luotu) ────────────────────────────────
    // Estää orderBy/where-näkymättömyyden kahdesta syystä:
    //   • luotu PUUTTUU  → orderBy('luotu') jättää dokumentin kokonaan pois
    //   • luotu ISO-STRING → Firestoren tyyppijärjestys erottaa sen Timestampeista
    //     (timestamp < string) → limit/where-kyselyt eivät näe sitä.
    // create: luotu pakollinen + timestamp.
    // update: jos luotu on muuttuvien kenttien joukossa, sen on oltava timestamp;
    //   muuten ohitus → lukukuittaukset (nahty ym.) ja muut field-level-päivitykset
    //   toimivat eikä luotu-kenttää voi pudottaa overwrite-setillä.
    // ⚠ DEPLOY VASTA kun kirjoittajat korjattu + olemassa oleva data migroitu
    //   (havainnot/kirjaukset). Ks. docs/SKAALAUTUVUUS_JA_TEKNINEN_VELKA.md §A5.
    function luotuLuontiKelpaa() {
      // 'luotu' in ... ENNEN is timestamp -tarkistusta: estää evaluointivirheen
      // ("Property luotu is undefined") kun kenttä puuttuu → siisti false (= hylkää).
      return 'luotu' in request.resource.data
          && request.resource.data.luotu is timestamp;
    }
    /* v3.46 — kevyt katselmus (V4b-2): 3 kysymystä sanoina; ei numeroita. */
    function kevytKelpaa(k) {
      return k is map
          && k.keys().hasOnly(['nakyi', 'treeni', 'mukana'])
          && k.keys().hasAll(['nakyi', 'treeni', 'mukana'])
          && k.nakyi in ['ei_viela', 'ohjatusti', 'itsenaisesti']
          && k.treeni in ['harvoin', 'joskus', 'usein']
          && k.mukana in ['vahan', 'jonkin_verran', 'hyvin'];
    }
    function reviewKevytKelpaa() {
      let d = request.resource.data;
      return (!('kevyt' in d) || kevytKelpaa(d.kevyt))
          && (!('kevyt_tallennettu' in d) || (d.kevyt_tallennettu is string && d.kevyt_tallennettu.size() <= 40))
          && (!('hylkays_sisainen' in d) || hylkaysSisainenKelpaa(d.hylkays_sisainen));   // v3.65
    }
    /* v3.65 (K3a): Hylkää valinta -perustelun sisäinen kopio — täsmälleen { teksti, lahde, uid?, tallennettu } */
    function hylkaysSisainenKelpaa(h) {
      return h is map && h.keys().hasOnly(['teksti', 'lahde', 'uid', 'tallennettu']) && h.keys().hasAll(['teksti', 'lahde', 'tallennettu'])
          && h.teksti is string && h.teksti.size() > 0 && h.teksti.size() <= 200
          && h.lahde in ['valmentaja', 'vp']
          && (!('uid' in h) || h.uid == null || h.uid is string)
          && h.tallennettu is string && h.tallennettu.size() <= 40;
    }
    function profiiliKelpaa() {
      return !('valmentajaprofiili' in request.resource.data) || request.resource.data.valmentajaprofiili in ['ammatti', 'oto'];
    }
    /* v3.56 (S2, D70): joukkueen tyyppi — 'kilpa' | 'harraste'; puuttuva sallittu (= 'kilpa'). */
    function tyyppiKelpaa() {
      return !('tyyppi' in request.resource.data) || request.resource.data.tyyppi in ['kilpa', 'harraste'];
    }
    /* v3.64 (B1, D107): joukkueen pelimuodot — lista 1–3 alkiota ∈ {5v5, 8v8, 11v11}; puuttuva sallittu (oletus iästä, lib/tm_kentta_spec.js). */
    function pelimuodotKelpaa() {
      let d = request.resource.data;
      return !('pelimuodot' in d)
          || (d.pelimuodot is list && d.pelimuodot.size() >= 1 && d.pelimuodot.size() <= 3 && d.pelimuodot.hasOnly(['5v5', '8v8', '11v11']));
    }
    /* v3.64 (B1, D98): ydinvahvuus.alue — muoto + asettaja kun alue muuttuu; jaksofokus.reitti.loppu — enum. Peilaa lib/tm_kentta_spec.js (tmKenttaAlueKelpaa / tmAlueKirjoitus / tmReittiKirjoitus). */
    function ydinvahvuusAlue(d) {
      return d.get('ydinvahvuus', null) is map ? d.ydinvahvuus.get('alue', null) : null;
    }
    function ydinvahvuusAlueMuoto(a) {
      return a is map && a.keys().hasOnly(['x', 'y', 'w', 'h']) && a.keys().hasAll(['x', 'y', 'w', 'h'])
          && a.x is number && a.y is number && a.w is number && a.h is number
          && a.x >= 0 && a.x <= 100 && a.y >= 0 && a.y <= 140 && a.w >= 1 && a.w <= 100 && a.h >= 1 && a.h <= 140
          && a.x + a.w <= 100 && a.y + a.h <= 140;
    }
    /* Alue muuttuu → kirjoittaja SA tai valmennus-/johtorooli (onValmentajaRooli: valmentaja · talenttivalmentaja · fysiikkavalmentaja · vp · utj); testivastaava, seurasihteeri ja fysioterapeutti eivät aseta aluetta
       vaikka heillä on muita pelaajakenttiä (onTestivastaava-haara on koko-dokin update). Oman joukkueen rajaus tulee koko-dokin update -haarasta (onOmanJoukkueenValmentaja). null = ei aluetta (poisto). */
    function ydinvahvuusAlueMuutosKelpaa() {
      let uusi = ydinvahvuusAlue(request.resource.data);
      return uusi == ydinvahvuusAlue(resource.data)
          || ((onSuperAdmin() || onValmentajaRooli())
              && (uusi == null
                  || (ydinvahvuusAlueMuoto(uusi)
                      && request.resource.data.ydinvahvuus.get('asetti_uid', null) == request.auth.uid
                      && request.resource.data.ydinvahvuus.get('asetettu_pvm', null) is string
                      && request.resource.data.ydinvahvuus.asetettu_pvm.size() == 10)));
    }
    /* v3.66 (Vaihe 1 / 1d): pelaajan d3_itsearvio — täsmälleen { pisteet, pvm, jakso_alkoi? }; pisteet-avaimet = D3-ulottuvuudet (lib/tm_d3_itsearvio.js DIMS), arvot kokonaislukuja 1–5; pvm 'YYYY-MM-DD'. */
    function d3ItsearvioKelpaa() {
      let d = request.resource.data.d3_itsearvio;
      return d is map && d.keys().hasOnly(['pisteet', 'pvm', 'jakso_alkoi']) && d.keys().hasAll(['pisteet', 'pvm'])
          && d.pisteet is map && d.pisteet.keys().hasOnly(['inner_drive', 'coachability', 'resilience', 'focus', 'emotional_control'])
          && d.pisteet.values().hasOnly([1, 2, 3, 4, 5])
          && d.pvm is string && d.pvm.size() == 10
          && (!('jakso_alkoi' in d) || d.jakso_alkoi == null || (d.jakso_alkoi is string && d.jakso_alkoi.size() <= 40));
    }
    function jaksofokusReittiKelpaa() {
      let jf = request.resource.data.get('jaksofokus', null);
      return !(jf is map) || !('reitti' in jf)
          || (jf.reitti is map && jf.reitti.keys().hasOnly(['loppu']) && jf.reitti.get('loppu', null) in ['maali', 'kaveri', 'kausitavoite']);
    }
    /* v3.47 (R1) — ryhmät. Rakenne ja koot; listan alkioiden tyyppiä (uid/pelaajaId-merkkijono) ei voi tarkistaa ilman silmukkaa → client + testit. */
    function ryhmaKelpaa() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nimi', 'tyyppi', 'saanto', 'pelaajat_id', 'valmentajat', 'kuvaus', 'aktiivinen', 'luotu', 'luoja_uid', 'muokattu', 'vastuu_uid'])
          && d.keys().hasAll(['nimi', 'tyyppi', 'pelaajat_id', 'valmentajat', 'aktiivinen', 'luotu', 'luoja_uid', 'muokattu'])
          && d.nimi is string && d.nimi.size() >= 1 && d.nimi.size() <= 60
          && d.tyyppi in ['lista', 'saanto']
          && d.pelaajat_id is list && d.pelaajat_id.size() <= 200
          && d.valmentajat is list && d.valmentajat.size() <= 10
          && d.aktiivinen is bool
          && (!('vastuu_uid' in d) || (d.vastuu_uid is string && d.vastuu_uid in d.valmentajat))   // v3.61 (D196): vastaava on ryhmän valmentaja
          && d.luoja_uid is string
          && d.luotu is timestamp && d.muokattu is timestamp && d.muokattu == request.time
          && (!('kuvaus' in d) || (d.kuvaus is string && d.kuvaus.size() <= 200))
          && (d.tyyppi == 'saanto'
              ? ('saanto' in d && d.saanto is map && d.saanto.keys().hasOnly(['kentta', 'arvo']) && d.saanto.keys().hasAll(['kentta', 'arvo'])
                 && d.saanto.kentta == 'talenttiOhjelma' && d.saanto.arvo == true && d.pelaajat_id.size() == 0)
              : !('saanto' in d));
    }
    function ryhmaDoc(seuraId, ryhmaId) {
      return get(/databases/$(database)/documents/seurat/$(seuraId)/ryhmat/$(ryhmaId)).data;
    }
    /* v3.47: onko kirjautunut käyttäjä NYKYISEN (resource) ryhmätapahtuman ryhmän valmentaja. */
    function ryhmanValmentajaTapahtumassa(seuraId) {
      return resource.data.get('kohde', {}).get('tyyppi', '') == 'ryhma'
          && resource.data.kohde.get('ryhma_id', '') is string
          && resource.data.kohde.ryhma_id.size() > 0
          && exists(/databases/$(database)/documents/seurat/$(seuraId)/ryhmat/$(resource.data.kohde.ryhma_id))
          && request.auth.uid in ryhmaDoc(seuraId, resource.data.kohde.ryhma_id).valmentajat;
    }
    /* v3.61 (K35-6c, D196): onko kirjautunut käyttäjä NYKYISEN ryhmätapahtuman ryhmän VASTAAVA (ryhmat/{rid}.vastuu_uid == uid). */
    function ryhmanVastaavaTapahtumassa(seuraId) {
      return ryhmanValmentajaTapahtumassa(seuraId)
          && ryhmaDoc(seuraId, resource.data.kohde.ryhma_id).get('vastuu_uid', '') == request.auth.uid;
    }
    /* v3.44 — viikkokatsaus (K4): yksi vastaus {osa, teksti, arvo}. Taulukkoindeksit käsin (säännöissä ei silmukkaa). */
    function vkVastausKelpaa(v) {
      return v is map
          && v.keys().hasOnly(['osa', 'teksti', 'arvo'])
          && v.keys().hasAll(['osa', 'teksti', 'arvo'])
          && v.osa is string && v.osa.size() >= 1 && v.osa.size() <= 10
          && v.teksti is string && v.teksti.size() <= 300
          && v.arvo in ['usein', 'joskus', 'ei_viela'];
    }
    function vkKelpaa(pvm) {
      let d = request.resource.data;
      return pvm.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.keys().hasOnly(['vk', 'jakso_alkoi', 'vastaukset', 'lause', 'luotu'])
          && d.keys().hasAll(['vk', 'jakso_alkoi', 'vastaukset', 'luotu'])
          && d.vk is int && d.vk >= 1 && d.vk <= 52
          && d.jakso_alkoi is string && d.jakso_alkoi.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && d.vastaukset is list && d.vastaukset.size() >= 1 && d.vastaukset.size() <= 3
          && vkVastausKelpaa(d.vastaukset[0])
          && (d.vastaukset.size() < 2 || vkVastausKelpaa(d.vastaukset[1]))
          && (d.vastaukset.size() < 3 || vkVastausKelpaa(d.vastaukset[2]))
          && (!('lause' in d) || (d.lause is string && d.lause.size() <= 140))
          && d.luotu == request.time;
    }

    /* ── HAVAINNON KUMOAMINEN (v3.21) ─────────────────────────────────────────────────────
       Kumoaminen on `tila:'peruttu'`, EI poisto: valmentajalla ei ole poisto-oikeutta, ja jälki
       jää historiaan. Vain TEKIJÄ saa perua oman havaintonsa — muuten toinen valmentaja voisi
       pyyhkiä kollegan arvion peliälystä pois. Samassa kirjoituksessa ei saa muuttaa `pisteet`:iä,
       jottei peruttua voi "korjata" hiljaa.
       AIKAIKKUNAA EI OLE SÄÄNNÖSSÄ: offline-kumous synkkaa myöhemmin eikä saa kaatua siihen.
       10 minuutin ikkuna on käyttöliittymän asia. */
    function onPeruminen() {
      return request.resource.data.get('tila', '') == 'peruttu'
          && resource.data.get('tila', '') != 'peruttu';
    }
    /* v3.23 — KUKA SAA PERUA:
         · TEKIJÄ ilman aikarajaa. Tekijäkenttä on kaksi: `tekija_uid` (pikakortti) ja
           `valmentajaUid` (valmentaja_viesti). Ilman jälkimmäistä viestin kirjoittaja EI voinut
           perua omaa viestiään — vain SA pystyi siihen, eikä sille ollut käyttöliittymää.
         · SEURAN JOHTO (VP, urheilutoimenjohtaja) minka tahansa oman seuran merkinnän, esim.
           asiattoman tekstin. Muut valmentajat EIVÄT saa perua kollegan arviota.
         · SA.
       Peruttu pysyy lukittuna (vain SA palauttaa), eikä pisteitä saa muuttaa samassa
       kirjoituksessa — muuten peruttua voisi "korjata" hiljaa. */
    function onPerujaSallittu(seuraId) {
      return onSuperAdmin()
          || resource.data.get('tekija_uid', '') == request.auth.uid
          || resource.data.get('valmentajaUid', '') == request.auth.uid
          || ( onOmaSeura(seuraId) && onJohtoRooli() );
    }
    function peruminenKelpaa(seuraId) {
      return ( !onPeruminen()
            || ( onPerujaSallittu(seuraId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pisteet']) ) )
          // Jo peruttu havainto on LUKITTU: muuten kuka tahansa joukkueen valmentaja voisi
          // palauttaa sen 'valmis'-tilaan tai muuttaa pisteitä, jolloin peruutus ei pitäisi.
          && ( resource.data.get('tila', '') != 'peruttu' || onSuperAdmin() );
    }
    function luotuPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['luotu'])
          || ('luotu' in request.resource.data
              && request.resource.data.luotu is timestamp);
    }
    // A5-jälki: sama `aika`-kentälle (mentorointiviestit seurat/{}/viestit) — estää regression
    // (data + VP_v25-writer ovat jo Timestamp; vartija lukitsee).
    function aikaLuontiKelpaa() {
      return 'aika' in request.resource.data
          && request.resource.data.aika is timestamp;
    }
    function aikaPaivitysKelpaa() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aika'])
          || ('aika' in request.resource.data
              && request.resource.data.aika is timestamp);
    }

    // ──────────────────────────────────────────────────────────────────────
    // ADMINS — super admin -taulukko
    // ──────────────────────────────────────────────────────────────────────
    // v3.25 — kirjautumisen yrityslaskurit ja PIN-hajautukset: VAIN Admin SDK (pelaajaKirjaudu).
    // Oma kokoelma, koska pelaajadokumentit ovat (vielä) laajasti luettavissa: 4-numeroisen PIN:in
    // hajautus pelaajadokumentissa murtuisi 10 000 kokeilulla.
    match /_kirjautumisyritykset/{avain} { allow read, write: if false; }
    match /_pelaajaPin/{avain}           { allow read, write: if false; }
    // v3.26 — Solo-lapsen PIN-hajautukset (soloLapsiKirjaudu): VAIN Admin SDK.
    match /_soloPin/{avain}              { allow read, write: if false; }
    // v3.57 (K35-7a): kalenterin iCal-tilaukset — VAIN Admin SDK (luoKalenteriTilaus / kalenteriIcal).
    match /kalenteri_tilaukset/{avain}   { allow read, write: if false; }

    match /admins/{uid} {
      // v3.24: vain SA tai käyttäjä itse. Kaikki selainlukijat lukevat omaa dokumenttiaan
      // (SA-fallback roolintunnistuksessa); muiden adminien listaus ei ole kenenkään tarve.
      allow read:  if onSuperAdmin() || (onKirjautunut() && request.auth.uid == uid);
      allow write: if onSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────
    // SEURAT — pääkokoelma + kaikki alikokoelmat
    // ──────────────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
      allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

      // ── SALAISET (v3.62) — server-only: ulkoisten palveluiden avaimet. EI mikään selain (SA, johto, valmentaja, pelaaja, huoltaja) lue eikä kirjoita; vain Admin SDK. ──
      match /salaiset/{dokId} {
        allow read, write: if false;
      }

      // ── KAAVIOT (v3.6) — seurakohtaiset teknis-taktiset kaaviot + review-silmukka ──
      // Kaksikerros: kanoninen /kaaviot/{avain} (master) + tämä seurataso (omat + override).
      // Sama spec.avain seuratasolla VOITTAA kanonisen (näyttölogiikka, ei sääntö).
      //
      // ⚠ PELAAJAN KOHDISTUSTA EI PAKOTETA. Pelaaja lukee hyväksytyn kaavion onKirjautunut()-haaralla
      //   (v3.28: vain palvelintoken, ei anonyymiä); sääntö EI tarkista joukkuetta/pelaajaIds:ää.
      //   Palvelin pakottaa pelaajalle VAIN status=='hyvaksytty'. review.nakyvyys /
      //   joukkueId / pelaajaIds ovat UI-TASOINEN suodatin (lib/tm_kaavio_policy.js
      //   kaavioKohdistuu) — ÄLÄ lue tätä sääntöä lupaukseksi kohdistuksen pakottamisesta.
      //   Kuittaus (review.ymmarretty) kirjoitetaan siksi Cloud Functionilla, ei clientistä.
      match /kaaviot/{kaavioId} {
        // Kovennus (B2): hyväksytyn luku vaatii EKSPLISIITTISESTI kirjautumisen. Aiemmin
        // kirjautumaton estyi vain siksi että onSuperAdmin() kaatui eval-virheeseen — se on
        // sivuvaikutus, ei sääntö. Nyt kielto on luettavissa säännöstä.
        // KESKENERÄISET VAIN VALMENNUSROOLEILLE. onValmentajaRooli() sisältää vp:n ja
        // urheilutoimenjohtajan → hyväksyjä näkee luonnokset ja voi katselmoida (ennallaan).
        // onJohtoRooli() on POISTETTU tästä haarasta: sen ja onValmentajaRoolin erotus on
        // seurasihteeri, joka ei ole valmennusrooli → hän putoaa 'hyvaksytty'-haaraan ja näkee
        // vain valmiit. kaavioLukuOk() (yksityinen luonnos vain tekijälle) on ennallaan.
        allow read: if onKirjautunut() && (
                         onSuperAdmin()
                      || (kaavioLukuOk() && (
                              (onOmaSeura(seuraId) && onValmentajaRooli())
                           || kaavioTila(resource.data) == 'hyvaksytty')));

        // Luonti: oman seuran valmentaja/johto. Uusi kaavio EI voi syntyä hyväksyttynä.
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onValmentajaRooli()
                          && kaavioTila(request.resource.data) in ['luonnos', 'odottaa']
                          && kaavioVersio(request.resource.data) == 0
                          && kaavioNakyvyysLuontiOk());

        // Päivitys: seura-skooppi + sallittu statussiirto + uudelleenhyväksyntä.
        // Joukkuerajaus: valmentajalla oltava kaavion joukkueId omissa joukkueissaan; johto ja
        // talenttivalmentaja ohittavat rajauksen seuran sisällä (sama kuvio kuin pelaajakirjoitus).
        allow update: if kaavioVersioOk() && (
                         onSuperAdmin()
                      || (onOmaSeura(seuraId) && onValmentajaRooli()
                          && kaavioNakyvyysMuutosOk()
                          && kaavioSiirtoOk(kaavioTila(resource.data), kaavioTila(request.resource.data))
                          && kaavioUudelleenhyvaksyntaOk(kaavioTila(resource.data), kaavioTila(request.resource.data))
                          && ( onKaavioHyvaksyja()
                            || request.auth.token.rooli == 'talenttivalmentaja'
                            || (kaavioJoukkue(resource.data) != null
                                && valmentajanJoukkueet(seuraId).hasAny([kaavioJoukkue(resource.data)])) )));

        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onKaavioHyvaksyja());

        // ── KATSELMUKSEN KOMMENTTILANKA (erä E) ────────────────────────────────────────
        // Hylkäys ilman perustelua oli umpikuja: valmentaja sai "hylätty" tietämättä miksi.
        // Lanka on ALIKOKOELMA, ei review.kommentit[]-taulukko — taulukko vaatisi doc-updaten
        // joka kommentista, mikä törmäisi optimistiseen versiolukkoon (kaavioVersioOk) ja
        // rinnakkaisiin kirjoituksiin. Append-only-alikokoelma on puhdas lisäys.
        //
        // ⚠ ALIKOKOELMA EI PERI YLÄPUOLEN SÄÄNTÖJÄ (§12) → portit toistetaan tässä.
        //   resource.data on KOMMENTTI, joten yksityisyys kysytään emokaaviosta get():llä.
        //
        // STAFF-LANKA: pelaaja EI näe tätä, vaikka näkisi hyväksytyn kaavion. Palaute on
        // valmentajan ja VP:n välinen työkalu ("liikaa pelaajia kentällä"), ei pelaajalle
        // suunnattua sisältöä. Pelaajan oma kysymys on erillinen CF-reitti (anon-rajoite).
        match /kommentit/{kommenttiId} {
          function emoKaavio() {
            return get(/databases/$(database)/documents/seurat/$(seuraId)/kaaviot/$(kaavioId)).data;
          }
          // LUKU = sama joukko joka näkee kaavion. Kun kaavion luvusta poistettiin
          // onJohtoRooli(), tämä oli pakko peilata: muuten seurasihteeri ei näkisi
          // keskeneräistä kaaviota mutta näkisi sen KATSELMUSLANGAN — eli juuri sen
          // sisällön jota rajaus suojaa ("karsi kolmeen pelaajaan" kertoo kuvan tilan).
          // Seurarajaus säilyy tiukempana kuin kaaviotasolla: hyväksytynkin langan luku
          // vaatii oman seuran (kaaviotason 'hyvaksytty'-haara on seuraneutraali).
          function onStaffLuku() {
            return onOmaSeura(seuraId)
                && (onValmentajaRooli() || kaavioTila(emoKaavio()) == 'hyvaksytty');
          }
          // KIRJOITUS on kapeampi, samasta syystä kuin onKaavioHyvaksyja(): seurasihteeri ei ole
          // valmennusrooli. Katselmuspalaute on valmennussisältöä ("karsi kolmeen pelaajaan"),
          // ei hallintoa — sen kirjoittaminen kuuluu samoille rooleille jotka omistavat kaavion.
          //
          // ⚠ SULKEET OVAT PAKOLLISET. Ilman niitä && sitoo ennen ||, jolloin ehdoksi tulee
          //   (onOmaSeura && onValmentajaRooli) || onKaavioHyvaksyja()
          // ja jälkimmäinen haara on SEURANEUTRAALI roolitesti → minkä tahansa seuran vp/UTJ
          // olisi voinut kirjoittaa tämän seuran lankaan (sokkokirjoitus tunnettuun polkuun;
          // luku oli aina suojattu). onKaavioHyvaksyja() on tarkoituksella pelkkä roolitesti —
          // SEURARAJAUS KUULUU KUTSUJALLE, ja kaikissa muissa kutsukohdissa se on onOmaSeura-
          // vartion sisällä. SA:lla oma eksplisiittinen haara, kuten kaaviotason porteissa:
          // ylläpito-ohitus pidetään näkyvänä eikä salakuljeteta roolitestin sisällä.
          function onStaffKirjoitus() {
            return onSuperAdmin()
                || (onOmaSeura(seuraId) && (onValmentajaRooli() || onKaavioHyvaksyja()));
          }
          // Yksityisen luonnoksen lanka seuraa kaaviota: vain tekijä (ja SA).
          allow read: if onSuperAdmin() || (onStaffLuku() && kaavioLukuOkDoc(emoKaavio()));

          // Append-only. kirjoittaja == auth.uid estää väärennetyn tekijätiedon; aika ==
          // request.time pakottaa serverTimestampin (client ei voi valita kellonaikaa langassa).
          allow create: if onStaffKirjoitus()
                        && request.resource.data.kirjoittaja == request.auth.uid
                        && request.resource.data.tyyppi in ['kommentti', 'hylkays']
                        && 'aika' in request.resource.data
                        && request.resource.data.aika == request.time
                        && request.resource.data.teksti is string
                        && request.resource.data.teksti.size() > 0
                        && request.resource.data.teksti.size() <= 2000;

          // Muokkaus kielletty myös kirjoittajalta: lanka on katselmuksen jälki, ei muistio.
          // Jälkikäteen siistitty hylkäysperustelu tekisi historiasta epäluotettavan.
          allow update: if false;
          allow delete: if onSuperAdmin();
        }
      }

      // ── TOIMENPITEET — TalentMasterin ehdotukset + VP:n kuittaukset (v3.1) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Ei delete: historia/audit-jälki
      // säilyy aina (tila ehdotus|kuitattu|muokattu|hylatty). VP/SA luo + päivittää.
      match /toimenpiteet/{tid} {
        allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── KONSEPTIT (v3.13) — SEURAKERROS TIER 1 ──────────────────────────────────────
      // Kerrosmalli: TIER 0 kaanon (lib, read-only) → TIER 1 tämä → TIER 2 yksilö (pelaajadata).
      // Dokumentti on HARVA override: vain muutetut kentät. Avain = kaanonin avain (y_h0…) tai
      // seuran oma 'seura_<slug>'. Rules EIVÄT periydy → oma blokki.
      //   read   koko seura — valmentaja tarvitsee resolvoidut konseptit renderiin.
      //   write  VAIN vp/urheilutoimenjohtaja (+SA) — ks. onKonseptiMuokkaaja().
      //   delete sama portti: "palauta kaanoniin" poistaa koko override-dokumentin.
      // Sisältö on seuran pedagogista tekstiä (ei pelaajaa yksilöivää) → ei GDPR-erityiskäsittelyä.
      match /konseptit/{konseptiAvain} {
        // v3.25: pelaaja lukee oman seuransa linjan (A3) — vain oma seura, ei muita.
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId)) || onPelaajanSeura(seuraId);
        allow create: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
        allow update: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
        allow delete: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
      }

      /* v3.40 — SEURAN LINJA (B PR1). Seuran oma valmennussisältö; vain tämän seuran polun alla → luku/kirjoitus sidottu omaan seuraan (SJK ei näe Sibbon eikä päinvastoin).
         Rules EI periydy: jokainen alikokoelma oma blokki. Sisältö on pedagogista tekstiä (ei yksilöi pelaajaa). Seuran sisältö ei koskaan siirry TM:n oletuspankkiin. */
      match /valmennuslinja/{lohko} {
        // ikavaiheet = henkilökunnan työkalu (EI pelaajalle/huoltajalle); teemat näkyvät pelaajalle ("Meistä → Joukkue").
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId))
                      || (lohko == 'teemat' && onPelaajanSeura(seuraId));
        allow create, update, delete: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
      }
      // v3.43 — seuran julkiset liput (luku pelaajalle; kirjoitus johto/SA). Vain boolean-liput, ei piilotettavaa sisältöä.
      match /liput/{lippuId} {
        allow read:   if onLiputLuku(seuraId);
        allow create, update: if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }
      match /harjoitepankki/{harjoiteId} {
        // v3.41: pelaaja vain hyväksytyt (luonnos = SJK:n kuittaamaton / TM:n esitäyttö → ei pelaajalle)
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId))
                      || (onPelaajanSeura(seuraId) && resource.data.get('tila', '') == 'hyvaksytty' && resource.data.kaytto == 'koti');   // v3.42: pelaajalle vain koti-käyttöiset (joukkue-rivi ei koskaan; kaytto-kentätön → ei)
        allow create, update: if (onSuperAdmin() || onKonseptiMuokkaaja(seuraId))
                      && request.resource.data.get('lahde', '') == 'seura'
                      && request.resource.data.get('tyyppi', '') == 'T'
                      && request.resource.data.get('tila', '') in ['luonnos', 'hyvaksytty']
                      && request.resource.data.get('nimi', null) is string && request.resource.data.nimi.size() > 0;
        allow delete: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
      }
      match /arviointikehys/{kehysId} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
        allow create, update, delete: if onSuperAdmin() || onKonseptiMuokkaaja(seuraId);
      }

      // ── KONFIGURAATIO (v3.2) — seuran normijärjestelmä (normijarjestelma/maa/kieli) ──
      // Rules EIVÄT periydy alikokoelmiin → oma blokki. Luku koko seuralle; kirjoitus VP/SA.
      match /konfiguraatio/{konfId} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }

      // ── HARJOITUSARVIOINNIT (HARJOITUSARVIOINTI_SPEC §9) ──────────────────
      // Kaksimallinen harjoitusarviointi (A Palloliitto-laatu / B valmennustaidot).
      // read: SA | oma seura (valmentaja näkee omat, johto kaikki). create/update: johto + oman seuran valmentaja + SA.
      // delete: vain SA. Pikakentät (harjoituslaatu_/valmennustaito_) kirjoitetaan kayttajat-dokumenttiin (oma blokki alla).
      // ── KEHITYSTILANNE v0 (v3.34) ───────────────────────────────────────
      match /kehitysasetukset/{vuosi} {
        allow read:  if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create, update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
        allow delete: if onSuperAdmin();
      }
      match /seuratuki/{vuosi} {
        allow read:  if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create, update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
        allow delete: if onSuperAdmin();
      }
      // ── SEURAN OMAT VAPAAT TAVOITTEET (v3.35, Kehitystilanne v0.1) ─────────
      match /omat_tavoitteet/{tid} {
        function omaKirjoittaja() {
          return onSuperAdmin() || (onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
        }
        function onPvm(x) { return x is string && x.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
        function omaTavoiteKelpaa(d) {
          return d.keys().hasAll(['nimi', 'tyyppi', 'tavoite', 'aikaraja', 'tekija', 'luoja_uid', 'arkistoitu'])
            && d.keys().hasOnly(['nimi', 'tyyppi', 'tavoite', 'yksikko', 'suunta', 'alkaa', 'aikaraja', 'tekija', 'luotu', 'luoja_uid', 'arkistoitu'])
            && d.nimi is string && d.nimi.size() >= 2 && d.nimi.size() <= 120
            && d.tyyppi in ['maara', 'summa', 'viimeisin', 'kylla_ei']
            && d.tekija in ['pelaajat', 'valmennus', 'seura']
            && onPvm(d.aikaraja)
            && (!('alkaa' in d) || (onPvm(d.alkaa) && d.alkaa < d.aikaraja))
            && (!('yksikko' in d) || (d.yksikko is string && d.yksikko.size() <= 20))
            && ((d.tyyppi == 'kylla_ei' && d.tavoite == true) || (d.tyyppi != 'kylla_ei' && d.tavoite is number))
            && (!('suunta' in d) || d.suunta == 'suurempi' || (d.suunta == 'pienempi' && d.tyyppi == 'viimeisin'))
            && (!('luotu' in d) || d.luotu == request.time)
            && d.luoja_uid == request.auth.uid
            && d.arkistoitu == false;
        }
        allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create: if omaKirjoittaja() && omaTavoiteKelpaa(request.resource.data);
        allow update: if omaKirjoittaja()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['arkistoitu', 'paivitetty', 'paivittaja_uid'])
                      && request.resource.data.arkistoitu is bool;
        allow delete: if false;

        match /kirjaukset/{kid} {
          function omaKirjausKelpaa(d, t) {
            return t.arkistoitu == false
              && d.keys().hasAll(['pvm', 'arvo', 'luoja_uid'])
              && d.keys().hasOnly(['pvm', 'arvo', 'pelaajaId', 'huomio', 'luoja_uid', 'luotu', 'mitatoi'])
              && onPvm(d.pvm)
              && d.luoja_uid == request.auth.uid
              && (!('luotu' in d) || d.luotu == request.time)
              && (!('huomio' in d) || (d.huomio is string && d.huomio.size() <= 280))
              && (!('pelaajaId' in d) || d.pelaajaId == null
                  || (d.pelaajaId is string && t.tyyppi != 'summa'
                      && exists(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(d.pelaajaId))))
              && (
                ('mitatoi' in d && d.mitatoi is string && d.arvo == null
                  && exists(/databases/$(database)/documents/seurat/$(seuraId)/omat_tavoitteet/$(tid)/kirjaukset/$(d.mitatoi)))
                || ((!('mitatoi' in d) || d.mitatoi == null)
                  && ((t.tyyppi == 'maara' && d.arvo == 1)
                    || (t.tyyppi in ['summa', 'viimeisin'] && d.arvo is number)
                    || (t.tyyppi == 'kylla_ei' && d.arvo is bool)))
              );
          }
          allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow create: if omaKirjoittaja()
                        && omaKirjausKelpaa(request.resource.data, get(/databases/$(database)/documents/seurat/$(seuraId)/omat_tavoitteet/$(tid)).data);
          allow update, delete: if false;
        }
      }
      match /kausikuvat/{kausi} {
        allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow create: if (onSuperAdmin()
                          || (onOmaSeura(seuraId) && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']))
                      && request.resource.data.keys().hasAll(['kausi', 'luotu', 'pelaajat'])
                      && request.resource.data.pelaajat is list;
        allow update, delete: if false;   // muuttumaton; GDPR-poisto Admin SDK:lla (palvelin)
      }

      match /harjoitusarvioinnit/{arvioId} {
        allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
        allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId);
        allow delete:         if onSuperAdmin();

        // ── Palautekerros (Vaihe 2.1, HARJOITUSARVIOINTI_VAIHE2_SPEC §5) — kaksi ERI alikokoelmaa,
        // koska Firestore-luku on dokumenttitasolla (kenttää ei voi piilottaa lukijalta). Rules eivät periydy → omat blokit.
        // JAETTU = näkyy valmentajalle (oma seura). YKSITYINEN = vain johto/SA (valmentaja EI saa lukea).
        match /palaute_jaettu/{palauteId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == request.resource.data.tekija_uid;
          allow update: if onSuperAdmin() || onJohtoRooli() || request.auth.uid == resource.data.tekija_uid;
          allow delete: if onSuperAdmin();
        }
        match /palaute_yksityinen/{palauteId} {
          allow read:   if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());   // KRIITTINEN: valmentaja ei saa lukea
          allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }
      }

      // ── PELAAJAT ────────────────────────────────────────────────────────
      // read: super admin | oma seura | pelaaja itse (palvelintoken, v3.25) | huoltaja (v2.3)
      // v3.28: anonyymi PIN-luku poistettu — PIN tarkistetaan palvelimella (pelaajaKirjaudu).
      match /pelaajat/{pelaajaId} {
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId))
                      || onPelaajaItse(seuraId, pelaajaId)
                      || (onKirjautunut()
                          && request.auth.token.email is string
                          && resource.data.huoltajaEmail is string
                          && request.auth.token.email.lower()
                             == resource.data.huoltajaEmail.lower());
        // v3.30 (PR 4): PIN asetetaan VAIN palvelimella (asetaPelaajanPin / luoPinitSeuralle / vahvistaSuostumus),
        // jotta hajautus (_pelaajaPin) ja selväkielinen kopio pysyvät samana. Koskee myös SA:n selainkirjoituksia.
        allow create: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)) && pinEiAsetetaClientista()
                      && suostumusEiAsetetaClientista() && kayttoasteEiAsetetaClientista();
        allow update: if pinEiMuutuClientista() && suostumusEiMuutuClientista() && kayttoasteEiMuutuClientista() && (
                         onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)   // permissio-joukkulukko: ADAR-pikakentät ym. vain oman joukkueen pelaajaan (johto ohittaa)
                      || onTestivastaava(seuraId)   // testituonnin profiili-pikakentät (hh_taso/hh_viimeisin/mas_kmh)
                      || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                      // Pelaaja itse saa päivittää VAIN oman xp/streak-pelillistyksen
                      // (_tallennaKirjaus-batch). Sama luottamusmalli kuin kirjaukset.
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['xp', 'streak', 'streak_paivitetty']))
                      // v3.67: PIN-pelaajan vanhat D3-pikakentät (d3_viimeisin / d3_taso / d3_pvm / d3_varmuus) EIVÄT ole enää sallittuja — pelaaja kirjoittaa D3:sta vain d3_itsearvio (alla).
                      // v3.66 (Vaihe 1 / 1d): pelaajan OMA D3-itsearvio (B) — VAIN tämä kenttä, muoto validoitu; valmentajan/VP:n pisteet ovat sisainen/tiedot-dokumentissa (pelaaja ei pääse).
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['d3_itsearvio']) && d3ItsearvioKelpaa())
                      // IDP-kortti v2 §4 — PIN-pelaaja: oma sitoumus-pikakenttä (idp_sitoumus_pvm). Sama anon-luottamusmalli.
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['idp_sitoumus_pvm']))
                      // P7-c.4a — PIN-pelaaja/vanhempi: oma notif-asetus (opt-out / hiljaiset tunnit). Sama anon-luottamusmalli.
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['notif_asetukset']))
                      // v3.45 — PIN-pelaaja: ennätysjuhlan nähty-merkki ({ avain: 'YYYY-MM-DD' }). VAIN tämä kenttä; map, enintään 200 avainta. localStorage = välimuisti.
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['ennatys_nahty'])
                          && request.resource.data.ennatys_nahty is map
                          && request.resource.data.ennatys_nahty.size() <= 200)
                      // R6.3-B (v3.37) — PIN-pelaaja: oma valinta (D8, `ydinvahvuus_valinta`; kenttänimi neutraali, sana käännöksistä). VAIN tämä kenttä → pelaaja ei voi kirjoittaa
                      // jaksofokus-kenttää. Muoto rajattu heti: map {vaihtoehto (merkkijono ≤ 60), valittu_pvm (valinnainen, YYYY-MM-DD)}; tiukennetaan kun K3 lukitaan.
                      || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['ydinvahvuus_valinta'])
                          && request.resource.data.ydinvahvuus_valinta is map
                          && request.resource.data.ydinvahvuus_valinta.keys().hasOnly(['vaihtoehto', 'valittu_pvm'])
                          && request.resource.data.ydinvahvuus_valinta.keys().hasAll(['vaihtoehto'])
                          && request.resource.data.ydinvahvuus_valinta.vaihtoehto is string
                          && request.resource.data.ydinvahvuus_valinta.vaihtoehto.size() > 0
                          && request.resource.data.ydinvahvuus_valinta.vaihtoehto.size() <= 60
                          && (!('valittu_pvm' in request.resource.data.ydinvahvuus_valinta)
                              || (request.resource.data.ydinvahvuus_valinta.valittu_pvm is string
                                  && request.resource.data.ydinvahvuus_valinta.valittu_pvm.size() == 10)))
                      // Vaihe 4a — jaksofokus + tt_positio_aktiivinen (operatiivinen teknis-taktinen pelitavoite, §4
                      // roolimalli). Kenttäomistajuus: valmentaja/talenttivalmentaja/VP (onValmentajaRooli) saavat
                      // jo koko-dokin updaten (yllä); tämä tekee EKSPLISIITTISEKSI että myös johto (onJohtoRooli =
                      // vp/utj/seurasihteeri) saa tarkan field-level-writen näihin kahteen pikakenttään (§26 talent-
                      // hallinta, §37). Ei vaadi hyväksyntää (ei byrokratisoida jaksoja); talenttirajaus = UI-taso
                      // (kuten muut valmentaja-writet). Kausitavoite (IDP §3a/idp_kausi) pysyy VP-hyväksyttynä erikseen.
                      // Vaihe 6 — jaksofokus_historia (meso-syklin sulku, append pikakenttä-array §26):
                      // sama kenttäomistajuus kuin jaksofokus (joukkuevalmentaja/talenttivalmentaja/VP sulkee omat
                      // pelaajansa). Sulku kirjoittaa jaksofokus (korvaa/nollaa) + jaksofokus_historia (append) yhdessä.
                      // Piirrokset Vaihe 1 · B2 (v3.14) — tt_positio_toissijainen: TOISSIJAINEN pelipaikka.
                      // Sama kenttäomistajuus ja sama portti kuin ensisijaisella (tt_positio_aktiivinen);
                      // pelipaikkakonseptit tarjotaan kummallekin. Fysioterapeutti EI saa tätä (ks. alla).
                      || (onOmaSeura(seuraId) && (onValmentajaRooli() || onJohtoRooli())
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['jaksofokus', 'tt_positio_aktiivinen', 'tt_positio_toissijainen', 'jaksofokus_historia']))
                      // Vaihe 7 (v3.11) — fysioterapeutti: fyysisen jakson sulku/arvio. VAIN jaksofokus +
                      // jaksofokus_historia (EI tt_positio_aktiivinen — ei kuulu fysioterapeutille). §4/§37.
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti'
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['jaksofokus', 'jaksofokus_historia']))
                      // FA-potentiaali (Scouting-linssi) — scoutin projektio uran katosta, VP/johto asettaa
                      // (_vpVoiMuokata; SA kattaa yllä). EI scout-roolia (myöhempi identiteettimuutos). Field-level:
                      // vain scout_potentiaali*-pikakentät (ei koske 5D/IDP:tä). ⏳ ODOTTAA CONSOLE-DEPLOYTA (§12).
                      || (onOmaSeura(seuraId) && onJohtoRooli()
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['scout_potentiaali', 'scout_potentiaali_taso', 'scout_potentiaali_huomiot', 'scout_potentiaali_pvm', 'scout_potentiaali_arvioija'])))
                      && vastuuhenkiloMuutosKelpaa(seuraId, pelaajaId)   // v3.38: vastuuhenkilo-kentän asettajat + muoto
                      && ydinvahvuusAlueMuutosKelpaa() && jaksofokusReittiKelpaa();   // v3.64 (B1): ydinvahvuus.alue muoto + asettaja; jaksofokus.reitti.loppu enum
        // GDPR (#96): pelaajan pääDocin poisto VAIN SA (client). Aiempi johto-client-delete poisti vain
        // pääDocin → JÄTTI orvoiksi alikokoelmat + ristiviitteet + Storage-media + Auth (GDPR-rikkomus,
        // spec §0.1/§0.5). Johto poistaa nyt RTBF-CF:n (poistaPelaajaGDPR) kautta, joka tekee TÄYDEN
        // recursiveDelete-siivouksen Admin SDK:lla (ohittaa Rules). Asiakas/anon/valmentaja: ei delete.
        allow delete: if onSuperAdmin();

        // ── Havainnot — pelaajan henkilökohtaiset ADAR-kortit ─────────────
        // read: + pelaaja itse (Pelaaja-näkymä) + huoltaja (v2.3)
        // update: + pelaaja itse, jotta pelaaja_lukenut-merkintä toimii (§13 P6)
        match /havainnot/{havaintoId} {
          /* NÄKYVYYS (v3.22): pelaajaistunto ja huoltaja näkevät VAIN havainnot, jotka
             valmentaja on merkinnyt pelaajalle. Aiemmin kumpikin näki kaikki valmiit havainnot,
             joten Taso 1:n "Valmentajan muistiinpano" meni 8–12-vuotiaalle sellaisenaan.
             Rules EI suodata: kyselyssä on oltava `nakyvyys=='pelaaja'`, muuten se hylätään. */
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || (onPelaajaItse(seuraId, pelaajaId) && resource.data.get('nakyvyys', '') == 'pelaaja')
                        || (onLapsenHuoltaja(seuraId, pelaajaId)
                            && resource.data.get('nakyvyys', '') == 'pelaaja');
          allow create: if (onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId))   // permissio-joukkulukko (johto ohittaa)
                        && luotuLuontiKelpaa();                       // A5
          /* PELAAJAN KIRJOITUS RAJATTU (v3.22): pelaajaistunto tarvitsee vain lukukuittauksen,
             mutta sai muuttaa mitä tahansa kenttää — myös omia pisteitään ja näkyvyyttään. */
          allow update: if (onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                        || (onPelaajaItse(seuraId, pelaajaId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pelaaja_lukenut'])
                            && resource.data.get('nakyvyys', '') == 'pelaaja'))
                        && luotuPaivitysKelpaa()                      // A5
                        && peruminenKelpaa(seuraId);                  // v3.23 — tekijä tai seuran johto
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Kenttatarkkailut — kohdennettu pelihavainto (ottelun aikainen kirjaus) ──
        // OMA KOKOELMA, EI `havainnot`. Kaksi syyta:
        //  1) TIETOSUOJA: `havainnot`-lukusaanto sisalsi anonyymiehdon (ennen v3.28) (pelaajan PIN-istunto),
        //     eika sita ole rajattu omaan pelaajaan. Kenttatarkkailu on valmentajan havainto
        //     alaikaisesta, eika sita tarvitse nayttaa pelaajalle lainkaan (§7.22). Omalla
        //     kokoelmalla luku rajataan heti oikein koskematta laajempaan anonyymiaukkoon.
        //  2) `havainnot`-kokoelmaa lukee moni (ADAR-pikakentat, VAI+, pelaajan P6-kuuntelija,
        //     pelaajakortin listat) — jokainen niista pitaisi muuten vartioida erikseen.
        // EI anonyymia eika huoltajaa. Kielletyt kentat estetaan Rules-tasolla, koska ne
        // kaantaisivat toisen nakyman tulkitsemaan dokumentin vaarin (pisteet → ADAR-pisteet,
        // narratiivi/teksti/oppimisnakokohta → naytetaan pelaajalle).
        match /kenttatarkkailut/{tarkkailuId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()));
          allow create: if (onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa()
                        && request.resource.data.valmentajaUid == request.auth.uid
                        // id paattyy omaan uid:hen: toisen uid:lla varattu id kaantaisi hanen oman
                        // tallennuksensa paivitykseksi, jonka update-saanto torjuu (hiljainen lukko)
                        && (onSuperAdmin() || tarkkailuId.matches('.*_' + request.auth.uid))
                        && !request.resource.data.keys().hasAny(['pisteet','narratiivi','teksti','oppimisnakokohta']);
          allow update: if (onSuperAdmin()
                        || (onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                            && resource.data.valmentajaUid == request.auth.uid))
                        && luotuPaivitysKelpaa()
                        // tekijaa ei voi vaihtaa: muuten dokumentin voisi siirtaa toisen nimiin
                        && request.resource.data.valmentajaUid == resource.data.valmentajaUid
                        && !request.resource.data.keys().hasAny(['pisteet','narratiivi','teksti','oppimisnakokohta']);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Tavoitteet (IDP-tavoitteet, Vaihe 2 — docs/MDT_RAPORTTI_SPEC §0) — valmentaja kirjaa omille pelaajilleen ──
        // read: SA | oma seura (VP/johto näkee kaikki, valmentaja oman joukkueen UI:ssa). create/update: SA |
        // oman seuran valmentaja (joukkuerajaus UI-tasolla kuten havainnot; Rules rajaa oman seuran valmentajaan).
        // delete: SA | johto. luotu-vartija A5. Pikakenttä tavoite_aktiivinen_kpl → pelaaja-dokumenttiin (pelaajat-update).
        match /tavoitteet/{tavoiteId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)) && luotuLuontiKelpaa();    // A5
          allow update: if (onSuperAdmin() || onOmanSeuranValmentaja(seuraId)) && luotuPaivitysKelpaa();   // A5
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── Reviewit — MDT-tarkistuskirjaukset (MDT_RAPORTTI / review-kadenssi) ──
        // create/update: johto (VP/UTJ/seurasihteeri) + oman seuran valmentaja + SA. delete: vain SA.
        // Pikakentät (review_viimeisin_pvm/-tyyppi) kirjoitetaan pelaaja-dokumenttiin → pelaajat-update-säännön piirissä.
        // ── SISAINEN (v3.66, Vaihe 1 / PR 1a) — henkilökunnan sisäiset kentät (A), doc-id 'tiedot'. Pelaaja ja huoltaja EIVÄT lue eivätkä kirjoita (ei seuraId-claimia → onOmaSeura epätosi).
        // Kirjoitus: SA | oman joukkueen valmentaja/johto (kuten pelaajadokumentin update) + `seuraId` == polun {sid} (collectionGroup-luku nojaa tähän kenttään). Ryhmät: lib/tm_sisainen.js.
        // v3.68 (Vaihe 1 · PR 1b-1, S1): FYSIOTERAPEUTTI saa kirjoittaa sisainen/tiedot:iin VAIN jaksofokus-osat (jaksofokus_sisainen, historia_sisainen + seuraId/paivitetty) — sama rajaus kuin
        // pelaajadokumentissa (v3.11: fysioterapeutti → vain jaksofokus + jaksofokus_historia). Ei d3_* eikä muita A-kenttiä; ei joukkuerajausta (kuten pelaajadokumentissa).
        match /sisainen/{dokId} {
          allow read:           if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));
          allow create:         if dokId == 'tiedot' && request.resource.data.get('seuraId', '') == seuraId
                                && ( onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                                  || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti'
                                      && request.resource.data.keys().hasOnly(['jaksofokus_sisainen', 'historia_sisainen', 'seuraId', 'paivitetty'])) )
                                && sisainenScoutKelpaa(seuraId, request.resource.data.keys()) && sisainenVastuuKelpaa(seuraId, pelaajaId, request.resource.data.keys());   // v3.69
          allow update:         if dokId == 'tiedot' && request.resource.data.get('seuraId', '') == seuraId
                                && ( onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                                  || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti'
                                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jaksofokus_sisainen', 'historia_sisainen', 'seuraId', 'paivitetty'])) )
                                && sisainenScoutKelpaa(seuraId, request.resource.data.diff(resource.data).affectedKeys()) && sisainenVastuuKelpaa(seuraId, pelaajaId, request.resource.data.diff(resource.data).affectedKeys());   // v3.69
          allow delete:         if onSuperAdmin();
        }

        match /reviewit/{reviewId} {
          allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
          allow create, update: if (onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || onOmanSeuranValmentaja(seuraId)) && reviewKevytKelpaa();   // v3.46: kevyt-enum
          allow delete:         if onSuperAdmin();
        }

        // ── Päivittäiset kirjaukset (T/D/S/P) ─────────────────────────────
        // PÄÄTÖS 1: jokaisessa kirjauksessa lahde-kenttä (valmentaja|pelaaja|vanhempi|vp|talenttivalmentaja).
        // PÄÄTÖS 2: VP + talenttivalmentaja (oma seura) saavat kirjata eksplisiittisesti (sisältyvät jo
        //   onOmanSeuranValmentaja():iin — klausuulit selventävät policy-päätöksen); huoltaja saa kirjata
        //   U12-lapselle kun lahde=='vanhempi' (onU12Huoltaja).
        // v3.59 (K35-6f): harjoituskertymä — viikkokorit, vain palvelin kirjoittaa; henkilökunta lukee (pelaaja/huoltaja callablella haePelaajanKertyma)
        match /kooste/{koosteId} {
          allow read:  if onSuperAdmin() || (onOmaSeura(seuraId) && (onJohtoRooli() || request.auth.token.rooli == 'talenttivalmentaja' || onOmanJoukkueenValmentaja(seuraId, pelaajaId)));   // v3.60: + talenttivalmentaja
          allow write: if false;
        }

        match /kirjaukset/{pvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)   // pelaaja kirjaa itse PIN-tilassa
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.uid == pelaajaId)
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'vp')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'urheilutoimenjohtaja')
                        || (onOmaSeura(seuraId) && request.auth.token.rooli == 'talenttivalmentaja')
                        || onU12Huoltaja(seuraId, pelaajaId)
                        // v3.37 (R6.3-B): U12-huoltaja kuittaa jakson kotitehtävän — VAIN `jakso_kuittaus` (merge omaan kenttään; ei kosketa tehty/tyyppi/lahde/streakiin)
                        || (onU12HuoltajaIka(seuraId, pelaajaId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jakso_kuittaus'])
                            && request.resource.data.jakso_kuittaus is map
                            && request.resource.data.jakso_kuittaus.get('lahde', '') == 'vanhempi'))
                        && luotuPaivitysKelpaa();                     // A5
        }

        // ── K4 (v3.44) — pelaajan viikkokatsaus: luku SA | oman seuran henkilökunta | pelaaja itse; create vain pelaaja itse; ei update/delete ──
        match /viikkokatsaukset/{pvm} {
          allow read:   if onSuperAdmin()
                        || (onKirjautunut() && onOmaSeura(seuraId))
                        || onPelaajaItse(seuraId, pelaajaId);
          allow create: if onPelaajaItse(seuraId, pelaajaId) && vkKelpaa(pvm);
          allow update, delete: if false;
        }

        // ── P7-c.4a — KULUTTAJA-NOTIFIKAATIOT (kalenterimuistutus/muutos/peruutus, NOTIFIKAATIOT_JA_MOBIILI.md §B) ──
        // CF (admin SDK) kirjoittaa; anon-PIN (pelaaja/vanhempi) lukee + merkitsee luetuksi OMAT. Anon-uid ≠ pelaajaId
        // → ei uid-skooppausta (sama laaja anon-malli kuin c.1/c.3). CREATE vain SA/CF → client (myös anon) EI voi
        // väärentää toisen notifia (turvakriittinen). Anon-update rajattu affectedKeysilla vain 'luettu'-merkintään.
        match /notifikaatiot/{notifId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId) || onPelaajaItse(seuraId, pelaajaId) || onLapsenHuoltaja(seuraId, pelaajaId);
          allow update: if onSuperAdmin()
                        || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luettu', 'luettu_pvm']));
          allow create: if onSuperAdmin();   // vain CF/SA (admin-SDK) — client ei väärennä
          allow delete: if onSuperAdmin();
        }

        // ── Tapahtumat (LEGACY — käytä mieluummin testitapahtumat) ────────
        match /tapahtumat/{tapahtumaId} {
          allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
          allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        }

        // ── IDP (kausikohtainen kehityssuunnitelma) ───────────────────────
        match /idp/{idpId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── VP-muistiinpanot per pelaajalle (v2.4) ────────────────────────
        // VP tekee muistiinpanon pelaajasta. Näkyvyys flaggeilla:
        // naytaValmentajalle: valmentaja-roolit saavat lukea
        // naytaPelaajalle:    pelaaja itse saa lukea
        // Default: vain VP/UTJ/seurasihteeri näkevät.
        match /vp_muistiinpanot/{muistiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (resource.data.naytaValmentajalle == true
                            && onOmanSeuranValmentaja(seuraId))
                        || (resource.data.naytaPelaajalle == true
                            && onPelaajaItse(seuraId, pelaajaId));
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── Testitulokset (v2.6) — historiapohja-tuonti ──────────────────
        // Excel_Tuonti.html:n historia-moodi kirjoittaa tänne. Doc-ID on
        // muotoa {pvm}_{protokolla} (esim. "2026-05-13_tekniikkakilpailu")
        // jotta sama pelaaja samana päivänä eri protokollalla ei ylikirjoita.
        // Pelaaja näkee omat tuloksensa PIN-tilassa; huoltaja näkee lapsensa.
        match /testitulokset/{pvmProto} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          // Kirjoitus: VP/UTJ (johto) + testivastaava + oman joukkueen valmentaja (v3.36, Masterin Pikakirjaus).
          // EI seurasihteeri (valmennusdata, ei valmentajarooli).
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId)
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId);
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (request.auth.token.rooli == 'vp'
                                                    || request.auth.token.rooli == 'urheilutoimenjohtaja'))
                        || onTestivastaava(seuraId)
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId);
          allow delete: if onSuperAdmin();
        }

        // ── Biologinen ikä (v2.8) — Mirwald PHV -mittaushistoria ──────────
        // Testaus_v9 (kasvumittaus-protokolla) kirjoittaa tänne; doc-ID on
        // mittauspäivä (esim. "2026-05-25"). VP-pikakentät (phv_tila,
        // biologinenIka_viimeisin) kirjoitetaan suoraan pelaajadokumenttiin
        // (pelaajat-update sallii valmentajan, ei hasOnly-rajoitusta).
        // Pelaaja näkee oman PHV-tilansa PIN-tilassa; huoltaja näkee lapsensa.
        // Firestore EI periydy alikokoelmiin → oma blokki pakollinen (§17 #18).
        match /biologinen_ika/{mittausPvm} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin();
        }

        // ── Arviointi — Palloliitto-taksonomia, havaittu 1–5 (Vaihe 2b) ───
        // VP/valmentajan asiantuntija-arvio (aikuisten työkalu, §7.22): luku VAIN
        // SA + oman seuran henkilöstö — EI anon (pelaaja) eikä huoltaja (raaka
        // "Poor"-arvio ei näy lapselle/perheelle). Kirjoitus valmentaja/johto.
        // doc-ID = kausi ilman "/" (esim. 2026-27, §11). Pikakentät
        // (arviointi_havaittu/_pvm/_kehys) menevät pelaajadokumenttiin (jo sallittu).
        /* H1 — ARVIOINTIKERRAT (append-only). Jokainen kerta = yksi arvioija + yksi konteksti.
           Kerta EI ole seuran yhteinen arvosana, joten vain tekija saa muokata omaansa ja vain
           24 h ajan; poisto vain SA:n CF:lla (GDPR). Seura nakee vain jaetut kerrat — Rules EI
           suodata kyselya, joten seuran kyselyn PAKKO sisaltaa where('nakyvyys','==','seuralle'). */
        match /arviointikerrat/{kertaId} {
          /* resource == null = dokumenttia EI OLE. Ilman tata haaraa `resource.data.nakyvyys`
             evaluoituu nulliin ja LUKU HYLATAAN — jolloin kirjoituksen aloittava tx.get()
             kaatuu heti paivan ENSIMMAISELLA klikkauksella jokaisella seuran kayttajalla.
             (SA ei huomaa: onSuperAdmin() osuu ketjussa ensin.) Olemattoman dokumentin
             lukeminen ei paljasta mitaan. */
          allow read:   if onSuperAdmin() || onPalloliitto()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli())
                            && (resource == null || resource.data.nakyvyys == 'seuralle'));
          allow create: if request.resource.data.arvioija_uid == request.auth.uid
                        && (
                             (onPalloliitto() && request.resource.data.arvioija_org == 'palloliitto')
                          || ((onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                               || (onOmaSeura(seuraId) && onJohtoRooli()))
                              && request.resource.data.arvioija_org == 'seura'
                              && request.resource.data.nakyvyys == 'seuralle')
                        );
          allow update: if resource.data.arvioija_uid == request.auth.uid
                        && request.resource.data.arvioija_uid == resource.data.arvioija_uid
                        && request.resource.data.arvioija_org == resource.data.arvioija_org
                        && request.resource.data.luotu == resource.data.luotu
                        && (
                             request.time < resource.data.luotu + duration.value(24, 'h')
                             // Palloliitto voi jakaa sisaisen seuralle myohemminkin — vain tahan
                             // suuntaan ja vain nakyvyys-kentta (ei sisallon muokkausta ikkunan jalkeen).
                          || (resource.data.nakyvyys == 'sisainen'
                              && request.resource.data.nakyvyys == 'seuralle'
                              && request.resource.data.diff(resource.data).affectedKeys()
                                   .hasOnly(['nakyvyys', 'paivitetty']))
                        );
          allow delete: if false;   // SA-poisto CF:n Admin SDK:lla (GDPR, B4)
        }

        /* Vanha kausikohtainen arviointidoc: H1 lopetti kirjoituksen (kausi-doc korvasi toisen
           arvioijan arvion). Jaa read-only-arkistoksi kunnes migraatio on ajettu kaikille. */
        match /arviointi/{kausiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()));
          allow create: if onSuperAdmin()
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId)   // permissio-joukkulukko (johto ohittaa)
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin()
                        || onOmanJoukkueenValmentaja(seuraId, pelaajaId)
                        || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin();
        }

        // ── IDP-kausitavoite (Vaihe 3a, IDP-ydin) ────────────────────────
        // seurat/{sid}/pelaajat/{pid}/idp_kausi/{vuosi} → { tavoitteet: [tavoite-objekti] } (IDP_YDIN_SPEC §2).
        // Kirjoitus: johto + oman seuran valmentaja (§15-pattern, kuten arviointi). LUKU myös pelaajalle (PIN/anon):
        // kausitavoite JAETAAN pelaajalle 3c-peilissä (§7.22-turvallinen render) — eri kuin raaka arviointi (ei anon).
        // Pikakentät (idp_tila/idp_edistyma/idp_fokus) pelaajadokumenttiin (jo sallittu). doc-ID = vuosi ilman "/" (§11).
        match /idp_kausi/{vuosi} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()))
                        || onPelaajaItse(seuraId, pelaajaId);   // pelaaja lukee oman kausitavoitteensa (3c-peili)
          allow create: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        // IDP-kortti v2 §4 — PIN-pelaaja saa luoda OMAN sitoumuksensa jos dokkia ei vielä ole (vain pelaaja_sitoumus).
                        || (onPelaajaItse(seuraId, pelaajaId) && request.resource.data.keys().hasOnly(['pelaaja_sitoumus'])
                            && request.resource.data.pelaaja_sitoumus.vahvistettu_pvm == null);
          allow update: if onSuperAdmin()
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        // IDP-kortti v2 §4 — PIN-pelaaja: OMA sitoumus (vain pelaaja_sitoumus + paivitetty). EI tavoitteita,
                        // EI VP-vahvistusta (vahvistettu_pvm pysyy nykyisenä/null — vain VP/johto asettaa sen).
                        || (onPelaajaItse(seuraId, pelaajaId)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pelaaja_sitoumus', 'paivitetty'])
                            && request.resource.data.pelaaja_sitoumus.vahvistettu_pvm ==
                               (('pelaaja_sitoumus' in resource.data) ? resource.data.pelaaja_sitoumus.get('vahvistettu_pvm', null) : null));
          allow delete: if onSuperAdmin();
        }

        // ── Kehut — vanhemman lähettämä kehu pelaajalle (v2.3) ────────────
        // Yksityinen vanhempi → pelaaja -kanava. Valmentajalla EI lukuoikeutta:
        // pedagoginen suoja, kehu on perheen sisäinen viestintä.
        // Pelaaja itse (onPelaajaItse) saa lukea + kuitata 'nahty:true',
        // mutta EI muokata muita kenttiä → diff.affectedKeys.hasOnly([...]).
        match /kehut/{kehuId} {
          allow read:   if onSuperAdmin()
                        || onPelaajaItse(seuraId, pelaajaId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if (onSuperAdmin()
                        || onLapsenHuoltaja(seuraId, pelaajaId))
                        && luotuLuontiKelpaa();                       // A5
          allow update: if (onSuperAdmin()
                        || (onPelaajaItse(seuraId, pelaajaId)
                            && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['nahty', 'nahtyKlo'])))
                        && luotuPaivitysKelpaa();                     // A5
          allow delete: if onSuperAdmin();
        }

        // ── PALAUTTEET (v3.0) — valmentajan TKI-palaute pelaajalle ────────
        // Master_v16 Testit→Tulokset. nakyvyys:'pelaaja' → pelaaja (PIN +
        // huoltaja) näkee; 'vain_valmentaja' → vain seuran henkilöstö.
        // Doc-ID {pvm}_tki. Firestore ei periydy → oma blokki (§17 #18).
        match /palautteet/{palauteId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || (resource.data.nakyvyys == 'pelaaja'
                            && (onPelaajaItse(seuraId, pelaajaId) || onLapsenHuoltaja(seuraId, pelaajaId)));
          allow create: if onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId);   // permissio-joukkulukko (johto ohittaa)
          allow update: if onSuperAdmin() || onOmanJoukkueenValmentaja(seuraId, pelaajaId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KAYTTAJAT (seuran henkilöstö — Henkilöstö-näkymä) ─────────────
      // Pikakentät (harjoituslaatu_/valmennustaito_, §26) kirjoitetaan tänne: oma UID (itsearvio) tai johto (havainnointi).
      // Ei-SA-päivitys EI saa muuttaa rooli/seuraId-kenttiä (roolinvaihto vain vaihdaKayttajanRooli-CF:n kautta, §13).
      match /kayttajat/{uid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || request.auth.uid == uid;
        // v3.31 (P0): pääsyä ohjaavat kentät (rooli, seuraId, aktiivinen + deaktivointi-/aktivointijälki,
        // claimsAsetettu) muutetaan VAIN palvelimella (deaktivioiKayttaja / aktivoiKayttaja / vaihdaKayttajanRooli),
        // jotta Auth (disabled), claimit ja dokumentti pysyvät samassa tilassa. Koskee myös SA:ta ja käyttäjää itseään.
        // Poisto vain palvelimella (poistaKayttaja: Auth-tili + dokumentti).
        // v3.32: luonti VAIN palvelimella (luoKayttaja kirjoittaa koko dokumentin; ei SA-tunnuksille).
        allow create: if false;
        allow update: if (onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli()) || request.auth.uid == uid)
                      && kayttajaPaasyKentatEnnallaan();
        allow delete: if false;

        // ── REFLEKTIOT (Vaihe 2.3b-1) — valmentajan OMA yksityinen kasvupäiväkirja (standalone-merkinnät + ääni).
        // VAIN oma uid + SA. Johto/VP EI lue (eroaa arviointiin sidotusta reflektiosta, joka näkyy harjoitusarvioinnit-dokissa).
        // Rules eivät periydy → oma blokki. Ääni Storagessa (oma Storage-ruleset, polku peilaa tätä).
        match /reflektiot/{reflId} {
          allow read, write: if onSuperAdmin() || request.auth.uid == uid;
        }

        // ── NOTIFIKAATIOT (N1, NOTIFIKAATIOT_JA_MOBIILI.md §B) — in-app notifit.
        // Client lukee + merkitsee luetuksi VAIN omat; CREATE vain CF (admin-SDK ohittaa Rules) → client ei voi väärentää
        // toisen notifia. Rules eivät periydy → oma blokki.
        match /notifikaatiot/{notifId} {
          allow read, update: if onSuperAdmin() || request.auth.uid == uid;
          allow create:       if onSuperAdmin();   // vain CF/SA — normaali client ei luo
          allow delete:       if onSuperAdmin();
        }
      }

      // ── HAVAINNOT (seurataso — pelaajatasolle ks. pelaajat/{id}/havainnot) ──
      match /havainnot/{havaintoId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── RYHMÄT (v3.47, R1 / D33) ────────────────────────────────────────
      match /ryhmat/{ryhmaId} {
        allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));   // pelaaja/huoltaja: ei seuraId-claimia → ei lue
        allow create: if (onSuperAdmin() || (onOmaSeura(seuraId) && (onJohtoRooli() || request.auth.token.rooli in ['valmentaja', 'talenttivalmentaja', 'fysiikkavalmentaja'])))
                      && ryhmaKelpaa() && request.resource.data.luoja_uid == request.auth.uid && request.resource.data.luotu == request.time
                      && (onSuperAdmin() || onJohtoRooli() || request.auth.uid in request.resource.data.valmentajat);
        allow update: if (onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli())
                          || (onOmanSeuranValmentaja(seuraId) && request.auth.uid in resource.data.valmentajat))
                      && ryhmaKelpaa()
                      && request.resource.data.luoja_uid == resource.data.luoja_uid && request.resource.data.luotu == resource.data.luotu;
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── JOUKKUEET ──────────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read:  if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        // v3.37: write jaettu. create/delete = SA | johto (valmentaja EI luo joukkuedokumenttia); update = SA | johto | valmentaja VAIN jaksokentät (joukkueen jakso).
        allow create: if (onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli())) && profiiliKelpaa() && tyyppiKelpaa() && pelimuodotKelpaa();   // v3.46: valmentajaprofiili-enum · v3.56: tyyppi-enum · v3.64: pelimuodot
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if ((onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli())) && profiiliKelpaa() && tyyppiKelpaa() && pelimuodotKelpaa())
                      || (onOmanSeuranValmentaja(seuraId)
                          && (request.auth.token.rooli == 'talenttivalmentaja'
                              || valmentajanJoukkueet(seuraId).hasAny([joukkueId]))
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jaksofokus', 'jaksofokus_historia', 'pelimuodot'])   // v3.64: + pelimuodot (D107)
                          && pelimuodotKelpaa());

        // ── kalenteri/{kalenteriId} (v2.7) ────────────────────────────────
        // Testaus_v8._tallennaTapahtuma kirjoittaa tänne pikaviittauksen
        // luodusta testitapahtumasta (tyyppi:'testi', ref, pvm, nimi…).
        // Sallittu valmentaja-rooleille kaikkien seuran sisällä.
        match /kalenteri/{kalenteriId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // ── harjoitusprioriteetti/{id} (v3.0) ─────────────────────────────
        // Master_v16: valmentaja asettaa joukkueen harjoitusprioriteetin
        // testidatasta (doc 'aktiivinen'). Koko seura lukee (Tänään-fokus +
        // mahdollinen Pelaaja-näkymä). Firestore ei periydy → oma blokki.
        match /harjoitusprioriteetti/{prioriteettiId} {
          allow read:   if onSuperAdmin() || onOmaSeura(seuraId) || onPelaajanSeura(seuraId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── KUTSUT ────────────────────────────────────────────────────────
      match /kutsut/{kutsuId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        // v3.33: ei kirjautumatonta päivitystä (oli: || resource.data.tila == 'odottaa').
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── ADAR (seurataso — peliäly-arvioinnit) ──────────────────────────
      match /adar/{adarId} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
      }

      // ── MENTOROINNIT — VP:n SISÄINEN historia (valmentaja EI lue) ──────
      // Tänne kirjoitetaan AINA, myös sisäiset muistiinpanot ja jakamattomat
      // SPL-kenttäkäynnit. Jakaminen valmentajalle tapahtuu ERI kokoelman
      // kautta: VP_v25 kirjoittaa `viestit`-kokoelmaan vain kun jaetaan, ja
      // valmentajan Inbox (Master `_kuunteleVpViestit`) lukee vain sitä.
      //
      // Aiempi `onOmaSeura(seuraId)` antoi KENELLE TAHANSA saman seuran
      // valmentajalle luvun sisäisiin muistiinpanoihin häneistä itsestään;
      // `nakyvyys:'sisainen'` oli vain client-suodatin. Sama luokka kuin #563.
      //
      // EI onJohtoRooli(): se kattaa myös seurasihteerin, mikä olisi laajempi
      // kuin kirjoitusoikeus alla. Luku ja kirjoitus peilaavat toisiaan.
      match /mentoroinnit/{mentorointiId} {
        allow read:  if onSuperAdmin()
                     || (onOmaSeura(seuraId)
                         && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
        allow write: if onSuperAdmin()
                     || (onOmaSeura(seuraId)
                         && request.auth.token.rooli in ['vp', 'urheilutoimenjohtaja']);
      }

      // ── ERRORS (seurataso) ─────────────────────────────────────────────
      match /errors/{errorId} {
        allow read:           if onSuperAdmin();
        allow create:         if onKirjautunut() && onOmaSeura(seuraId);
        allow update, delete: if onSuperAdmin();
      }

      // ══════════════════════════════════════════════════════════════════
      // v2.3 — UUDET ALIKOKOELMAT
      // ══════════════════════════════════════════════════════════════════

      // ── TESTITAPAHTUMAT (CLAUDE.md §17 #19, §23) ──────────────────────
      // Korvaa vanhentuneen pelaajat/{id}/testit-rakenteen.
      // Kirjoittajat: Testaus_v8, Harjoitettavuus_Lomake_v4, Excel_Tuonti
      match /testitapahtumat/{tapahtumaId} {
        allow read:   if onKirjautunut() && (onSuperAdmin() || onOmaSeura(seuraId));
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // tulokset/{pelaajaId} — pelaajakohtaiset testitulokset.
        // Huoltaja näkee oman lapsen tulokset.
        match /tulokset/{pelaajaId} {
          allow read:   if onSuperAdmin()
                        || onOmaSeura(seuraId)
                        || onPelaajaItse(seuraId, pelaajaId)
                        || onLapsenHuoltaja(seuraId, pelaajaId);
          allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId) || onTestivastaava(seuraId);
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── TAPAHTUMAT (seurataso, v2.9) — yleistapahtumat + mentoroinnit ──
      // VP_v22 mentorointi-pikamalli (tyyppi:'mentorointi') + Master_v16
      // yleistapahtumat (harjoitus/ottelu/kokous). EI sama kuin pelaajatason
      // legacy /pelaajat/{id}/tapahtumat eikä testitapahtumat.
      match /tapahtumat/{tapahtumaId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── VP_KALENTERI (v2.9) — VP:n deadlinet ja muistutukset (amber) ───
      match /vp_kalenteri/{id} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── SEURANTA_KUITTAUKSET (Vaihe C) — VP:n hälytyskuittaukset (audit-jälki). ─────
      // VP-seurantanäkymä: johto kuittaa valmentajan hälytyksen (Ei havaintoja 30pv ym.).
      // Kirjoitus = VP/johto (onJohtoRooli); luku = oman seuran jäsenet (oversight).
      // EI hard-deletea (audit-linja) → delete vain SA. Valmentaja EI saa kuitata itseään.
      match /seuranta_kuittaukset/{kuittausId} {
        allow read:           if onSuperAdmin() || onOmaSeura(seuraId);
        allow create, update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete:         if onSuperAdmin();
      }

      // ── SEURAN PULSSI S1 (v3.53) — viikkokooste: vain lukumääriä joukkueittain, kirjoittaa vain palvelin ──
      match /kooste/{vk} {
        allow read:  if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId) && onJohtoRooli());
        allow write: if false;
      }
      match /kooste_joukkue/{koosteId} {
        allow read:  if onSuperAdmin()
                     || (onKirjautunut() && onOmaSeura(seuraId)
                         && (onJohtoRooli()
                             || request.auth.token.rooli == 'talenttivalmentaja'
                             || (request.auth.token.rooli == 'valmentaja' && resource.data.get('jid', '') in valmentajanJoukkueet(seuraId))));
        allow write: if false;
      }

      // ── KALENTERI (v3.5) — seuran pääkalenteri (KALENTERI_ARKKITEHTUURI.md §3/§7) ──
      // Korvaa legacy tapahtumat + vp_kalenteri + joukkueet/{jid}/kalenteri yhdellä
      // kokoelmalla. Kaikki tapahtumatyypit: testi, ottelu, harjoitus, palaveri,
      // mentorointi, kalibraatiopaja, IDP-seuranta, talenttileiri, muu.
      //
      // Omistajuus (v3.5): johto = täysi CRUD; valmentaja/talenttivalmentaja = täysi
      // muokkaus OMIIN (luoja_uid == auth.uid), MUIDEN tapahtumiin vain field-level
      // (muistiinpanot + läsnäolo-kooste + audit). Soft-delete: poistettu=true, EI hard-deletea.
      match /kalenteri/{tapahtumaId} {
        // P7-c.1 (v3.25–v3.54): pelaaja luki seuran aikataulun suoraan ja suodatti appissa → v3.55 siirsi rajauksen palvelimelle (ks. alla). Write ENNALLAAN.
        // v3.55 (B4): pelaaja/huoltaja EIVÄT lue kalenteria suoraan (ei get eikä list) — vain callable haePelaajanKalenteri (palvelin rajaa tapahtumat ja kentät).
        allow read:   if onSuperAdmin()
                      || (onKirjautunut() && onOmaSeura(seuraId));

        // Luonti: VP/johto (vapaa) TAI valmentajarooli joka asettaa luoja_uid == oma uid.
        // v3.52: `muistiinpanot`-kenttä ei saa olla tapahtumadokumentissa (pelaaja lukee kalenterin) — vain henkilokunta/muistiinpanot-alikokoelmassa.
        allow create: if !('muistiinpanot' in request.resource.data)
                      && kalTyyppiSaaKirjoittaa(seuraId, request.resource.data)   // v3.58 (K35-6d): seuran tauko vain johto; vapaa/erikoisohjelma: joukkue pakollinen, valmentaja oma joukkue
                      && (onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && request.resource.data.luoja_uid == request.auth.uid));

        // Päivitys:
        //  · SA / johto → kaikki
        //  · valmentaja OMAAN tapahtumaan (luoja_uid == uid) → kaikki
        //  · valmentaja MUIDEN tapahtumaan → vain field-level
        //    (läsnäolo-kooste + RPE + aikaleima; muistiinpanot vain henkilokunta-alikokoelmassa, v3.52/v3.53; EI soft-deletea/nimeä/aikaa muille).
        allow update: if !('muistiinpanot' in request.resource.data)   // v3.52: kenttä pois tapahtumadokumentista (poistava update sallittu)
                      && kalTyyppiSaaKirjoittaa(seuraId, request.resource.data) && kalTyyppiSaaKirjoittaa(seuraId, resource.data)   // v3.58 (K35-6d): uusi JA vanha dokumentti
                      && (onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.luoja_uid == request.auth.uid)
                      || (onOmanSeuranValmentaja(seuraId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['paivitetty', 'muokkaaja_uid',
                                       'lasnaolo_kooste', 'valmentaja_rpe', 'valmentaja_rpe_pvm']))
                      // v3.47 (R1): RYHMÄTAPAHTUMA — ryhmän valmentaja (myös toisen joukkueen) synkkaa kokoonpanon ja jäädyttää sen (pelaajat_id + jaadytetty),
                      // vaikka ei ole tapahtuman luoja. Jäädytetyn pelaajat_id ei muutu; jaadytetty asetetaan kerran.
                      || (onOmanSeuranValmentaja(seuraId) && ryhmanValmentajaTapahtumassa(seuraId)
                          && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['pelaajat_id', 'jaadytetty', 'paivitetty', 'muokkaaja_uid', 'lasnaolo_kooste'])
                          && (resource.data.get('jaadytetty', null) == null
                              || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pelaajat_id', 'jaadytetty'])))
                      // v3.61 (K35-6c, D196): ryhmän VASTAAVA — täysi muokkaus + soft-delete omaan ryhmän tapahtumaan (ei tarvitse olla luoja); kohde ja luoja_uid lukittu.
                      || (onOmanSeuranValmentaja(seuraId) && ryhmanVastaavaTapahtumassa(seuraId)
                          && request.resource.data.get('kohde', {}).get('tyyppi', '') == 'ryhma'
                          && request.resource.data.kohde.get('ryhma_id', '') == resource.data.kohde.ryhma_id
                          && request.resource.data.get('luoja_uid', '') == resource.data.get('luoja_uid', '')));

        // Ei hard-deletea — soft-delete (poistettu:true) update-kautta
        allow delete: if onSuperAdmin();

        // ── v3.48 (P0 tietosuoja): henkilökunnan alikokoelma — valmentajan muistiinpano EI tapahtumadokumentissa (pelaaja lukee kalenterin) ──
        match /henkilokunta/{dokId} {
          allow read:   if onSuperAdmin() || (onKirjautunut() && onOmaSeura(seuraId));   // pelaaja: pelaajaSeuraId ≠ seuraId → ei; huoltaja: ei claimia → ei
          allow create, update: if dokId == 'muistiinpanot'
                        && (onSuperAdmin() || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli())))
                        && request.resource.data.keys().hasOnly(['teksti', 'muokkaaja_uid', 'paivitetty'])
                        && request.resource.data.keys().hasAll(['teksti', 'paivitetty'])
                        && request.resource.data.teksti is string && request.resource.data.teksti.size() <= 500
                        && request.resource.data.paivitetty == request.time;
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && (onJohtoRooli() || onValmentajaRooli()));
        }

        // ── Läsnäolijat (alikokoelma) — KALENTERI_ARKKITEHTUURI.md §7 ──
        // Valmentaja/johto merkitsee läsnäolon per pelaaja (osallistujaId = pelaajaId).
        // Pelaaja vahvistaa OMAN läsnäolonsa (uid == osallistujaId).
        match /lasnaolijat/{osallistujaId} {
          // v3.48 (P0 tietosuoja): pelaaja/huoltaja lukee VAIN OMAN läsnäolo-/saatavuusdokumentin (ei muiden pelaajien läsnäoloja). Henkilökunta ennallaan.
          allow read:   if onSuperAdmin()
                        || (onKirjautunut() && onOmaSeura(seuraId))
                        || onPelaajaItse(seuraId, osallistujaId)
                        || onLapsenHuoltaja(seuraId, osallistujaId);
          // P7-c.3 + RSVP-erotus: PIN-pelaaja/vanhempi (anon) ilmoittaa oman SAATAVUUTENSA (RSVP: tulossa/estynyt).
          // Anon-token ei kanna pelaajaId:tä (uid ≠ osallistujaId) → ei uid-skooppausta; laaja anon-luottamusmalli
          // rajattuna affectedKeysilla VAIN saatavuus (+ paivitetty/rooli). ⚠️ Turvaparannus: anon EI voi kirjoittaa
          // 'tila':aa (= valmentajan TOTEUTUNUT läsnäolo) → pelaaja ei voi väärentää läsnäoloaan. Ei syytä (GDPR Art. 9).
          // create: resource.data == null → diff ei toimi → keys().hasOnly. update: diff().affectedKeys().hasOnly.
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && request.auth.uid == osallistujaId)
                        || (onPelaajaItse(seuraId, osallistujaId) && request.resource.data.keys().hasOnly(['saatavuus', 'paivitetty', 'rooli']))
                        || (huoltajaRsvp(seuraId, osallistujaId) && request.resource.data.keys().hasOnly(['saatavuus', 'paivitetty', 'rooli']));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || onOmanSeuranValmentaja(seuraId)
                        || (onOmaSeura(seuraId) && request.auth.uid == osallistujaId)
                        || (onPelaajaItse(seuraId, osallistujaId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saatavuus', 'paivitetty', 'rooli']))
                        || (huoltajaRsvp(seuraId, osallistujaId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['saatavuus', 'paivitetty', 'rooli']));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── IDP_JONO — IDP-aktivointiehdotusten jono ──────────────────────
      // Valmentaja ehdottaa IDP:tä → VP/UTJ hyväksyy. Valmentaja saa
      // muokata omaa ehdotustaan niin kauan kuin tila on 'ehdotettu' tai
      // 'odottaa' (v2.5 — uusi standardi käyttöön rinnakkain vanhan kanssa).
      match /idp_jono/{idpId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin() || onOmanSeuranValmentaja(seuraId);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmanSeuranValmentaja(seuraId)
                          && resource.data.tila in ['ehdotettu', 'odottaa']
                          && resource.data.valmentajaUid == request.auth.uid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── META — VP:n metadatakanava (Sprint 3) ─────────────────────────
      // Esim. phv_snapshot — kasvuvaiheessa olevien pelaajien lukumäärä
      // viime laskennalta, jotta renderSignals voi tunnistaa kasvun.
      // Koko seura lukee (signaali näkyy myös valmentajalle), VP/UTJ
      // /seurasihteeri kirjoittaa.
      match /meta/{metaKey} {
        allow read:  if onSuperAdmin() || onOmaSeura(seuraId);
        allow write: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
      }

      // ── OHJELMAT — fysiikkaohjelmakirjasto (Vaihe 7.2a, v3.12) ─────────
      // Deterministinen kirjasto: tallenna/versioi/arkistoi fyysiset ohjelmat, liitä jaksoon.
      // Kirjoitus: oman seuran valmentajaroolit (sis. fysiikkavalmentaja) + fysioterapeutti + johto.
      // Luku: oma seura. KOVA DELETE ESTETTY — arkistointi = update (arkistoitu:true). §6.
      match /ohjelmat/{ohjelmaId} {
        allow read:   if onSuperAdmin() || onOmaSeura(seuraId);
        allow create: if onSuperAdmin()
                      || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti')
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow update: if onSuperAdmin()
                      || onOmanSeuranValmentaja(seuraId)
                      || (onOmaSeura(seuraId) && request.auth.token.rooli == 'fysioterapeutti')
                      || (onOmaSeura(seuraId) && onJohtoRooli());
        allow delete: if onSuperAdmin();
      }

      // ── VALMENTAJAT — valmentajan oma datatila (CLAUDE.md §10) ────────
      match /valmentajat/{valmentajaUid} {
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow create: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow update: if onSuperAdmin()
                      || (onOmaSeura(seuraId) && onJohtoRooli())
                      || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
        allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());

        // valmentajat/{uid}/kontribuutio/{palloID} — pelaajakohtainen vaikutus
        match /kontribuutio/{palloID} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow update: if onSuperAdmin()
                        || (onOmaSeura(seuraId)
                            && (onJohtoRooli() || request.auth.uid == valmentajaUid));
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }

        // valmentajat/{uid}/tuloskortti/{tuloskorttiId} — VP arvioi valmentajaa
        match /tuloskortti/{tuloskorttiId} {
          allow read:   if onSuperAdmin()
                        || (onOmaSeura(seuraId) && onJohtoRooli())
                        || (onOmaSeura(seuraId) && request.auth.uid == valmentajaUid);
          allow create: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow update: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
          allow delete: if onSuperAdmin() || (onOmaSeura(seuraId) && onJohtoRooli());
        }
      }

      // ── VIESTIT — seuran sisäiset viestit ─────────────────────────────
      // Lähettäjä + vastaanottaja näkevät. Vastaanottaja saa muokata
      // (luku-merkintä). Vain super admin saa poistaa (audit-jälki).
      match /viestit/{viestiId} {
        /* v3.39 — NÄKYVYYS (sama sanasto kuin havainnot.nakyvyys; puuttuva = 'henkilokunta'). Rules EI suodata kyselyä: pelaajan/huoltajan kyselyssä on oltava nakyvyys-ehto. */
        allow read:   if onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && (request.auth.uid == resource.data.vastaanottajaUid
                              || request.auth.uid == resource.data.lahettajaUid
                              || onJohtoRooli()
                              || (onValmentajaRooli() && resource.data.get('nakyvyys', 'henkilokunta') in ['pelaaja', 'huoltaja'])))
                      || (resource.data.get('nakyvyys', '') == 'pelaaja' && resource.data.get('pelaajaId', '') is string
                          && onPelaajaItse(seuraId, resource.data.get('pelaajaId', '')))
                      || (resource.data.get('nakyvyys', '') in ['pelaaja', 'huoltaja'] && resource.data.get('pelaajaId', '') is string
                          && onLapsenHuoltaja(seuraId, resource.data.get('pelaajaId', ''))
                          && pelaajaData(seuraId, resource.data.get('pelaajaId', '')).get('suostumusTila', '') == 'annettu');   // v3.51 (D58): huoltajan luku vaatii pelaajan suostumuksen — KAIKKI viestit (kyselyssä tyyppiä ei voi rajata → ehto ei saa riippua siitä)
        allow create: if ((onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && onKirjautunut()
                          && request.resource.data.lahettajaUid == request.auth.uid
                          && request.resource.data.get('nakyvyys', 'henkilokunta') in ['henkilokunta', 'pelaaja', 'huoltaja']
                          && !(request.resource.data.get('tyyppi', '') in ['klippi_vastaus', 'klippi_kuittaus'])   // v3.50: vastaukset ovat pelaajan/huoltajan
                          && (request.resource.data.get('tyyppi', '') != 'klippi' || klippiLuontiKelpaa(seuraId))))
                      || viestiPelaajanLuonti(seuraId))
                      && aikaLuontiKelpaa();                          // A5-jälki
        /* v3.39 — vastaanottaja saa muuttaa VAIN `luettu`-merkinnän (bool). Aiemmin mitä tahansa kenttää → hän olisi voinut vaihtaa nakyvyys:'henkilokunta' → 'pelaaja' (VP:n yksityinen viesti
           pelaajalle/huoltajalle) tai muokata tekstiä/lahettajaUid:ta/video_url:ia. Luku-merkintää kirjoittaa vain Master (luettu); VP/Pelaaja eivät päivitä viestejä. SA vapaa. */
        allow update: if (onSuperAdmin()
                      || (onOmaSeura(seuraId)
                          && request.auth.uid == resource.data.vastaanottajaUid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luettu'])
                          && request.resource.data.luettu is bool)
                      // v3.50 (R6.4): klipin kuittaus — lähettäjä, vastaanottaja (vastuuhenkilö) tai johto; vain kuittaus_lause (≤120) + tila (vastattu|suljettu)
                      || (onOmaSeura(seuraId)
                          && resource.data.get('tyyppi', '') == 'klippi'
                          && (request.auth.uid == resource.data.get('vastaanottajaUid', '') || request.auth.uid == resource.data.get('lahettajaUid', '') || onJohtoRooli())
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kuittaus_lause', 'tila'])
                          && (!('kuittaus_lause' in request.resource.data) || (request.resource.data.kuittaus_lause is string && request.resource.data.kuittaus_lause.size() <= 120))
                          && request.resource.data.tila in ['vastattu', 'suljettu']))
                      && aikaPaivitysKelpaa();                        // A5-jälki
        allow delete: if onSuperAdmin();
      }
    }

    // v3.66 — collectionGroup('sisainen') -luku YHDELLÄ kyselyllä (where seuraId == sid): vain oman seuran henkilökunta / SA. Pelaajalla ja huoltajalla ei ole seuraId-claimia → ei pääse.
    // Kirjoitus EI tätä kautta (vain pelaajat/{pid}/sisainen/{doc} -blokki). Dokumentin seuraId on pakotettu == polun {sid} kirjoituksessa.
    match /{path=**}/sisainen/{dokId} {
      allow read: if onSuperAdmin()
                  || (onKirjautunut() && request.auth.token.get('seuraId', '') != '' && resource.data.get('seuraId', '') == request.auth.token.seuraId);
    }

    // ──────────────────────────────────────────────────────────────────────
    // KÄYTTÄJÄT — ylätason profiilit
    // ──────────────────────────────────────────────────────────────────────
    match /kayttajat/{uid} {
      allow read:  if onSuperAdmin() || request.auth.uid == uid;
      allow write: if onSuperAdmin() || request.auth.uid == uid;
    }

    // ──────────────────────────────────────────────────────────────────────
    // SUOSTUMUKSET — ylätaso (ei käytössä v3.33 alkaen)
    // ──────────────────────────────────────────────────────────────────────
    // v3.33: vanha julkisen lomakkeen kokoelma — ei käytössä. Ei selainkirjoituksia, luku vain SA.
    match /suostumukset/{suostumusId} {
      allow read:  if onSuperAdmin();
      allow write: if false;
    }

    // v3.33: audit-loki — kirjoitus vain palvelimelta (Admin SDK ohittaa Rulesin), luku haeAuditLoki-funktion kautta.
    match /audit/{auditId} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // ERRORS — ylätason virheloki
    // ──────────────────────────────────────────────────────────────────────
    match /errors/{errorId} {
      allow read:           if onSuperAdmin();
      allow create:         if onKirjautunut();
      allow update, delete: if onSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════════
    // SOLO PLAYER™ (P0) — ERILLINEN LOHKO klubin seurat/-puusta.
    // Vanhempi omistaa (parent_uid == auth.uid). SOLO_P0_TIETOMALLI_SPEC.md §4.
    // ÄLÄ sekoita klubin Rulesiin. (Polku B: lupapyynnot + lapsi-PIN = PR 2.)
    // ══════════════════════════════════════════════════════════════════════
    // Vanhemman tili (doc-id = Firebase Auth uid)
    match /parents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Solo-pelaaja (litteä) — vain omistava vanhempi (P0).
    match /players/{playerId} {
      // Vanhempi: täysi omistus. Lapsi (Polku B): palvelintoken soloLapsiKirjaudu → onSoloLapsiItse
      // (v3.26): single-doc GET + rajattu UPDATE VAIN omaan dokkiin. EI list. SOLO_P0_SPEC §9.
      // v3.28: anonyymi haara (anonyymi && child_pin != null) poistettu.
      allow get:    if (request.auth != null && request.auth.uid == resource.data.parent_uid)
                    || onSoloLapsiItse(playerId);
      allow list:   if request.auth != null && request.auth.uid == resource.data.parent_uid;
      // v3.30 (PR 4): child_pin asetetaan VAIN palvelimella (soloHyvaksyLupa kirjoittaa myös _soloPin-hajautuksen).
      // Selaimesta asetettu/vaihdettu child_pin ei päivittäisi hajautusta → kirjautuminen hajoaisi.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.parent_uid
                    && !request.resource.data.keys().hasAny(['child_pin']);
      allow update: if (request.auth != null && request.auth.uid == resource.data.parent_uid
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['child_pin']))
                    || (onSoloLapsiItse(playerId)
                        && request.resource.data.parent_uid == resource.data.parent_uid
                        && request.resource.data.child_pin  == resource.data.child_pin
                        && request.resource.data.playerCode == resource.data.playerCode
                        && request.resource.data.seuraId    == resource.data.seuraId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.parent_uid;
      // Alikokoelmat (tkk_historia, suostumukset) — omistajuus pelaajadokin parent_uid:sta
      // v3.27: kirjoitus getAfter():lla — Player_Homen profiilierä (parents + players + suostumukset/perus)
      // luo pelaajan SAMASSA erässä, jolloin get() näki tilan ennen erää → koko erä hylättiin (Polku A
      // ei tallentunut koskaan). Luku pysyy get():llä (getAfter ei käy lukusääntöihin). parent_uid:n
      // vaihto samassa erässä vaatii players-update-oikeuden (vain nykyinen vanhempi) → ei avaa vierasta.
      // ⚠ Match on /{alikokoelma}/{polku=**} EIKÄ /{sub=**}: rules v2:ssa {sub=**} täsmää myös NOLLAAN
      // segmenttiin eli itse pelaajadokkiin → getAfter-kirjoitussääntö antaisi kenen tahansa vaihtaa
      // players/{id}.parent_uid:n itselleen (lopputilassa hän on "omistaja"). Vähintään yksi segmentti.
      match /{alikokoelma}/{polku=**} {
        allow read:  if request.auth != null
                     && get(/databases/$(database)/documents/players/$(playerId)).data.parent_uid == request.auth.uid;
        allow write: if request.auth != null
                     && getAfter(/databases/$(database)/documents/players/$(playerId)).data.parent_uid == request.auth.uid;
      }
    }
    // PlayerCode-indeksi (club-bridge, P2-valmis) — luo oma vanhempi; luku kirjautuneelle.
    match /playerCodes/{code} {
      allow create:         if request.auth != null && request.auth.uid == request.resource.data.parent_uid;
      // v3.29: vain yksittäinen get (tmVaraaPlayerCode: törmäystarkistus). list suljettu — koko indeksin
      // listaus paljasti jokaisen playerCoden (puolet Solo-lapsen tunnuksesta) kenelle tahansa
      // kirjautuneelle, myös Google-rekisteröityneelle Solo-vanhemmalle. Admin SDK ohittaa.
      allow get:            if request.auth != null;
      allow list:           if false;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.parent_uid;
    }
    // Lupapyynnöt (Polku B) — lapsi luo, vanhempi hyväksyy VAIN CF:ssä (Admin SDK). SOLO_P0_SPEC §9.
    // ── KAAVIOT · KANONINEN KERROS (v3.6) ────────────────────────────────────────────
    // kaaviot/{avain} — jaettu curriculum-sisältö (avain = curriculum-avain, sama kaikille
    // seuroille → EI duplikointia seuroittain). 109-generoinnin kohde (erä D).
    // Luku kaikille kirjautuneille (ml. PIN-pelaaja); kirjoitus VAIN super_adminille.
    match /kaaviot/{avain} {
      allow read:  if onKirjautunut();
      allow write: if onSuperAdmin();
    }

    match /lupapyynnot/{requestId} {
      allow create:         if request.resource.data.status == 'odottaa';   // requestId arvaamaton (UUID); rate-limit CF:ssä
      allow get:            if true;                                          // lapsen laite pollaa OMAA requestId:tä (token vain hakijalla)
      allow list:           if false;                                        // ei enumeraatiota
      allow update, delete: if false;                                        // VAIN CF (Admin SDK) hyväksynnässä/hylkäyksessä
      // v3.30 (PR 4): hyväksynnän tulos (child_pin + playerCode) alidokumentissa tulos/{token}. Päädokumentti on
      // get:if true, joten siinä ei ole PIN:iä eikä koodia (vain token_hash). Token on vain lapsen laitteella ja
      // vanhemman linkissä → get tunnetulla tokenilla, EI list, EI kirjoitusta.
      match /tulos/{token} {
        allow get:          if true;
        allow list, write:  if false;
      }
    }
  }
}

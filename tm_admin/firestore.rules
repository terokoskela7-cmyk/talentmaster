rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function onSuperAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onHallinta(seuraId) {
      return request.auth != null && (
        onSuperAdmin() ||
        get(/databases/$(database)/documents/seurat/$(seuraId)).data.vp_uid == request.auth.uid
      );
    }

    function onSeuranJasen(seuraId) {
      return request.auth != null && (
        onHallinta(seuraId) ||
        get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.aktiivinen == true
      );
    }

    function onKirjautunutSeuraJasen() {
      return request.auth != null && request.auth.token.seuraId != null;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /seurat/{seuraId} {
      allow list: if request.auth != null;
      allow get: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      allow create: if request.auth != null && onSuperAdmin();
      allow update: if onHallinta(seuraId);
      allow delete: if onSuperAdmin();

      match /joukkueet/{joukkueId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow write: if onHallinta(seuraId);

        match /pelaajat/{pelaajaid} {
          allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
          allow create: if onHallinta(seuraId) || request.auth == null;
          allow update: if onHallinta(seuraId) || request.auth == null;
        }

        match /kartoitukset/{kartoitusId} {
          allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
          allow create: if request.auth == null || onSeuranJasen(seuraId);
          allow update: if request.auth == null || onSeuranJasen(seuraId);
          allow delete: if onHallinta(seuraId);
        }
      }

      match /tapahtumat/{tapahtumaId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow create: if onHallinta(seuraId) || onSeuranJasen(seuraId);
        allow update: if onHallinta(seuraId) || onSeuranJasen(seuraId) || onKirjautunutSeuraJasen();
        allow delete: if onHallinta(seuraId);

        match /palautteet/{palauteId} {
          allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
          allow create: if onHallinta(seuraId) || onSeuranJasen(seuraId) || onKirjautunutSeuraJasen();
          allow update, delete: if onHallinta(seuraId);
        }
      }

      match /kartoitukset/{kartoitusId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow create, update: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow delete: if onHallinta(seuraId);
      }

      match /kriteerit/{kriteeriId} {
        allow read, write: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      }

      match /pelaajat/{pelaajaid} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
          || resource.data.huoltajaEmail == request.auth.token.email
        ) || request.auth == null;
        allow create: if onHallinta(seuraId) || request.auth == null;
        allow update: if onHallinta(seuraId) || request.auth == null
          || (request.auth != null && resource.data.huoltajaEmail == request.auth.token.email);
        allow delete: if onSuperAdmin() || onHallinta(seuraId);
      }

      match /suostumukset/{suostumusId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow create: if true;
        allow update: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      }

      match /kutsut/{kutsuId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow create: if onHallinta(seuraId) || onSeuranJasen(seuraId);
        allow update: if onHallinta(seuraId);
      }

      match /kayttajat/{kayttajaId} {
        allow read: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
        allow write: if onHallinta(seuraId);
      }

      match /kirjaukset/{kirjausId} {
        allow read, write: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      }

      match /testit/{testiId} {
        allow read, write: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      }

      match /adar/{adarId} {
        allow read, write: if request.auth != null && (onSuperAdmin() || onSeuranJasen(seuraId));
      }
    }

    match /kirjaukset/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
    match /kirjaukset_joukkue/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
    match /kirjaukset_tapahtumat/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
  }
}

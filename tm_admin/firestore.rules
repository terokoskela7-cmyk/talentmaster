rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Apufunktiot ───────────────────────────────────────────────────────
    function onKirjautunut() {
      return request.auth != null;
    }
    function onSuperAdmin() {
      return onKirjautunut() && (
        request.auth.token.super_admin == true ||
        request.auth.token.superAdmin  == true
      );
    }
    function onRooli(rooli) {
      return onKirjautunut() && request.auth.token.rooli == rooli;
    }
    function onSeuranJasen(seuraId) {
      return onKirjautunut() && request.auth.token.seuraId == seuraId;
    }
    // UUSI: pelaajan URL-param/PIN-flow — anon auth + suostumus annettu
    function onPelaajaAnon(seuraId, pelaajaId) {
      return onKirjautunut() &&
        get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.suostumusTila == 'annettu';
    }

    // ── Super Admin: pääsy kaikkeen ───────────────────────────────────────
    match /{document=**} {
      allow read, write: if onSuperAdmin();
    }

    // ── Admins-kokoelma ───────────────────────────────────────────────────
    match /admins/{uid} {
      allow read, write: if onSuperAdmin();
    }

    // ── Seurat ────────────────────────────────────────────────────────────
    match /seurat/{seuraId} {
      allow read: if true;
      allow write: if onKirjautunut() && (
        onRooli('vp') && onSeuranJasen(seuraId) ||
        onRooli('seurasihteeri') && onSeuranJasen(seuraId)
      );

      // Joukkueet
      match /joukkueet/{joukkueId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId);
        allow write: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId);
      }

      // Käyttäjät
      match /kayttajat/{kayttajaId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId);
        allow create: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId);
        allow update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') ||
          request.auth.uid == kayttajaId
        ) && onSeuranJasen(seuraId);
        allow delete: if onKirjautunut() && onRooli('vp') && onSeuranJasen(seuraId);
      }

      // Pelaajat
      match /pelaajat/{pelaajaId} {
        allow read: if (
          onKirjautunut() && onSeuranJasen(seuraId)
        ) || (
          onKirjautunut() && onRooli('pelaaja')
        ) || (
          onKirjautunut() && resource.data.huoltajaEmail == request.auth.token.email
        ) || (
          // Anonyymi URL-param/PIN-reitti — suostumus toimii avaimena
          resource.data.suostumusTila == 'annettu'
        );
        allow list: if onKirjautunut() && request.auth.token.email != null;
        allow create: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja')
        ) && onSeuranJasen(seuraId);
        allow update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja') ||
          onRooli('pelaaja')
        ) || (
          resource.data.suostumusTila == 'odottaa'
        );

        // ── KIRJAUKSET ────────────────────────────────────────────────────
        match /kirjaukset/{pvmId} {
          // Luku: seuran jäsen TAI pelaaja itse (anon, suostumus annettu)
          allow read: if (
            onKirjautunut() && onSeuranJasen(seuraId)
          ) || (
            // Pelaaja lukee omia kirjauksiaan anon-flowssa
            onKirjautunut() &&
            get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.suostumusTila == 'annettu'
          );
          // Kirjoitus: kaikki kirjautuneet (anon auth riittää)
          allow create, update: if onKirjautunut();
        }

        // ── HAVAINNOT ─────────────────────────────────────────────────────
        match /havainnot/{havaintoId} {
          // Luku: seuran jäsen TAI pelaaja itse (anon, suostumus annettu)
          allow read: if (
            onKirjautunut() && onSeuranJasen(seuraId)
          ) || (
            // Pelaaja näkee valmentajan havainnon omalla sivullaan
            onKirjautunut() &&
            get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.suostumusTila == 'annettu'
          );
          allow create, update: if onKirjautunut() && (
            onRooli('valmentaja') || onRooli('talenttivalmentaja')
          ) && onSeuranJasen(seuraId);
        }

        // ── TESTIT / KARTOITUKSET / TEKNIIKKA / ADAR ─────────────────────
        match /testit/{testiId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId);
          allow create, update: if onKirjautunut() && (
            onRooli('vp') || onRooli('valmentaja') ||
            onRooli('testivastaava') || onRooli('fysiikkavalmentaja')
          ) && onSeuranJasen(seuraId);
        }

        match /kartoitukset/{kartoitusId} {
          allow read: if onKirjautunut() && (
            onSeuranJasen(seuraId) ||
            onRooli('pelaaja') && request.auth.token.pelaajaId == pelaajaId
          );
          allow create, update: if onKirjautunut() && onSeuranJasen(seuraId);
        }

        match /tekniikka/{kilpailuId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId);
          allow create, update: if onKirjautunut() && onSeuranJasen(seuraId);
        }

        match /adar/{adarId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId);
          allow create, update: if onKirjautunut() && (
            onRooli('valmentaja') || onRooli('talenttivalmentaja')
          ) && onSeuranJasen(seuraId);
        }

        // ── OMATOIMIOHJELMAT — pelaajan harjoiteohjelmat ──────────────────
        match /omatoimi_ohjelmat/{ohjelmaId} {
          // Luku: seuran jäsen TAI pelaaja itse (anon, suostumus annettu)
          allow read: if (
            onKirjautunut() && onSeuranJasen(seuraId)
          ) || (
            onKirjautunut() &&
            get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.suostumusTila == 'annettu'
          );
          // Kirjoitus: kaikki kirjautuneet (pelaaja tallentaa oman ohjelmansa)
          allow create, update: if onKirjautunut();
        }

        // ── IDP JA MUUT PELAAJAN ALADOKUMENTIT ───────────────────────────
        match /{alaDokumentti}/{dokumenttiId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId);
          allow create, update: if onKirjautunut() && onSeuranJasen(seuraId);
        }
      }

      // Mentoroinnit
      match /mentoroinnit/{mentorointiId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId);
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId);
      }

      // Tapahtumat
      match /tapahtumat/{tapahtumaId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId);
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId);
      }

      // Muut seuran aladokumentit
      match /{alaDokumentti}/{dokumenttiId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId);
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId);
      }
    }

    // ── UTJ-data ──────────────────────────────────────────────────────────
    match /utj_data/{kaudenId} {
      allow read: if onKirjautunut();
      allow write: if onKirjautunut() && (
        onRooli('vp') || onRooli('urheilutoimenjohtaja')
      );
    }

    // ── Vanha rakenne (yhteensopivuus) ────────────────────────────────────
    match /kirjaukset/{doc} {
      allow read, write: if onKirjautunut();
    }
    match /kirjaukset_joukkue/{doc} {
      allow read, write: if onKirjautunut();
    }
    match /kirjaukset_tapahtumat/{doc} {
      allow read, write: if onKirjautunut();
    }
    match /testitapahtumat/{doc} {
      allow read: if onKirjautunut();
      allow write: if onKirjautunut();
    }

  }
}

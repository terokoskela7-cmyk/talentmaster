rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════
    // APUFUNKTIOT
    // ════════════════════════════════════════════════════════════

    function onKirjautunut() {
      return request.auth != null;
    }

    // KORJAUS: Super admin tunnistetaan kolmella tavalla:
    // 1) Custom Claim rooli == 'super_admin' (underscore)
    // 2) Custom Claim rooli == 'superadmin' (yhteen - vanha muoto)
    // 3) Custom Claim super_admin == true (boolean)
    // 4) admins-kokoelmassa on dokumentti kyseisellä UID:llä
    function onSuperAdmin() {
      return onKirjautunut() && (
        request.auth.token.rooli == 'super_admin' ||
        request.auth.token.rooli == 'superadmin' ||
        request.auth.token.super_admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function onRooli(rooli) {
      return onKirjautunut() &&
        request.auth.token.rooli == rooli;
    }

    function onSeuranJasen(seuraId) {
      return onKirjautunut() &&
        request.auth.token.seuraId == seuraId;
    }

    function onOmaUid(uid) {
      return onKirjautunut() && request.auth.uid == uid;
    }

    function onSeuranJasenJaSeuraId(seuraId) {
      return onSeuranJasen(seuraId) &&
        request.resource.data.seuraId == seuraId;
    }

    // ════════════════════════════════════════════════════════════
    // ADMINS
    // Super admin lukee oman dokumenttinsa — onOmaUid riittää
    // ════════════════════════════════════════════════════════════
    match /admins/{uid} {
      allow read:  if onOmaUid(uid) || onSuperAdmin();
      allow write: if onSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // SEURAT
    // ════════════════════════════════════════════════════════════
    match /seurat/{seuraId} {
      // list: kirjautunut vanhempi saa hakea seurojen ID:t lapsen löytämiseksi
      // get:  vain seuran jäsen tai super admin näkee seuran sisällön
      allow list: if onKirjautunut();
      allow get:  if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
      allow write: if onKirjautunut() && (
        onRooli('vp') && onSeuranJasen(seuraId) ||
        onRooli('seurasihteeri') && onSeuranJasen(seuraId)
      ) || onSuperAdmin();

      // ── Joukkueet ────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read: if onKirjautunut() && onSeuranJasen(seuraId)
                    || onSuperAdmin();
        allow write: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        match /kayttajat/{kayttajaId} {
          allow read: if onKirjautunut() && onSeuranJasen(seuraId)
                      || onSuperAdmin();
          allow write: if onKirjautunut() && (
            onRooli('vp') || onRooli('seurasihteeri')
          ) && onSeuranJasen(seuraId) || onSuperAdmin();
        }

        match /kartoitukset/{kartoitusId} {
          allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
          allow create, update: if onKirjautunut() && (
            onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
          ) && onSeuranJasen(seuraId) || onSuperAdmin();
        }

        match /kehitystavoitteet/{kausi} {
          allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
          allow create, update: if onKirjautunut() && (
            onRooli('vp') || onRooli('urheilutoimenjohtaja')
          ) && onSeuranJasen(seuraId) || onSuperAdmin();
        }
      }

      // ── Pelaajat ─────────────────────────────────────────────
      match /pelaajat/{pelaajaId} {
        allow read: if (
          onKirjautunut() && onSeuranJasen(seuraId)
        ) || (
          onKirjautunut() && onRooli('pelaaja') &&
          request.auth.uid == pelaajaId
        ) || (
          // P4: Vanhempi lukee oman lapsensa datan huoltajaEmail-vertailulla
          onKirjautunut() && resource.data.huoltajaEmail == request.auth.token.email
        ) || onSuperAdmin();

        allow create: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        allow update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja') ||
          onRooli('talenttivalmentaja') || onRooli('fysiikkavalmentaja') ||
          onRooli('fysioterapeutti') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();

        allow delete: if onRooli('vp') && onSeuranJasen(seuraId)
                      || onSuperAdmin();

        match /kirjaukset/{paiva} {
          allow read: if (
            onKirjautunut() && onSeuranJasen(seuraId)
          ) || (
            onKirjautunut() && request.auth.uid == pelaajaId
          ) || (
            // P4: Vanhempi lukee lapsen kirjaukset
            onKirjautunut() && get(/databases/$(database)/documents/seurat/$(seuraId)/pelaajat/$(pelaajaId)).data.huoltajaEmail == request.auth.token.email
          ) || onSuperAdmin();

          allow create, update: if onKirjautunut()
            && onSeuranJasen(seuraId)
            || onSuperAdmin();
        }
      }

      // ── Havainnot ────────────────────────────────────────────
      match /havainnot/{havaintoId} {
        allow read: if (
          onKirjautunut() && onSeuranJasen(seuraId)
        ) || onSuperAdmin();

        allow create, update: if onKirjautunut() && (
          onRooli('valmentaja') || onRooli('talenttivalmentaja')
        ) && onSeuranJasen(seuraId)
          && request.resource.data.seuraId == seuraId
          || onSuperAdmin();
      }

      // ── Harjoitukset ─────────────────────────────────────────
      match /harjoitukset/{harjoitusId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Merkinnät ────────────────────────────────────────────
      match /merkinnat/{merkintaId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && onSeuranJasen(seuraId)
          && request.resource.data.seuraId == seuraId || onSuperAdmin();
      }

      // ── Tapahtumat ───────────────────────────────────────────
      match /tapahtumat/{tapahtumaId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('seurasihteeri') || onRooli('valmentaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
        allow delete: if onRooli('vp') && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Kartoitukset (seuran taso) ───────────────────────────
      match /kartoitukset/{kartoitusId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── HH-tulokset ──────────────────────────────────────────
      match /hh_tulokset/{tulosId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Tekniikkatulokset ────────────────────────────────────
      match /tekniikkatulokset/{tulosId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Testitapahtumat ──────────────────────────────────────
      match /testitapahtumat/{tapahtumaId} {
        allow read:          if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow create, update: if onKirjautunut() && (
          onRooli('vp') || onRooli('valmentaja') || onRooli('testivastaava')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
        allow delete: if onRooli('vp') && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── DNA-konfiguraatio ────────────────────────────────────
      match /dna_konfig/{konfigId} {
        allow read:  if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow write: if onKirjautunut() && (
          onRooli('vp') || onRooli('urheilutoimenjohtaja')
        ) && onSeuranJasen(seuraId) || onSuperAdmin();
      }

      // ── Catch-all: muut alikokoelmat ─────────────────────────
      match /{alikokoelma}/{docId} {
        allow read:  if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
        allow write: if onKirjautunut() && onSeuranJasen(seuraId) || onSuperAdmin();
      }
    }

    // ════════════════════════════════════════════════════════════
    // KUTSUT — pelaajien rekisteröinti
    // ════════════════════════════════════════════════════════════
    match /kutsut/{kutsuId} {
      allow read:  if onKirjautunut() || onSuperAdmin();
      allow write: if onKirjautunut() && (
        onRooli('vp') || onRooli('seurasihteeri')
      ) || onSuperAdmin();
    }

    // ════════════════════════════════════════════════════════════
    // PELAAJAT top-level (suostumuslomake anonyymi kirjoitus)
    // ════════════════════════════════════════════════════════════
    match /pelaajat/{pelaajaId} {
      allow read:  if onOmaUid(pelaajaId) || onSuperAdmin();
      allow create: if true;  // anonyymi rekisteröinti sallittu
      allow update: if onOmaUid(pelaajaId) || onSuperAdmin();
    }

  }
}

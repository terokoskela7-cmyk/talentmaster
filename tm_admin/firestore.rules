rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Apufunktiot ───────────────────────────────────────────────
    function onSuperAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function onHallinta(seuraId) {
      return request.auth != null && (
        onSuperAdmin() ||
        get(/databases/$(database)/documents/seurat/$(seuraId)).data.vp_uid == request.auth.uid
      );
    }

    function onSeuranJasen(seuraId) {
      return request.auth != null && (
        onHallinta(seuraId) ||
        get(/databases/$(database)/documents/seurat/$(seuraId)/kayttajat/$(request.auth.uid)).data.aktiivinen == true
      );
    }

    // ─── Admins ─────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Vain Firebase Console
    }

    // ─── Seurat ─────────────────────────────────────────────────────
    match /seurat/{seuraId} {

      // KRIITTINEN LISÄYS: VP v17 hakee oman seuransa kyselyllä
      // collection('seurat').where('vp_uid','==',uid) — tämä on LIST-operaatio.
      // Ilman tätä sääntöä Rules ei tiedä seuraId:tä ennen kuin kysely on tehty
      // → chicken-and-egg → "Missing or insufficient permissions".
      // Turvallisuus: LIST sallii kyselyn rakenteen, mutta yksittäisten
      // dokumenttien sisältö on suojattu alla olevalla GET-säännöllä.
      // VP saa takaisin vain ne dokumentit joiden vp_uid == hänen uid.
      allow list: if request.auth != null;

      // GET: yksittäinen dokumentti tunnetulla seuraId:llä
      allow get: if request.auth != null && (
        onSuperAdmin() || onSeuranJasen(seuraId)
      );

      // WRITE: vain hallintotason käyttäjät
      // Tämä kattaa myös uuden seuran luomisen Admin-sivulta
      // (super-admin luo seurat/{id} suoraan JS:stä)
      allow create: if request.auth != null && onSuperAdmin();
      allow update: if onHallinta(seuraId);
      allow delete: if onSuperAdmin();

      // ── Joukkueet ────────────────────────────────────────────────
      match /joukkueet/{joukkueId} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
        allow write: if onHallinta(seuraId);

        // Pelaajat joukkueessa
        match /pelaajat/{pelaajaid} {
          allow read: if request.auth != null && (
            onSuperAdmin() || onSeuranJasen(seuraId)
          );
          // Huoltajan rekisteröinti sallittu ilman kirjautumista
          allow create: if onHallinta(seuraId) || request.auth == null;
          allow update: if onHallinta(seuraId) || request.auth == null;
        }

        // Kartoitukset — KRIITTINEN: testaaja voi olla kirjautumaton
        match /kartoitukset/{kartoitusId} {
          allow read: if request.auth != null && (
            onSuperAdmin() || onSeuranJasen(seuraId)
          );
          // Kirjautumaton testaaja saa tallentaa tapahtumaId-kontekstilla
          allow create: if request.auth == null || onSeuranJasen(seuraId);
          allow update: if request.auth == null || onSeuranJasen(seuraId);
          allow delete: if onHallinta(seuraId);
        }
      }

      // ── Tapahtumat ───────────────────────────────────────────────
      match /tapahtumat/{tapahtumaId} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
        allow create: if onHallinta(seuraId) || onSeuranJasen(seuraId);
        allow update: if onHallinta(seuraId) || onSeuranJasen(seuraId);
        allow delete: if onHallinta(seuraId);
      }

      // ── Pelaajat seuratasolla (rekisteröintireitti) ──────────────
      match /pelaajat/{pelaajaid} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
        allow create: if onHallinta(seuraId) || request.auth == null;
        allow update: if onHallinta(seuraId);
      }

      // ── Kutsut (massakutsu huoltajille) ─────────────────────────
      match /kutsut/{kutsuId} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
        allow create: if onHallinta(seuraId) || onSeuranJasen(seuraId);
        allow update: if onHallinta(seuraId);
      }

      // ── Käyttäjät (valmentajat, testaajat jne.) ─────────────────
      match /kayttajat/{kayttajaId} {
        allow read: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
        allow write: if onHallinta(seuraId);
      }

      // ── Kirjaukset, testit, adar ─────────────────────────────────
      match /kirjaukset/{kirjausId} {
        allow read, write: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
      }

      match /testit/{testiId} {
        allow read, write: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
      }

      match /adar/{adarId} {
        allow read, write: if request.auth != null && (
          onSuperAdmin() || onSeuranJasen(seuraId)
        );
      }
    }

    // ─── Vanha rakenne (yhteensopivuus) ─────────────────────────────
    match /kirjaukset/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
    match /kirjaukset_joukkue/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
    match /kirjaukset_tapahtumat/{doc} {
      allow read, write: if request.auth != null && onSuperAdmin();
    }
  }
}

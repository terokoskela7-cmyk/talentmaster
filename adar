<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TalentMaster – Valmentajan Hallintapaneeli</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Syne:wght@400;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--ink:#090C12;--surface:#1A2238;--primary:#3DE8A0;--blue:#4A7ED9;--gold:#F5A623;--rose:#E24B8A;--text:#E8E4DB;--text2:#8A9BB8;--r:12px}
body{font-family:'Syne',sans-serif;background:var(--ink);color:var(--text);min-height:100vh;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{font-family:'Syne',sans-serif;cursor:pointer;border:none;outline:none}

/* LAYOUT */
.app{display:flex;min-height:100vh}
.sidebar{width:240px;background:var(--surface);display:flex;flex-direction:column;padding:24px 0;position:fixed;height:100vh;left:0;top:0;z-index:100;transition:.3s}
.sidebar.collapsed{width:68px}
.main{margin-left:240px;flex:1;transition:.3s;min-height:100vh}
.main.expanded{margin-left:68px}

/* SIDEBAR */
.logo{padding:0 20px 28px;display:flex;align-items:center;gap:10px;border-bottom:1px solid rgba(138,155,184,.15)}
.logo-icon{width:36px;height:36px;background:var(--primary);border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.logo-icon svg{width:20px;height:20px}
.logo-text{font-family:'DM Serif Display',serif;font-size:18px;color:var(--text);white-space:nowrap;overflow:hidden}
.logo-sub{font-size:10px;color:var(--text2);font-family:'Syne',sans-serif;letter-spacing:.05em}
.sidebar-toggle{position:absolute;top:28px;right:-14px;width:28px;height:28px;background:var(--surface);border:2px solid rgba(138,155,184,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text2);transition:.3s}
.sidebar-toggle:hover{color:var(--primary);border-color:var(--primary)}
.nav{flex:1;padding:16px 0;overflow-y:auto}
.nav-section{padding:8px 20px 4px;font-size:10px;font-weight:600;color:var(--text2);letter-spacing:.1em;text-transform:uppercase;white-space:nowrap;overflow:hidden}
.collapsed .nav-section{opacity:0}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 20px;color:var(--text2);font-size:14px;font-weight:600;cursor:pointer;transition:.2s;white-space:nowrap;overflow:hidden;position:relative}
.nav-item:hover{color:var(--text);background:rgba(61,232,160,.06)}
.nav-item.active{color:var(--primary);background:rgba(61,232,160,.1)}
.nav-item.active::before{content:'';position:absolute;left:0;top:50%;transform:translateY(-50%);width:3px;height:20px;background:var(--primary);border-radius:0 3px 3px 0}
.nav-item svg{width:18px;height:18px;flex-shrink:0}
.nav-badge{margin-left:auto;background:var(--rose);color:#fff;font-size:10px;font-weight:700;padding:1px 6px;border-radius:20px;flex-shrink:0}
.collapsed .nav-item span,.collapsed .nav-badge{display:none}
.sidebar-user{padding:16px 20px;border-top:1px solid rgba(138,155,184,.15);display:flex;align-items:center;gap:10px;overflow:hidden}
.user-av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--primary));display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0;color:#fff}
.user-info{overflow:hidden}
.user-name{font-size:13px;font-weight:600;white-space:nowrap}
.user-role{font-size:11px;color:var(--text2);white-space:nowrap}
.collapsed .user-info{display:none}

/* TOPBAR */
.topbar{background:var(--surface);border-bottom:1px solid rgba(138,155,184,.12);padding:0 28px;height:64px;display:flex;align-items:center;gap:16px;position:sticky;top:0;z-index:50}
.topbar-title{font-family:'DM Serif Display',serif;font-size:20px;flex:1}
.topbar-search{background:rgba(255,255,255,.05);border:1px solid rgba(138,155,184,.2);border-radius:8px;padding:8px 14px;display:flex;align-items:center;gap:8px;width:240px}
.topbar-search input{background:none;border:none;color:var(--text);font-family:'Syne',sans-serif;font-size:13px;width:100%;outline:none}
.topbar-search input::placeholder{color:var(--text2)}
.topbar-search svg{width:14px;height:14px;color:var(--text2);flex-shrink:0}
.topbar-btn{width:38px;height:38px;border-radius:8px;background:rgba(255,255,255,.05);border:1px solid rgba(138,155,184,.2);display:flex;align-items:center;justify-content:center;color:var(--text2);position:relative;cursor:pointer;transition:.2s}
.topbar-btn:hover{color:var(--primary);border-color:var(--primary)}
.notif-dot{position:absolute;top:6px;right:6px;width:7px;height:7px;background:var(--rose);border-radius:50%;border:2px solid var(--surface)}
.period-sel{display:flex;background:rgba(255,255,255,.05);border-radius:8px;border:1px solid rgba(138,155,184,.2);overflow:hidden}
.period-btn{padding:7px 14px;font-size:12px;font-weight:600;color:var(--text2);cursor:pointer;transition:.2s}
.period-btn.active{background:var(--primary);color:var(--ink)}
.period-btn:hover:not(.active){color:var(--text)}

/* PAGE */
.page{padding:28px;display:none}
.page.active{display:block}

/* OVERVIEW GRID */
.kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
.kpi{background:var(--surface);border-radius:var(--r);padding:20px;position:relative;overflow:hidden;border:1px solid rgba(138,155,184,.1);transition:.2s}
.kpi:hover{border-color:rgba(61,232,160,.2);transform:translateY(-1px)}
.kpi-label{font-size:11px;font-weight:600;color:var(--text2);letter-spacing:.07em;text-transform:uppercase;margin-bottom:8px}
.kpi-val{font-family:'DM Serif Display',serif;font-size:32px;margin-bottom:4px}
.kpi-sub{font-size:12px;color:var(--text2)}
.kpi-sub.up{color:var(--primary)}
.kpi-sub.dn{color:var(--gold)}
.kpi-icon{position:absolute;right:16px;top:16px;width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center}
.kpi-icon.gr{background:rgba(61,232,160,.12)}
.kpi-icon.bl{background:rgba(74,126,217,.12)}
.kpi-icon.gd{background:rgba(245,166,35,.12)}
.kpi-icon.rs{background:rgba(226,75,138,.12)}
.kpi-icon svg{width:18px;height:18px}
.kpi-icon.gr svg{color:var(--primary)}
.kpi-icon.bl svg{color:var(--blue)}
.kpi-icon.gd svg{color:var(--gold)}
.kpi-icon.rs svg{color:var(--rose)}
.kpi-sparkline{margin-top:12px;height:32px;width:100%}

/* GRID 2-COL */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px}
.grid3{display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:24px}
.card{background:var(--surface);border-radius:var(--r);padding:20px;border:1px solid rgba(138,155,184,.1)}
.card-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
.card-title{font-family:'DM Serif Display',serif;font-size:16px}
.card-action{font-size:12px;color:var(--blue);font-weight:600;cursor:pointer}
.card-action:hover{color:var(--primary)}

/* ATHLETE LIST */
.ath-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid rgba(138,155,184,.08);cursor:pointer;transition:.2s}
.ath-row:last-child{border-bottom:none}
.ath-row:hover{background:rgba(61,232,160,.04);margin:0 -8px;padding:10px 8px;border-radius:8px}
.ath-av{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0}
.ath-info{flex:1;min-width:0}
.ath-name{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ath-meta{font-size:11px;color:var(--text2)}
.ath-score{text-align:right}
.ath-pts{font-family:'DM Mono',monospace;font-size:15px;font-weight:500}
.ath-trend{font-size:10px}
.streak-row{display:flex;gap:3px;margin-top:4px}
.streak-dot{width:8px;height:8px;border-radius:50%}
.streak-dot.done{background:var(--primary)}
.streak-dot.miss{background:#2A3A55}
.streak-dot.today{background:var(--gold);box-shadow:0 0 6px var(--gold)}

/* PROGRESS BAR */
.prog-wrap{margin-bottom:12px}
.prog-top{display:flex;justify-content:space-between;margin-bottom:6px}
.prog-label{font-size:12px;font-weight:600}
.prog-val{font-family:'DM Mono',monospace;font-size:12px;color:var(--text2)}
.prog-bar{height:6px;background:rgba(255,255,255,.07);border-radius:3px;overflow:hidden}
.prog-fill{height:100%;border-radius:3px;transition:width 1s ease}

/* ACTIVITY FEED */
.feed-item{display:flex;gap:12px;padding:10px 0;border-bottom:1px solid rgba(138,155,184,.08)}
.feed-item:last-child{border-bottom:none}
.feed-dot{width:8px;height:8px;border-radius:50%;margin-top:5px;flex-shrink:0}
.feed-content{flex:1}
.feed-text{font-size:13px;line-height:1.4}
.feed-time{font-size:11px;color:var(--text2);margin-top:2px;font-family:'DM Mono',monospace}

/* HEATMAP */
.heatmap{display:grid;grid-template-columns:repeat(12,1fr);gap:3px;margin-top:12px}
.hm-cell{aspect-ratio:1;border-radius:3px;transition:.2s;cursor:pointer}
.hm-cell:hover{transform:scale(1.3)}
.hm-0{background:rgba(255,255,255,.05)}
.hm-1{background:rgba(61,232,160,.2)}
.hm-2{background:rgba(61,232,160,.45)}
.hm-3{background:rgba(61,232,160,.7)}
.hm-4{background:rgba(61,232,160,1);box-shadow:0 0 6px rgba(61,232,160,.4)}
.hm-labels{display:flex;gap:0;margin-bottom:4px}
.hm-month{flex:1;font-size:9px;color:var(--text2);text-align:center}

/* DONUT */
.donut-wrap{display:flex;align-items:center;gap:20px}
.donut-legend{flex:1}
.legend-item{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.legend-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0}
.legend-label{font-size:12px;font-weight:600;flex:1}
.legend-val{font-family:'DM Mono',monospace;font-size:12px;color:var(--text2)}

/* ATHLETES PAGE */
.filter-bar{display:flex;gap:8px;margin-bottom:20px;flex-wrap:wrap}
.filter-btn{padding:7px 16px;border-radius:20px;font-size:12px;font-weight:600;background:rgba(255,255,255,.06);color:var(--text2);border:1px solid transparent;transition:.2s}
.filter-btn.active{background:rgba(61,232,160,.12);color:var(--primary);border-color:rgba(61,232,160,.3)}
.filter-btn:hover:not(.active){color:var(--text)}
.ath-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.ath-card{background:var(--surface);border-radius:var(--r);padding:20px;border:1px solid rgba(138,155,184,.1);cursor:pointer;transition:.2s}
.ath-card:hover{border-color:rgba(61,232,160,.3);transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.3)}
.ath-card-top{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.ath-card-av{width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0}
.ath-card-name{font-family:'DM Serif Display',serif;font-size:16px}
.ath-card-sport{font-size:11px;color:var(--text2);margin-top:2px}
.ath-status{font-size:10px;font-weight:700;padding:2px 8px;border-radius:20px;margin-left:auto}
.st-active{background:rgba(61,232,160,.15);color:var(--primary)}
.st-rest{background:rgba(245,166,35,.15);color:var(--gold)}
.st-injury{background:rgba(226,75,138,.15);color:var(--rose)}
.stat-row{display:flex;gap:8px;margin-bottom:12px}
.stat-box{flex:1;background:rgba(255,255,255,.04);border-radius:8px;padding:8px;text-align:center}
.stat-box-val{font-family:'DM Mono',monospace;font-size:16px;font-weight:500}
.stat-box-lbl{font-size:9px;color:var(--text2);text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
.mini-streak{display:flex;gap:2px;justify-content:center;margin-top:8px}
.mini-dot{width:6px;height:6px;border-radius:50%}

/* SESSION BUILDER */
.session-wrap{display:grid;grid-template-columns:1fr 320px;gap:20px}
.ex-lib{background:var(--surface);border-radius:var(--r);padding:20px;border:1px solid rgba(138,155,184,.1)}
.ex-search{width:100%;background:rgba(255,255,255,.05);border:1px solid rgba(138,155,184,.2);border-radius:8px;padding:9px 14px;color:var(--text);font-family:'Syne',sans-serif;font-size:13px;margin-bottom:16px;outline:none}
.ex-search:focus{border-color:var(--primary)}
.ex-cats{display:flex;gap:6px;margin-bottom:14px;flex-wrap:wrap}
.ex-cat{padding:5px 12px;border-radius:20px;font-size:11px;font-weight:600;background:rgba(255,255,255,.06);color:var(--text2);cursor:pointer;transition:.2s}
.ex-cat.active{background:rgba(74,126,217,.15);color:var(--blue)}
.ex-item{display:flex;align-items:center;gap:10px;padding:10px;border-radius:8px;cursor:pointer;transition:.2s;border:1px solid transparent}
.ex-item:hover{background:rgba(61,232,160,.06);border-color:rgba(61,232,160,.15)}
.ex-item.added{background:rgba(61,232,160,.08);border-color:rgba(61,232,160,.25)}
.ex-icon{width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;background:rgba(255,255,255,.06);flex-shrink:0}
.ex-info{flex:1}
.ex-name{font-size:13px;font-weight:600}
.ex-tags{display:flex;gap:4px;margin-top:3px}
.ex-tag{font-size:10px;color:var(--text2);background:rgba(255,255,255,.06);padding:1px 6px;border-radius:4px}
.ex-add{width:28px;height:28px;border-radius:6px;background:rgba(61,232,160,.15);color:var(--primary);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.session-plan{background:var(--surface);border-radius:var(--r);padding:20px;border:1px solid rgba(138,155,184,.1);position:sticky;top:80px;max-height:calc(100vh - 120px);overflow-y:auto;display:flex;flex-direction:column}
.plan-empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--text2);text-align:center;gap:8px;padding:40px 0}
.plan-empty svg{width:40px;height:40px;opacity:.3}
.plan-empty p{font-size:13px}
.plan-item{background:rgba(255,255,255,.04);border-radius:8px;padding:12px;margin-bottom:8px;border-left:3px solid var(--primary)}
.plan-item-name{font-size:13px;font-weight:600;margin-bottom:8px}
.plan-inputs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}
.plan-input{background:rgba(255,255,255,.07);border:1px solid rgba(138,155,184,.15);border-radius:6px;padding:6px 8px;color:var(--text);font-family:'DM Mono',monospace;font-size:12px;width:100%;outline:none;text-align:center}
.plan-input:focus{border-color:var(--primary)}
.plan-input-lbl{font-size:9px;color:var(--text2);text-align:center;margin-top:2px;text-transform:uppercase;letter-spacing:.05em}
.plan-actions{display:flex;gap:8px;margin-top:16px}
.btn{padding:10px 20px;border-radius:8px;font-size:13px;font-weight:700;transition:.2s;cursor:pointer}
.btn-primary{background:var(--primary);color:var(--ink)}
.btn-primary:hover{background:#5AEDAE;box-shadow:0 0 20px rgba(61,232,160,.3)}
.btn-secondary{background:rgba(255,255,255,.07);color:var(--text);border:1px solid rgba(138,155,184,.2)}
.btn-secondary:hover{border-color:var(--primary);color:var(--primary)}
.btn-full{width:100%}

/* ANALYTICS */
.chart-container{width:100%;height:200px;position:relative;margin-top:8px}
.bar-chart{display:flex;align-items:flex-end;gap:6px;height:160px;padding-top:10px}
.bar-group{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}
.bar{width:100%;border-radius:4px 4px 0 0;transition:height .6s ease;position:relative;cursor:pointer}
.bar:hover::after{content:attr(data-val);position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-size:10px;color:var(--text);background:var(--surface);padding:2px 6px;border-radius:4px;white-space:nowrap;font-family:'DM Mono',monospace}
.bar-lbl{font-size:10px;color:var(--text2);text-align:center}
.line-chart{width:100%;height:160px;overflow:visible}
.radar-wrap{display:flex;justify-content:center;margin-top:12px}

/* CALENDAR */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.cal-day-name{text-align:center;font-size:10px;font-weight:700;color:var(--text2);padding:4px 0;text-transform:uppercase;letter-spacing:.05em}
.cal-day{min-height:70px;background:rgba(255,255,255,.03);border-radius:8px;padding:6px;border:1px solid rgba(138,155,184,.08);cursor:pointer;transition:.2s}
.cal-day:hover{border-color:rgba(61,232,160,.25);background:rgba(61,232,160,.04)}
.cal-day.today{border-color:var(--primary);background:rgba(61,232,160,.06)}
.cal-day.other-month{opacity:.35}
.cal-day-num{font-size:11px;font-weight:600;margin-bottom:4px}
.today .cal-day-num{color:var(--primary)}
.cal-event{font-size:10px;padding:2px 5px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ce-session{background:rgba(74,126,217,.2);color:var(--blue)}
.ce-test{background:rgba(245,166,35,.2);color:var(--gold)}
.ce-match{background:rgba(226,75,138,.2);color:var(--rose)}
.ce-rest{background:rgba(138,155,184,.15);color:var(--text2)}

/* NOTIFICATIONS PANEL */
.notif-panel{position:fixed;right:-320px;top:0;height:100vh;width:320px;background:var(--surface);z-index:200;transition:.3s;border-left:1px solid rgba(138,155,184,.15);display:flex;flex-direction:column}
.notif-panel.open{right:0}
.notif-hd{padding:20px;border-bottom:1px solid rgba(138,155,184,.15);display:flex;align-items:center;justify-content:space-between}
.notif-hd-title{font-family:'DM Serif Display',serif;font-size:18px}
.notif-close{width:28px;height:28px;border-radius:6px;background:rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2)}
.notif-list{flex:1;overflow-y:auto;padding:12px}
.notif-item{padding:12px;border-radius:8px;margin-bottom:8px;cursor:pointer;transition:.2s;border:1px solid transparent}
.notif-item.unread{background:rgba(61,232,160,.06);border-color:rgba(61,232,160,.15)}
.notif-item:hover{background:rgba(255,255,255,.05)}
.notif-item-title{font-size:13px;font-weight:600;margin-bottom:3px}
.notif-item-text{font-size:12px;color:var(--text2);line-height:1.4}
.notif-item-time{font-size:10px;color:var(--text2);margin-top:4px;font-family:'DM Mono',monospace}
.notif-dot-indicator{width:7px;height:7px;border-radius:50%;background:var(--primary);flex-shrink:0}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:150;display:none}
.overlay.show{display:block}

/* MODAL */
.modal-wrap{position:fixed;inset:0;z-index:300;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.6)}
.modal-wrap.show{display:flex}
.modal{background:var(--surface);border-radius:16px;padding:28px;width:480px;max-width:calc(100vw - 32px);border:1px solid rgba(138,155,184,.2);max-height:80vh;overflow-y:auto}
.modal-title{font-family:'DM Serif Display',serif;font-size:22px;margin-bottom:20px}
.form-group{margin-bottom:16px}
.form-label{font-size:12px;font-weight:600;color:var(--text2);text-transform:uppercase;letter-spacing:.07em;margin-bottom:6px;display:block}
.form-input{width:100%;background:rgba(255,255,255,.06);border:1px solid rgba(138,155,184,.2);border-radius:8px;padding:10px 14px;color:var(--text);font-family:'Syne',sans-serif;font-size:14px;outline:none;transition:.2s}
.form-input:focus{border-color:var(--primary)}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-actions{display:flex;gap:10px;margin-top:20px;justify-content:flex-end}

/* TOOLTIP */
.tooltip{position:relative}
.tooltip::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;transform:translateX(-50%);background:rgba(26,34,56,.95);border:1px solid rgba(138,155,184,.2);color:var(--text);font-size:11px;padding:4px 10px;border-radius:6px;white-space:nowrap;pointer-events:none;opacity:0;transition:.2s;font-family:'Syne',sans-serif;z-index:999}
.tooltip:hover::after{opacity:1}

/* SCROLL */
::-webkit-scrollbar{width:4px;height:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(138,155,184,.2);border-radius:2px}
::-webkit-scrollbar-thumb:hover{background:rgba(138,155,184,.4)}

/* RESPONSIVE */
@media(max-width:1200px){.kpi-grid{grid-template-columns:repeat(2,1fr)}.ath-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.grid2,.grid3{grid-template-columns:1fr}.session-wrap{grid-template-columns:1fr}}

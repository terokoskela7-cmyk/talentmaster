 "ristiinLukko": "\n    <div style=\"grid-column:1/-1\">\n      <div class=\"pinfo-name serif\">Lukko Pelaaja</div>\n      <div class=\"pinfo-sub\">14v · — · KPV U13</div>\n      <!--JN-->\n    </div>\n    \n    \n    \n    \n    <div style=\"grid-column:1/-1;margin:0 0 10px\"><button onclick=\"_avaaPelaajaraportti('p5')\" style=\"background:var(--surface);border:.5px solid var(--teal);color:var(--teal);border-radius:7px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer\">📋 Pelaajaraportti + tavoitteet</button></div>\n    <div id=\"_mIdpCard\" class=\"mkt-scope\" style=\"grid-column:1/-1\"></div>\n    <div id=\"_mMitaCard\" class=\"mkt-scope\" style=\"grid-column:1/-1\"></div>\n    \n    \n    <div style=\"grid-column:1/-1;margin-top:10px;padding-top:10px;border-top:.5px solid rgba(242,239,230,.1)\"><div style=\"display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:6px;flex-wrap:wrap\"><span style=\"font-size:11px;letter-spacing:.04em;color:var(--ink2);text-transform:uppercase\">Peliäly <span style=\"font-size:9px;color:var(--ink3);border:.5px solid var(--border);border-radius:10px;padding:1px 7px;letter-spacing:.02em\">Porras 3 / 4</span></span><span style=\"font-size:10px;color:var(--ink3)\">1 havaintoa · ⚠ ≥3 luotettavuuteen · <span style=\"color:var(--teal);cursor:pointer\" onclick=\"openDrill('adar','p5')\">Peliälytyökalu →</span></span></div><div style=\"font-size:11px;color:var(--ink3)\">Peliälyarvio tarkentuu kun havaintoja on ≥3 (1/3). Yksittäiset havainnot ovat peliälytyökalussa.</div></div>\n    <div style=\"grid-column:1/-1;margin-top:8px;padding:9px 11px;background:rgba(42,93,176,.06);border:.5px solid rgba(42,93,176,.2);border-radius:8px\"><div style=\"font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:#2A5DB0;margin-bottom:5px\">Ristiinarvio · 1 arvioija</div><div style=\"font-size:11px;color:var(--amber)\">🔒 Arvioi ensin — näet muiden arviot oman tallennuksen jälkeen (1 arvioija tässä kuuss
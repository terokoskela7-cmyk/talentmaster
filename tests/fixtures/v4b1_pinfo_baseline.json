 Psykologinen <span onclick=\"event.stopPropagation();_mSelInfo('d3')\" title=\"D3 Psyykkinen — motivaatio, valmennettavuus, sinnikkyys, keskittyminen, tunteiden hallinta (1–5).\" style=\"cursor:help;color:var(--ink3);font-size:10px;opacity:.7\">ⓘ</span></span><button onclick=\"_avaaD3Arvio('p3')\" style=\"background:var(--teal);color:#fff;border:none;border-radius:6px;padding:4px 12px;font-size:11px;cursor:pointer\">Arvioi</button></div><div style=\"font-size:11px;color:var(--ink3)\">Psyykkinen profiili täydentyy kun arvioit pelaajan + pelaaja tekee itsearvion.</div></div>\n    <div style=\"grid-column:1/-1;margin-top:8px;font-size:11px;color:var(--ink3)\">1 testikertaa</div>",
 "eiMitattu": "\n    <div style=\"grid-column:1/-1\">\n      <div class=\"pinfo-name serif\">Ei Mitattu</div>\n      <div class=\"pinfo-sub\">13v · — · KPV U13</div>\n      <!--JN-->\n    </div>\n    <div style=\"grid-column:1/-1;display:flex;flex-wrap:wrap;gap:6px;margin:-8px 0 6px\"><span title=\"kuorma varovainen ikäikkunassa\" style=\"font-size:10px;padding:2px 9px;border-radius:20px;border:.5px dashed var(--ink3);color:var(--ink3)\">PHV ei mitattu</span></div>\n    \n    \n    \n    <div style=\"grid-column:1/-1;margin:0 0 10px\"><button onclick=\"_avaaPelaajaraportti('p4')\" style=\"background:var(--surface);border:.5px solid var(--teal);color:var(--teal);border-radius:7px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer\">📋 Pelaajaraportti + tavoitteet</button></div>\n    <div id=\"_mIdpCard\" class=\"mkt-scope\" style=\"grid-column:1/-1\"></div>\n    <div id=\"_mMitaCard\" class=\"mkt-scope\" style=\"grid-column:1/-1\"></div>\n    \n      <div class=\"pstat-klik\" onclick=\"_avaaDetail('tki')\">\n        <div class=\"pstat-lbl\">TKI <span onclick=\"event.stopPropagation();_mSelInfo('tki')\" title=\"Tekniikkakilpailuindeksi 0–100 ikäluokan merkkirajoja vasten\" style=\"cursor:help;color:var(--ink3);font-size:10px;opacity:.7\">ⓘ</span> <span style=\"color:var(--teal)\">→</span></div>\n        <div class=\"pstat-val serif\" style=\"color:var(--amber)\">40</div>\n        <div class=\"pstat-delta mono\" style=\"font-size:11px;color:var(--ink3)\">Tekniikkakilpailu</div>\n      </div>\n    <div style=\"grid-column:1/-1;margin-top:10px;padding-top:10px;border-top:.5px solid rgba(242,239,230,.1)\"><div style=\"display:flex;gap:10px;margin-bottom:2px\"><div style=\"flex:1;background:var(--bg2);border:.5px solid rgba(242,239,230,.08);border-radius:8px;padding:11px 13px\"><div style=\"font-size:10px;letter-spacing:.06em;color:var(--ink3);text-transform:uppercase\">D1 Fyysinen <span title=\"D1 Fyysinen — testitasojen keskiarvo, 1–5 (3 = ikäluokan keskitaso)